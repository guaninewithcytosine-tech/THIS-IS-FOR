var TWT_FOLDER_NAME = 'TWT 代購';
var LEGACY_CAMPAIGN_FOLDER_NAME = 'TWT_開團表單';
// 之前的版本留下的賣貨便、KOCA 資料：檔名、之前另外建的檔案、TWT 代購管理表裡的分頁 → 新檔案裡的分頁名稱
var OLD_CHANNELS = [
  { name: '賣貨便', file: '賣貨便訂單', ssKey: '__SHEET_myship__', tabs: { '賣貨便訂單': '訂單' } },
  { name: 'KOCA', file: 'KOCA 訂單', ssKey: '__SHEET_koca__', tabs: { 'KOCA 訂單': '訂單', 'KOCA 提領': '提領' } }
];

// TWT 代購管理表、各團的 Google Sheet、圖片資料夾放進「TWT 代購」資料夾；回傳搬了幾個
function organizeTwtFolder() {
  var folder = getCampaignFolder(), moved = 0;
  var props = PropertiesService.getScriptProperties().getProperties();
  var ids = [getMainSpreadsheetOrThrow().getId()];
  Object.keys(props).forEach(function(k) { if (!isInternalPropKey(k)) ids.push(props[k]); });
  ids.forEach(function(id) {
    try { if (moveIntoFolder(DriveApp.getFileById(id), folder)) moved++; } catch (ignore) {}
  });
  if (props['__IMAGE_FOLDER__']) {
    try { if (moveIntoFolder(DriveApp.getFolderById(props['__IMAGE_FOLDER__']), folder)) moved++; } catch (ignore) {}
  }
  return moved;
}
function moveIntoFolder(item, folder) {
  var parents = item.getParents();
  while (parents.hasNext()) if (parents.next().getId() === folder.getId()) return false;
  item.moveTo(folder);
  return true;
}

// 之前的版本留下的賣貨便、KOCA 訂單：TWT 代購管理表裡的分頁整個複製到它們自己的檔案（格式不變），
// 確認筆數一樣後才從 TWT 代購管理表移除。回傳 [{ name, file, url }]（沒有要交接的就是空的）
function handOffOldChannels() {
  var sp = PropertiesService.getScriptProperties(), main = getMainSpreadsheetOrThrow(), out = [];
  OLD_CHANNELS.forEach(function(c) {
    var ss = null, id = sp.getProperty(c.ssKey);
    if (id) { try { ss = SpreadsheetApp.openById(id); } catch (ignore) {} }
    var keep = Object.keys(c.tabs).map(function(k) { return c.tabs[k]; });
    Object.keys(c.tabs).forEach(function(oldName) {
      var sheet = main.getSheetByName(oldName), tab = c.tabs[oldName];
      if (!sheet || !isOldChannelTab(sheet)) return; // 不是程式建立的分頁：不動
      if (!ss) ss = SpreadsheetApp.create(c.file);
      var target = ss.getSheetByName(tab);
      if (target && target.getLastRow() > 1) return; // 新檔案裡已經有資料：不覆蓋，TWT 代購管理表的分頁留著
      var copy = sheet.copyTo(ss);
      if (target) ss.deleteSheet(target);
      copy.setName(tab);
      if (copy.getLastRow() !== sheet.getLastRow()) throw new Error('搬移「' + oldName + '」時筆數不一致，沒有刪除 TWT 代購管理表的分頁');
      main.deleteSheet(sheet);
    });
    if (!ss) return;
    // 新建的檔案會有一個空白的預設分頁：拿掉
    ss.getSheets().forEach(function(s) {
      if (keep.indexOf(s.getName()) < 0 && s.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(s);
    });
    out.push({ name: c.name, file: ss.getName(), url: ss.getUrl() });
  });
  return out;
}
function isOldChannelTab(sheet) {
  if (sheet.getLastColumn() < 1) return false;
  var head = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(function(h) { return String(h).trim(); });
  return (head.indexOf('訂單編號') >= 0 && head.indexOf('更新時間（系統用）') >= 0) || (head.indexOf('入帳時間') >= 0 && head.indexOf('入帳金額') >= 0);
}
// 之前的版本留下的 Notion、讀信設定：清掉（Notion 改由「訂單總覽」負責）；回傳清掉幾個
function cleanupOldSettings() {
  var sp = PropertiesService.getScriptProperties(), n = 0;
  Object.keys(sp.getProperties()).forEach(function(k) {
    if (/^__(NOTION|EMAIL|SHEET_|SYNC_)/.test(k)) { sp.deleteProperty(k); n++; }
  });
  removeOldTriggers();
  return n;
}
// 之前設定的每 10 分鐘自動同步：拿掉
function removeOldTriggers() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === 'syncNotion') ScriptApp.deleteTrigger(t);
  });
}
// 舊的自動同步如果還在，跑到這裡時把自己拿掉、不做別的事
function syncNotion() { removeOldTriggers(); }

// 舊訂單沒有訂單編號時補上一個（「訂單總覽」同步 Notion 時用訂單編號對應）；回傳補了幾筆
// orders：getAllOrders({ includeEnded: true }) 讀好的訂單（補上的編號也會寫進去）
function fillMissingOrderIds(orders) {
  var n = 0;
  orders.forEach(function(o) {
    if (o.orderId || !o.spreadsheetId || !o.rowIndex) return;
    var sheet = SpreadsheetApp.openById(o.spreadsheetId).getSheetByName(ORDER_SHEET);
    var h = getHeaderMap(sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0]);
    if (h['訂單編號'] === undefined || String(sheet.getRange(o.rowIndex, h['訂單編號'] + 1).getValue() || '')) return;
    o.orderId = makeOrderId(new Date());
    sheet.getRange(o.rowIndex, h['訂單編號'] + 1).setValue(o.orderId);
    n++;
  });
  return n;
}

// 付款狀態的顯示文字（團務索引表單的統計用）
function payLabel(v) {
  var s = String(v || '').trim();
  if (s === 'paid' || s === '已付款') return '已付款';
  if (!s || s === 'pending' || s === '未付款' || s === '未收款') return '未付款';
  return s;
}
// 金額不符、退款各自分開，不算進已付款或未付款
function campaignStats(orders) {
  var s = { count: 0, total: 0, paid: 0, unpaid: 0, mismatch: 0, refund: 0, second: 0, secondPaid: 0 };
  orders.forEach(function(o) {
    var pay = payLabel(o.payStatus);
    s.count++;
    s.total += Number(o.totalAmount) || 0;
    if (pay === '已付款') s.paid++;
    else if (pay === '金額不符') s.mismatch++;
    else if (pay === '退款') s.refund++;
    else s.unpaid++;
    if ((Number(o.secondPayment) || 0) > 0) {
      if (normalizeSecondStatus(o.secondPayStatus) === '已收款') s.secondPaid++; else s.second++;
    }
  });
  return s;
}

// ── doGet ──
var PUBLIC_GET_ACTIONS = { '': true, 'queryOrders': true };
var WRITE_GET_ACTIONS = { 'createCampaignSheets': true, 'rebuildItemSummaries': true, 'backfillOrderCardFields': true, 'normalizeOrderSheets': true, 'upgradeFormulas': true };

function doGet(e) {
  _catalogMemo = null; // 每個請求都重新讀表，手動改過的資料馬上生效
  try {
    var params = (e && e.parameter) || {};
    var action = params.action || '';
    if (!PUBLIC_GET_ACTIONS[action] && !isValidToken(params.token)) return unauthorizedResponse();
    if (WRITE_GET_ACTIONS[action]) return withScriptLock(function() { return handleGet(action, params); });
    return handleGet(action, params);
  } catch (err) {
    return errorResponse(err);
  }
}

function handleGet(action, params) {
  var e = { parameter: params };
  try {
    if (action === 'getAllOrders') {
      var allOrders = getAllOrders({ includeEnded: true });
      try { refreshCampaignIndex(null, allOrders); } catch (ignore) {} // 順便更新團務索引表單的數字
      var activeIds = {};
      var activeProps = PropertiesService.getScriptProperties().getProperties();
      Object.keys(activeTourNames()).forEach(function(n) { if (activeProps[n]) activeIds[activeProps[n]] = true; });
      var orders = allOrders.filter(function(o) { return activeIds[o.spreadsheetId]; });
      return jsonResponse({ ok: true, orders: orders, secondPayments: buildSecondPaymentsFromOrders(orders) });
    }
 
    // 買家查詢專用：只回傳「符合手機末碼或匯款後五碼」的訂單，且僅含買家需要的欄位。
    // 避免像 getAllOrders 那樣把所有買家的訂單（含手機、明細）全部送到查詢者的瀏覽器。
    if (action === 'queryOrders') {
      var q = String(e.parameter.q || '').replace(/\D/g, '');
      var matched = [];
      if (q) {
        getAllOrders().forEach(function(o) {
          var ph = String(o.phone || '').replace(/\D/g, '');
          var b5 = String(o.bank5 || '').replace(/\D/g, '').slice(-5);
          var hit = (q.length >= 6 && ph.slice(-q.length) === q) || (q.length === 5 && b5 === q);
          if (hit) {
            // 不回傳完整手機與匯款後五碼，買家頁面也用不到。
            matched.push({
              orderId: o.orderId,
              campaignName: o.campaignName,
              socialName: o.socialName,
              orderDetails: o.orderDetails,
              totalAmount: o.totalAmount,
              originalAmount: o.originalAmount,
              cardCount: o.cardCount,
              payStatus: o.payStatus,
              secondPayment: o.secondPayment,
              secondPayStatus: o.secondPayStatus
            });
          }
        });
      }
      return jsonResponse({ ok: true, orders: matched });
    }
 
    // 手動強制建立所有開團表單。可在瀏覽器開：API_URL?action=createCampaignSheets
    if (action === 'createCampaignSheets') {
      var catalogForCreate = readCatalogFromSettings();
      var reportForCreate = ensureCampaignSheetsFromCatalog(catalogForCreate);
      refreshCampaignIndex(reportForCreate);
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', autoCreate: reportForCreate });
    }
 
    // 重新整理所有開團的品項統計。可在瀏覽器開：API_URL?action=rebuildItemSummaries
    if (action === 'rebuildItemSummaries') {
      var rebuildReport = rebuildAllItemSummaries();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', report: rebuildReport });
    }
 
    // 補齊舊訂單的原幣總金額與滿額卡張數。可在瀏覽器開：API_URL?action=backfillOrderCardFields
    if (action === 'backfillOrderCardFields') {
      var cardReport = backfillOrderCardFields();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', report: cardReport });
    }
 
    // 重新整理所有既有開團表的訂單欄位順序。可在瀏覽器開：API_URL?action=normalizeOrderSheets
    if (action === 'normalizeOrderSheets') {
      var normalizeReport = normalizeAllOrderSheets();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', report: normalizeReport });
    }
 
    // 除錯用。可在瀏覽器開：API_URL?action=debugCatalog
    if (action === 'debugCatalog') {
      return jsonResponse(debugCatalogAutoCreate());
    }
 
 
    // ── 全面診斷：API_URL?action=diagnose ──
    // 一鍵回傳所有可能出錯的資訊，方便直接在瀏覽器確認問題點。
    if (action === 'diagnose') {
      var diag = { ok: true, steps: [] };
      // Step 1: 確認 GAS 是 bound script（不是 standalone）
      try {
        var mainDiagSS = SpreadsheetApp.getActiveSpreadsheet();
        diag.steps.push({ step: '1_bound_script', ok: true, value: mainDiagSS.getName() + ' (' + mainDiagSS.getId() + ')' });
      } catch (e) {
        diag.steps.push({ step: '1_bound_script', ok: false, error: '⛔ 這是 standalone GAS！請從 Google Sheet 的「擴充功能 → Apps Script」進入，不能用獨立 Apps Script。錯誤：' + e.message });
        diag.ok = false;
        return jsonResponse(diag);
      }
      // Step 2: 讀取開團資料
      try {
        var diagTours = getCatalogTours(readCatalogFromSettings());
        diag.steps.push({ step: '2_catalog', ok: true, tourCount: diagTours.length, tours: diagTours.map(function(t) { return { name: t.name, status: t.status, type: t.type, shouldCreate: shouldCreateSheetForTour(t) }; }) });
        if (diagTours.length === 0) {
          diag.steps.push({ step: '2_tours_empty', ok: false, error: '⛔ 「' + TOUR_SHEET + '」沒有任何開團。請先在後台建立開團並按「☁️ 儲存」。' });
          diag.ok = false;
        }
      } catch (e) {
        diag.steps.push({ step: '2_catalog', ok: false, error: e.message });
        diag.ok = false;
      }
      // Step 3: 確認 DriveApp 有權限（嘗試建立測試資料夾）
      try {
        var testFolder = DriveApp.getRootFolder();
        diag.steps.push({ step: '3_drive_permission', ok: true, value: 'Drive 根目錄可存取：' + testFolder.getName() });
      } catch (e) {
        diag.steps.push({ step: '3_drive_permission', ok: false, error: '⛔ 沒有 Drive 權限：' + e.message + '。請重新部署並在授權對話框勾選所有權限。' });
        diag.ok = false;
      }
      // Step 4: 確認 ScriptProperties 可讀寫
      try {
        var diagProps = PropertiesService.getScriptProperties();
        diagProps.setProperty('__diag_test__', 'ok');
        var testRead = diagProps.getProperty('__diag_test__');
        diagProps.deleteProperty('__diag_test__');
        diag.steps.push({ step: '4_script_props', ok: testRead === 'ok', value: testRead });
      } catch (e) {
        diag.steps.push({ step: '4_script_props', ok: false, error: '⛔ ScriptProperties 無法讀寫：' + e.message });
        diag.ok = false;
      }
      // Step 5: 列出目前已記錄的開團表單 ID
      try {
        var allP = PropertiesService.getScriptProperties().getProperties();
        var campEntries = [];
        Object.keys(allP).forEach(function(k) { if (!isInternalPropKey(k)) campEntries.push({ name: k, id: allP[k] }); });
        diag.steps.push({ step: '5_stored_campaign_ids', ok: true, count: campEntries.length, campaigns: campEntries });
      } catch (e) {
        diag.steps.push({ step: '5_stored_campaign_ids', ok: false, error: e.message });
      }
      return jsonResponse(diag);
    }
 

    // clearTestData / deleteCampaignCompletely 只能用 POST（需登入 token），不再接受 GET 網址觸發。

    // 列出所有開團 Google Sheet：Script Properties 裡所有「團名 → Spreadsheet ID」對應。
    // 可在後台「設定 → Google Sheet 表單清理」使用。
    if (action === 'listCampaignSpreadsheets') {
      return jsonResponse(listCampaignSpreadsheets({ includeActive: true }));
    }

    // 舊版相容：只列殘留表單，或加 includeActive=1 時列全部。
    if (action === 'listResidualCampaignSpreadsheets') {
      var includeActiveResidualList = String(e.parameter.includeActive || '') === '1' || String(e.parameter.includeActive || '').toLowerCase() === 'true';
      return jsonResponse(listCampaignSpreadsheets({ includeActive: includeActiveResidualList }));
    }

    // 手動補齊所有開團表的二補公式，不影響 saveCatalog 速度。
    if (action === 'upgradeFormulas') {
      upgradeArrayFormulas();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', message: '所有開團表公式已補齊' });
    }
 
    return jsonResponse(readCatalogFromSettings());
  } catch (err) {
    return errorResponse(err);
  }
}

