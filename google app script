function getCatalogTours(catalog) {
  if (!catalog || !catalog.appData) return [];
  if (Array.isArray(catalog.appData.tours)) return catalog.appData.tours;
  return [];
}
 
function shouldCreateSheetForTour(tour) {
  if (!tour) return false;
  var status = String(tour.status || '').toLowerCase();
  var type = String(tour.type || '').toLowerCase();
  if (status === 'instock' || type === 'instock' || type === 'market' || type === 'store') return false;
  return true;
}
 
function getCatalogTourName(tour) {
  return String((tour && (tour.name || tour.title || tour.campaignName)) || '').trim();
}
 
function ensureCampaignSpreadsheet(campaignName) {
  var props = PropertiesService.getScriptProperties();
  var key = propKeyCampaign(campaignName);
  var ssId = props.getProperty(key);
  var ss;
 
  if (ssId) {
    try {
      ss = SpreadsheetApp.openById(ssId);
      ss.__twtCreatedNow = false;
      tryMoveCampaignSpreadsheetToFolder(ss.getId());
      return ss;
    } catch (ignore) {
      // 如果 property 裡的 ID 失效，下面會重新建立。
    }
  }
 
  ss = SpreadsheetApp.create(campaignName);
  ss.__twtCreatedNow = true;
  props.setProperty(key, ss.getId());
  tryMoveCampaignSpreadsheetToFolder(ss.getId());
  return ss;
}
 
function getCampaignFolder() {
  var props = PropertiesService.getScriptProperties();
  var saved = props.getProperty(CAMPAIGN_FOLDER_KEY);
  if (saved) {
    try { return DriveApp.getFolderById(saved); } catch (ignore) {}
  }
  var folder = DriveApp.createFolder('TWT_開團表單');
  props.setProperty(CAMPAIGN_FOLDER_KEY, folder.getId());
  return folder;
}
 
function tryMoveCampaignSpreadsheetToFolder(fileId) {
  try {
    var folder = getCampaignFolder();
    var file = DriveApp.getFileById(fileId);
    file.moveTo(folder);
  } catch (ignore) {
    // 不讓移動資料夾失敗阻斷建表。沒有 Drive 權限時至少仍會在 Drive 根目錄建立檔案。
  }
}
 
function setupCampaignSpreadsheet(ss, tour, campaignName) {
  var orderSheet = ss.getSheetByName(ORDER_SHEET);
  if (!orderSheet) orderSheet = ss.insertSheet(ORDER_SHEET, 0);
  var orderHeaders = normalizeOrderSheetColumns(orderSheet);
  applyOrderTextFormats(orderSheet, getHeaderMap(orderHeaders));
 
  var itemSheet = ss.getSheetByName(ITEM_SHEET);
  if (!itemSheet) itemSheet = ss.insertSheet(ITEM_SHEET);
  ensureItemSummaryHeader(itemSheet);
  seedOrRefreshItemSummary(itemSheet, tour);
  var existingOrderSheet = ss.getSheetByName(ORDER_SHEET);
  if (existingOrderSheet && existingOrderSheet.getLastRow() > 1) {
    updateItemSummary(ss, {}, campaignName);
  }
 
  var secondSheet = ss.getSheetByName(SECOND_SHEET);
  if (!secondSheet) secondSheet = ss.insertSheet(SECOND_SHEET);
  var secondHeaders = ensureSecondHeaders(secondSheet);
  applySecondTextFormats(secondSheet, getHeaderMap(secondHeaders));
  ensureSecPayFormula(secondSheet, getHeaderMap(secondHeaders));
 
  // SpreadsheetApp.create 預設會有一張空白「工作表 1」。如果仍然是空白，就清掉。
  removeDefaultBlankSheet(ss);
}
 
function seedOrRefreshItemSummary(sheet, tour) {
  var catalogNames = getCatalogItemRows(tour || {});
  if (!catalogNames.length) return;
 
  var existing = {};
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0]) existing[String(data[i][0])] = Number(data[i][1] || 0);
  }
 
  var out = [];
  var used = {};
  catalogNames.forEach(function(name) {
    out.push([name, existing[name] != null ? existing[name] : 0]);
    used[name] = true;
  });
  Object.keys(existing).forEach(function(name) {
    if (!used[name]) out.push([name, existing[name]]);
  });
 
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, 2).clearContent();
  if (out.length) sheet.getRange(2, 1, out.length, 2).setValues(out);
}
 
