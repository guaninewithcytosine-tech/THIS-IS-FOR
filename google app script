// 後台密碼只從「系統設定」B1 讀取，不再有寫死的預設密碼。
var SETTING_SHEET = '系統設定';
var AUTH_TOKEN_TTL = 21600; // 登入 token 有效秒數（CacheService 上限 6 小時）
var LOGIN_FAIL_LIMIT = 20;  // 15 分鐘內密碼錯誤超過此次數，暫停登入
var LOGIN_FAIL_WINDOW = 900;
var ORDER_SHEET = '訂單明細';
var ITEM_SHEET = '品項統計';
var SECOND_SHEET = '匯率與二補';
var SECOND_TOTAL_HEADER = '二補總計(國際運費+包材)';
var CAMPAIGN_INDEX_SHEET = '開團表單索引';
var CAMPAIGN_FOLDER_KEY = '__CAMPAIGN_FOLDER__';
 
var ORDER_HEADERS = [
  '時間戳記','開團名稱','社群帳號','個人主頁連結','電子郵件','手機號碼','訂單明細',
  '系統總計金額','買家匯款金額','匯款後五碼','原幣總金額','滿額卡張數','滿額卡排序',
  '付款狀態','訂單編號','備註'
];
 
var SECOND_HEADERS = [
  '社群帳號','手機號碼','購買明細','一補已付金額','商品重量(kg)',
  '國際運費分攤','包材費',SECOND_TOTAL_HEADER,'二補收款狀態','訂單編號'
];
 
// ── 工具函式 ──
function getHeaderMap(headers) {
  var map = {};
  headers.forEach(function(h, i) { if (h !== '' && h !== null && h !== undefined) map[String(h).trim()] = i; });
  return map;
}
 
function getVal(row, hMap, col, fallback) {
  var idx = hMap[col];
  return idx !== undefined && row[idx] !== undefined && row[idx] !== null ? row[idx] : (fallback != null ? fallback : '');
}
 
function getRealLastRow(sheet) {
  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return 1;
  var lastCol = Math.max(1, sheet.getLastColumn());
  var vals = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  for (var i = vals.length - 1; i >= 0; i--) {
    if (vals[i].some(function(c) { return c !== '' && c !== null; })) return i + 1;
  }
  return 1;
}
 
function colToLetter(idx) {
  var letter = '';
  while (idx >= 0) {
    letter = String.fromCharCode(65 + (idx % 26)) + letter;
    idx = Math.floor(idx / 26) - 1;
  }
  return letter;
}
 
function jsonResponse(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// 只回傳錯誤訊息，不把 stack trace（內部程式細節）送給呼叫端。
function errorResponse(err) {
  return jsonResponse({ ok: false, error: err && err.message ? err.message : String(err) });
}

// ── 後台登入驗證 ──
// 買家公開可用：讀 catalog、queryOrders、createNewOrder、login。其他動作都必須帶有效 token。
function getAdminPassword() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var settingSheet = ss && ss.getSheetByName(SETTING_SHEET);
  return settingSheet ? String(settingSheet.getRange('B1').getValue() || '') : '';
}

function login(password) {
  var cache = CacheService.getScriptCache();
  var fails = Number(cache.get('login_fail') || 0);
  if (fails >= LOGIN_FAIL_LIMIT) return { ok: false, error: '嘗試次數過多，請 15 分鐘後再試' };
  var adminPwd = getAdminPassword();
  if (!adminPwd) return { ok: false, error: '尚未設定後台密碼，請在主控表「' + SETTING_SHEET + '」B1 填入密碼' };
  if (String(password || '') !== adminPwd) {
    cache.put('login_fail', String(fails + 1), LOGIN_FAIL_WINDOW);
    Utilities.sleep(800);
    return { ok: false, error: '密碼錯誤' };
  }
  var token = Utilities.getUuid() + Utilities.getUuid().replace(/-/g, '');
  cache.put('tok_' + token, '1', AUTH_TOKEN_TTL);
  return { ok: true, token: token, expiresIn: AUTH_TOKEN_TTL };
}

function isValidToken(token) {
  token = String(token || '');
  if (token.length < 30) return false;
  var cache = CacheService.getScriptCache();
  if (cache.get('tok_' + token) !== '1') return false;
  cache.put('tok_' + token, '1', AUTH_TOKEN_TTL); // 有在使用就延長有效期
  return true;
}

function logout(token) {
  token = String(token || '');
  if (token) CacheService.getScriptCache().remove('tok_' + token);
}

function unauthorizedResponse() {
  return jsonResponse({ ok: false, error: 'unauthorized', unauthorized: true });
}

// 會寫入資料的動作一律排隊執行，避免同時寫入同一列。
function withScriptLock(fn) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) {
    return jsonResponse({ ok: false, error: '系統忙碌中，請稍後再試' });
  }
  try {
    return fn();
  } finally {
    try { lock.releaseLock(); } catch (ignore) {}
  }
}
 
function ensureColumns(sheet, headers, colNames) {
  colNames.forEach(function(name) {
    if (headers.indexOf(name) < 0) {
      sheet.getRange(1, headers.length + 1).setValue(name).setFontWeight('bold').setBackground('#e5e7eb');
      headers.push(name);
    }
  });
  return headers;
}
 
function ensureHeaderRow(sheet, headers) {
  if (sheet.getLastRow() < 1 || sheet.getLastColumn() < 1 || !sheet.getRange(1, 1).getValue()) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold').setBackground('#e5e7eb');
    return headers.slice();
  }
  var current = sheet.getRange(1, 1, 1, Math.max(1, sheet.getLastColumn())).getValues()[0];
  return ensureColumns(sheet, current, headers);
}
 
function normalizeOrderSheetColumns(sheet) {
  if (!sheet) return ORDER_HEADERS.slice();
 
  var realLastRow = getRealLastRow(sheet);
  var lastCol = Math.max(1, sheet.getLastColumn(), ORDER_HEADERS.length);
 
  if (realLastRow <= 1 && !sheet.getRange(1, 1).getValue()) {
    sheet.getRange(1, 1, 1, ORDER_HEADERS.length).setValues([ORDER_HEADERS]).setFontWeight('bold').setBackground('#e5e7eb');
    applyOrderTextFormats(sheet, getHeaderMap(ORDER_HEADERS));
    return ORDER_HEADERS.slice();
  }
 
  var values = sheet.getRange(1, 1, realLastRow, lastCol).getValues();
  var oldHeaders = values[0].map(function(h) { return String(h || '').trim(); });
  var oldMap = getHeaderMap(oldHeaders);
  // 賣家自己加在表上的欄位要保留，排在標準欄位後面，不可在重排時被清掉。
  var extraHeaders = oldHeaders.filter(function(h) {
    return h && ORDER_HEADERS.indexOf(h) < 0 && h !== '滿額卡分配方式';
  });
  var newHeaders = ORDER_HEADERS.concat(extraHeaders);
  var mustReorder = oldMap['滿額卡分配方式'] !== undefined;
  for (var hi = 0; hi < newHeaders.length && !mustReorder; hi++) {
    if (oldHeaders[hi] !== newHeaders[hi]) mustReorder = true;
  }

  if (!mustReorder) return newHeaders;

  var out = [newHeaders.slice()];
  for (var r = 1; r < values.length; r++) {
    var oldRow = values[r];
    if (!oldRow.some(function(c) { return c !== '' && c !== null; })) continue;
    var newRow = new Array(newHeaders.length).fill('');

    newHeaders.forEach(function(header, idx) {
      if (header === '滿額卡排序') {
        var oldSort = getVal(oldRow, oldMap, '滿額卡排序');
        var oldMode = getVal(oldRow, oldMap, '滿額卡分配方式');
        newRow[idx] = normalizeCardSortForSheet(oldSort, oldMode, oldSort || oldMode);
      } else if (header === '滿額卡張數') {
        var oldCount = getVal(oldRow, oldMap, '滿額卡張數');
        if (oldCount === '' || oldCount === null) oldCount = parseCardCount(getVal(oldRow, oldMap, '滿額卡排序'));
        newRow[idx] = oldCount;
      } else {
        newRow[idx] = getVal(oldRow, oldMap, header);
      }
    });
    out.push(newRow);
  }
 
  sheet.clearContents();
  sheet.getRange(1, 1, out.length, newHeaders.length).setValues(out);
  sheet.getRange(1, 1, 1, newHeaders.length).setFontWeight('bold').setBackground('#e5e7eb');
  applyOrderTextFormats(sheet, getHeaderMap(newHeaders));
  return newHeaders;
}
 
function makeOrderId(ts) {
  var base = (ts instanceof Date ? ts.getTime() : Date.now());
  return 'O' + base.toString(36) + Math.random().toString(36).slice(2, 7);
}
 
function propKeyCampaign(name) {
  return String(name || '').trim();
}
 
function isInternalPropKey(k) {
  return String(k).indexOf('__') === 0;
}
 
function normalizeSecondStatus(s) {
  s = String(s || '').trim();
  if (!s || s === '未通知' || s === 'pending' || s === '未付款' || s === '未收款') return '未收款';
  if (s === 'paid' || s === '已付款' || s === '已收款') return '已收款';
  return s;
}
 
function parseCardCount(priorityData) {
  var s = String(priorityData || '');
  var m = s.match(/滿額(?:卡|禮)\s*[x×＊*]\s*(\d+)/i) || s.match(/(\d+)\s*張/);
  return m ? Number(m[1]) : 0;
}
 
function isRandomCardSortText(value) {
  return /隨機|random|不排序/i.test(String(value || ''));
}
 
function extractCardSortOnly(priorityData) {
  var s = String(priorityData || '').trim();
  if (!s) return '';
  if (isRandomCardSortText(s)) return '隨機';
  var m = s.match(/順位\s*[:：]\s*(.+)$/i);
  if (m) return m[1].trim().replace(/\s*>\s*/g, ' > ');
  s = s.replace(/滿額(?:卡|禮)\s*[x×＊*]\s*\d+/ig, '');
  s = s.replace(/^\s*[|｜]\s*/, '').trim();
  s = s.replace(/^順位\s*[:：]\s*/i, '').trim();
  return s.replace(/\s*>\s*/g, ' > ');
}
 
function extractCardSortMode(priorityData) {
  var s = String(priorityData || '').trim();
  if (!s) return '';
  if (isRandomCardSortText(s)) return '隨機分配';
  if (/順位|>/.test(s)) return '自選排序';
  return '';
}
 
function normalizeCardSortForSheet(cardSort, cardSortMode, priorityData) {
  if (isRandomCardSortText(cardSort) || isRandomCardSortText(cardSortMode) || isRandomCardSortText(priorityData)) return '隨機';
  return extractCardSortOnly(cardSort) || extractCardSortOnly(priorityData) || '';
}
 
function buildPriorityDataText(cardSort, cardSortMode, cardCount) {
  cardCount = Number(cardCount || 0) || 0;
  var parts = [];
  if (cardCount > 0) parts.push('滿額卡 x' + cardCount);
  var sort = normalizeCardSortForSheet(cardSort, cardSortMode, cardSort);
  if (sort === '隨機') parts.push('隨機');
  else if (sort) parts.push('順位：' + sort);
  return parts.join(' | ');
}
 
// ── doGet ──
var PUBLIC_GET_ACTIONS = { '': true, 'queryOrders': true };
var WRITE_GET_ACTIONS = { 'createCampaignSheets': true, 'rebuildItemSummaries': true, 'backfillOrderCardFields': true, 'normalizeOrderSheets': true, 'upgradeFormulas': true };

function doGet(e) {
  try {
    var params = (e && e.parameter) || {};
    var action = params.action || '';
    if (!PUBLIC_GET_ACTIONS[action] && !isValidToken(params.token)) return unauthorizedResponse();
    if (WRITE_GET_ACTIONS[action]) return withScriptLock(function() { return handleGet(action, params); });
    return handleGet(action, params);
  } catch (err) {
    return errorResponse(err);
  }
}

function handleGet(action, params) {
  var e = { parameter: params };
  try {
    if (action === 'getAllOrders') {
      var orders = getAllOrders();
      return jsonResponse({ ok: true, orders: orders, secondPayments: buildSecondPaymentsFromOrders(orders) });
    }
 
    // 買家查詢專用：只回傳「符合手機末碼或匯款後五碼」的訂單，且僅含買家需要的欄位。
    // 避免像 getAllOrders 那樣把所有買家的訂單（含手機、明細）全部送到查詢者的瀏覽器。
    if (action === 'queryOrders') {
      var q = String(e.parameter.q || '').replace(/\D/g, '');
      var matched = [];
      if (q) {
        getAllOrders().forEach(function(o) {
          var ph = String(o.phone || '').replace(/\D/g, '');
          var b5 = String(o.bank5 || '').replace(/\D/g, '').slice(-5);
          var hit = (q.length >= 6 && ph.slice(-q.length) === q) || (q.length === 5 && b5 === q);
          if (hit) {
            // 不回傳完整手機與匯款後五碼，買家頁面也用不到。
            matched.push({
              orderId: o.orderId,
              campaignName: o.campaignName,
              socialName: o.socialName,
              orderDetails: o.orderDetails,
              totalAmount: o.totalAmount,
              payStatus: o.payStatus,
              secondPayment: o.secondPayment,
              secondPayStatus: o.secondPayStatus
            });
          }
        });
      }
      return jsonResponse({ ok: true, orders: matched });
    }
 
    // 手動強制建立所有開團表單。可在瀏覽器開：API_URL?action=createCampaignSheets
    if (action === 'createCampaignSheets') {
      var catalogForCreate = readCatalogFromSettings();
      var reportForCreate = ensureCampaignSheetsFromCatalog(catalogForCreate);
      writeCampaignIndex(reportForCreate);
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', autoCreate: reportForCreate });
    }
 
    // 重新整理所有開團的品項統計。可在瀏覽器開：API_URL?action=rebuildItemSummaries
    if (action === 'rebuildItemSummaries') {
      var rebuildReport = rebuildAllItemSummaries();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', report: rebuildReport });
    }
 
    // 補齊舊訂單的原幣總金額與滿額卡張數。可在瀏覽器開：API_URL?action=backfillOrderCardFields
    if (action === 'backfillOrderCardFields') {
      var cardReport = backfillOrderCardFields();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', report: cardReport });
    }
 
    // 重新整理所有既有開團表的訂單欄位順序。可在瀏覽器開：API_URL?action=normalizeOrderSheets
    if (action === 'normalizeOrderSheets') {
      var normalizeReport = normalizeAllOrderSheets();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', report: normalizeReport });
    }
 
    // 除錯用。可在瀏覽器開：API_URL?action=debugCatalog
    if (action === 'debugCatalog') {
      return jsonResponse(debugCatalogAutoCreate());
    }
 
 
    // ── 全面診斷：API_URL?action=diagnose ──
    // 一鍵回傳所有可能出錯的資訊，方便直接在瀏覽器確認問題點。
    if (action === 'diagnose') {
      var diag = { ok: true, steps: [] };
      // Step 1: 確認 GAS 是 bound script（不是 standalone）
      try {
        var mainDiagSS = SpreadsheetApp.getActiveSpreadsheet();
        diag.steps.push({ step: '1_bound_script', ok: true, value: mainDiagSS.getName() + ' (' + mainDiagSS.getId() + ')' });
      } catch (e) {
        diag.steps.push({ step: '1_bound_script', ok: false, error: '⛔ 這是 standalone GAS！請從 Google Sheet 的「擴充功能 → Apps Script」進入，不能用獨立 Apps Script。錯誤：' + e.message });
        diag.ok = false;
        return jsonResponse(diag);
      }
      // Step 2: 讀取 A1 設定，確認 tours 資料存在
      try {
        var diagSetting = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SETTING_SHEET);
        if (!diagSetting) {
          diag.steps.push({ step: '2_setting_sheet', ok: false, error: '⛔ 找不到「' + SETTING_SHEET + '」工作表。請先在後台按「☁️ 儲存」。' });
          diag.ok = false;
        } else {
          var diagRaw = diagSetting.getRange('A1').getValue();
          if (!diagRaw) {
            diag.steps.push({ step: '2_setting_sheet', ok: false, error: '⛔ 系統設定 A1 是空白。請先在後台按「☁️ 儲存」，再開此網址。' });
            diag.ok = false;
          } else {
            var diagCatalog = JSON.parse(diagRaw);
            var diagTours = (diagCatalog && diagCatalog.appData && diagCatalog.appData.tours) || [];
            diag.steps.push({ step: '2_setting_sheet', ok: true, tourCount: diagTours.length, tours: diagTours.map(function(t) { return { name: t.name, status: t.status, type: t.type, shouldCreate: shouldCreateSheetForTour(t) }; }) });
            if (diagTours.length === 0) {
              diag.steps.push({ step: '2_tours_empty', ok: false, error: '⛔ tours 陣列是空的。後台可能沒有任何開團，或儲存格式錯誤。' });
              diag.ok = false;
            }
          }
        }
      } catch (e) {
        diag.steps.push({ step: '2_setting_sheet', ok: false, error: e.message });
        diag.ok = false;
      }
      // Step 3: 確認 DriveApp 有權限（嘗試建立測試資料夾）
      try {
        var testFolder = DriveApp.getRootFolder();
        diag.steps.push({ step: '3_drive_permission', ok: true, value: 'Drive 根目錄可存取：' + testFolder.getName() });
      } catch (e) {
        diag.steps.push({ step: '3_drive_permission', ok: false, error: '⛔ 沒有 Drive 權限：' + e.message + '。請重新部署並在授權對話框勾選所有權限。' });
        diag.ok = false;
      }
      // Step 4: 確認 ScriptProperties 可讀寫
      try {
        var diagProps = PropertiesService.getScriptProperties();
        diagProps.setProperty('__diag_test__', 'ok');
        var testRead = diagProps.getProperty('__diag_test__');
        diagProps.deleteProperty('__diag_test__');
        diag.steps.push({ step: '4_script_props', ok: testRead === 'ok', value: testRead });
      } catch (e) {
        diag.steps.push({ step: '4_script_props', ok: false, error: '⛔ ScriptProperties 無法讀寫：' + e.message });
        diag.ok = false;
      }
      // Step 5: 列出目前已記錄的開團表單 ID
      try {
        var allP = PropertiesService.getScriptProperties().getProperties();
        var campEntries = [];
        Object.keys(allP).forEach(function(k) { if (!isInternalPropKey(k)) campEntries.push({ name: k, id: allP[k] }); });
        diag.steps.push({ step: '5_stored_campaign_ids', ok: true, count: campEntries.length, campaigns: campEntries });
      } catch (e) {
        diag.steps.push({ step: '5_stored_campaign_ids', ok: false, error: e.message });
      }
      return jsonResponse(diag);
    }
 

    // clearTestData / deleteCampaignCompletely 只能用 POST（需登入 token），不再接受 GET 網址觸發。

    // 列出所有開團 Google Sheet：Script Properties 裡所有「團名 → Spreadsheet ID」對應。
    // 可在後台「設定 → Google Sheet 表單清理」使用。
    if (action === 'listCampaignSpreadsheets') {
      return jsonResponse(listCampaignSpreadsheets({ includeActive: true }));
    }

    // 舊版相容：只列殘留表單，或加 includeActive=1 時列全部。
    if (action === 'listResidualCampaignSpreadsheets') {
      var includeActiveResidualList = String(e.parameter.includeActive || '') === '1' || String(e.parameter.includeActive || '').toLowerCase() === 'true';
      return jsonResponse(listCampaignSpreadsheets({ includeActive: includeActiveResidualList }));
    }

    // 手動補齊所有開團表的二補公式，不影響 saveCatalog 速度。
    if (action === 'upgradeFormulas') {
      upgradeArrayFormulas();
      SpreadsheetApp.flush();
      return jsonResponse({ ok: true, status: 'success', message: '所有開團表公式已補齊' });
    }
 
    var mainSS = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = mainSS.getSheetByName(SETTING_SHEET);
    var catalogData = { appData: { tours: [] }, boardColumns: { columns: { open: '開團中', closed: '停止收單', sorting: '理貨中', instock: '現貨已有賣場' }, groups: [], storeDescription: '' } };
    if (sheet) {
      var saved = sheet.getRange('A1').getValue();
      if (saved) {
        try { catalogData = JSON.parse(saved); } catch (ignore) {}
      }
    }
    return jsonResponse(catalogData);
  } catch (err) {
    return errorResponse(err);
  }
}

// ── doPost ──
var PUBLIC_POST_ACTIONS = { 'login': true, 'createNewOrder': true };

function doPost(e) {
  var data;
  try {
    data = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (err) {
    return jsonResponse({ ok: false, error: 'invalid request' });
  }
  var action = data.action || '';
  if (action === 'login') return jsonResponse(login(data.password));
  if (action === 'logout') { logout(data.token); return jsonResponse({ ok: true }); }
  if (!PUBLIC_POST_ACTIONS[action] && !isValidToken(data.token)) return unauthorizedResponse();
  return withScriptLock(function() { return handlePost(action, data); });
}

function handlePost(action, data) {
  try {
    switch (action) {
      case 'updatePayStatus':
        updatePayStatus(data.campaignName || data.tourName, data.orderId, data.status || data.payStatus, data.bank5 || data.last5);
        return jsonResponse({ ok: true, status: 'success' });
      case 'batchUpdatePayStatus':
        (data.updates || []).forEach(function(u) {
          updatePayStatus(u.campaignName || u.tourName, u.orderId, u.status || u.payStatus || 'paid', u.bank5 || u.last5);
        });
        return jsonResponse({ ok: true, status: 'success', count: (data.updates || []).length });
      case 'batchUpdateSecondPayment':
        (data.updates || []).forEach(function(u) {
          updateSecondPaymentLogic(u.campaignName || u.tourName, u.orderId, u.weight, u.intlShipping, u.packageFee != null ? u.packageFee : u.packagingFee, u.bank5 || u.last5, u.secondPayStatus);
        });
        SpreadsheetApp.flush();
        return jsonResponse({ ok: true, status: 'success', count: (data.updates || []).length });
      case 'uploadImage':
        return uploadImage(data);
      case 'trashImages':
        return trashImages(data);
      case 'clearTestData':
        return jsonResponse(clearTestData({
          dryRun: String(data.confirm || '') !== 'DELETE_TEST_DATA',
          includeImages: data.includeImages === true || data.includeImages === 1 || String(data.includeImages || '').toLowerCase() === 'true'
        }));
      case 'deleteCampaignCompletely':
        return jsonResponse(deleteCampaignCompletely({
          campaignName: data.campaignName || data.tourName || data.name || '',
          dryRun: String(data.confirm || '') !== 'DELETE_CAMPAIGN',
          includeImages: data.includeImages === true || data.includeImages === 1 || String(data.includeImages || '').toLowerCase() === 'true'
        }));
      case 'listCampaignSpreadsheets':
        return jsonResponse(listCampaignSpreadsheets({ includeActive: true }));
      case 'listResidualCampaignSpreadsheets':
        return jsonResponse(listCampaignSpreadsheets({
          includeActive: data.includeActive === true || data.includeActive === 1 || String(data.includeActive || '').toLowerCase() === 'true'
        }));
      case 'saveCatalog':
        return saveCatalog(data);
      case 'createNewOrder':
        return createNewOrder(data);
      default:
        return jsonResponse({ ok: false, error: 'unknown action: ' + action });
    }
  } catch (error) {
    return errorResponse(error);
  }
}
 


// ── 開團 Google Sheet 表單掃描 ──
// 列出 Script Properties 裡所有「團名 → Spreadsheet ID」對應。
// inCatalog = 目前 catalog 的 appData.tours 仍有該團；residual = 後台一般刪除後殘留的表單。
function listCampaignSpreadsheets(options) {
  options = options || {};
  var includeActive = options.includeActive === true;
  var props = PropertiesService.getScriptProperties().getProperties();
  var activeNames = {};
  var catalogInfo = { found: false, tourCount: 0, parseError: '' };

  try {
    var catalog = readCatalogFromSettings();
    catalogInfo.found = true;
    var tours = getCatalogTours(catalog);
    catalogInfo.tourCount = tours.length;
    tours.forEach(function(t) {
      var name = getCatalogTourName(t);
      if (name) activeNames[propKeyCampaign(name)] = true;
    });
  } catch (e) {
    catalogInfo.parseError = e.message;
  }

  var items = [];
  Object.keys(props).forEach(function(k) {
    if (isInternalPropKey(k)) return;
    var id = props[k];
    var inCatalog = !!activeNames[propKeyCampaign(k)];
    if (!includeActive && inCatalog) return;

    var item = {
      name: k,
      id: id,
      url: '',
      fileName: '',
      inCatalog: inCatalog,
      residual: !inCatalog,
      wouldTrash: !inCatalog,
      error: ''
    };
    try {
      var file = DriveApp.getFileById(id);
      item.fileName = file.getName();
      item.url = file.getUrl();
    } catch (e2) {
      item.error = '表單不存在或無法存取：' + e2.message;
    }
    items.push(item);
  });

  items.sort(function(a, b) {
    if (a.residual !== b.residual) return a.residual ? -1 : 1;
    return String(a.name || '').localeCompare(String(b.name || ''), 'zh-Hant');
  });

  return {
    ok: true,
    includeActive: includeActive,
    catalog: catalogInfo,
    count: items.length,
    residualCount: items.filter(function(x) { return x.residual; }).length,
    activeCount: items.filter(function(x) { return !x.residual; }).length,
    items: items,
    message: items.length ? '已列出開團 Google Sheet 表單。' : '目前沒有開團 Google Sheet 表單。'
  };
}

// 舊版函式名稱相容。
function listResidualCampaignSpreadsheets(options) {
  return listCampaignSpreadsheets(options);
}

// ── 清空測試資料工具 ──
// 安全設計：
// 1. 沒有 confirm=DELETE_TEST_DATA 時，只會 dry run，不會真的刪除。
// 2. 只清「開團資料」與「開團試算表」，保留系統設定 sheet、B1 密碼、店名、主題、賣場說明。
// 3. DriveApp 只能移到垃圾桶，確認無誤後請到 Google Drive 垃圾桶手動永久刪除。
function clearTestData(options) {
  options = options || {};
  var dryRun = options.dryRun !== false;
  var includeImages = options.includeImages === true;
  var ss = getMainSpreadsheetOrThrow();
  var props = PropertiesService.getScriptProperties();
  var allProps = props.getProperties();
  var report = {
    ok: true,
    dryRun: dryRun,
    includeImages: includeImages,
    message: dryRun ? 'DRY RUN：尚未刪除任何資料。正式清空請加 confirm=DELETE_TEST_DATA。' : '已清空測試資料。',
    catalog: { found: false, tourCountBefore: 0, cleared: false, parseError: '' },
    campaignSpreadsheets: { count: 0, items: [], trashed: 0, propertyDeleted: 0, errors: [] },
    campaignIndex: { cleared: false },
    images: { attempted: false, folderId: '', trashed: 0, errors: [] },
    nextSteps: [
      '後台重新整理後按「從雲端載入」或直接重開頁面。',
      '買家前台重新整理。若仍看到舊資料，清除瀏覽器 localStorage 的 twt-data 類快取。',
      '確認無誤後，到 Google Drive 垃圾桶永久刪除舊測試開團試算表。'
    ]
  };

  // 1) 清 catalog 裡的 tours / campaigns，但保留 boardColumns、店名、主題、說明、groups 等設定。
  var settingSheet = ss.getSheetByName(SETTING_SHEET);
  if (settingSheet) {
    var raw = settingSheet.getRange('A1').getValue();
    var catalog = null;
    if (raw) {
      report.catalog.found = true;
      try {
        catalog = JSON.parse(raw);
      } catch (e) {
        report.catalog.parseError = e.message;
        catalog = { appData: { tours: [] }, boardColumns: {} };
      }
    } else {
      catalog = { appData: { tours: [] }, boardColumns: {} };
    }
    if (!catalog.appData) catalog.appData = {};
    report.catalog.tourCountBefore = getCatalogTours(catalog).length;
    catalog.appData.tours = [];
    // 相容舊版或本機格式，避免前端讀到 campaigns 殘留。
    if (Array.isArray(catalog.appData.campaigns)) catalog.appData.campaigns = [];
    if (!dryRun) {
      settingSheet.getRange('A1').setValue(JSON.stringify(catalog));
      report.catalog.cleared = true;
    }
  }

  // 2) 移除所有開團 spreadsheet，並刪掉 ScriptProperties 的團名→Spreadsheet ID 對應。
  Object.keys(allProps).forEach(function(k) {
    if (isInternalPropKey(k)) return;
    var id = allProps[k];
    var item = { name: k, id: id, url: '', fileName: '', wouldTrash: true, trashed: false, propertyDeleted: false, error: '' };
    report.campaignSpreadsheets.count++;
    try {
      var file = DriveApp.getFileById(id);
      item.fileName = file.getName();
      item.url = file.getUrl();
      if (!dryRun) {
        file.setTrashed(true);
        item.trashed = true;
        report.campaignSpreadsheets.trashed++;
      }
    } catch (e) {
      item.error = '開團試算表不存在或無法存取：' + e.message;
      report.campaignSpreadsheets.errors.push({ name: k, id: id, error: item.error });
    }
    try {
      if (!dryRun) {
        props.deleteProperty(k);
        item.propertyDeleted = true;
        report.campaignSpreadsheets.propertyDeleted++;
      }
    } catch (e2) {
      report.campaignSpreadsheets.errors.push({ name: k, id: id, error: '刪除 ScriptProperties 失敗：' + e2.message });
    }
    report.campaignSpreadsheets.items.push(item);
  });

  // 3) 清主控表的開團表單索引，不留下測試團列。
  var indexSheet = ss.getSheetByName(CAMPAIGN_INDEX_SHEET);
  if (!dryRun) {
    if (!indexSheet) indexSheet = ss.insertSheet(CAMPAIGN_INDEX_SHEET);
    resetCampaignIndexSheet(indexSheet);
    report.campaignIndex.cleared = true;
  }

  // 4) 可選：清空圖片資料夾。預設不做，避免誤刪正式封面圖。
  if (includeImages) {
    report.images.attempted = true;
    var imageFolderId = allProps['__IMAGE_FOLDER__'] || '';
    report.images.folderId = imageFolderId;
    if (imageFolderId) {
      try {
        var folder = DriveApp.getFolderById(imageFolderId);
        var files = folder.getFiles();
        while (files.hasNext()) {
          var f = files.next();
          if (!dryRun) {
            try { f.setTrashed(true); report.images.trashed++; }
            catch (ie) { report.images.errors.push({ id: f.getId(), name: f.getName(), error: ie.message }); }
          } else {
            report.images.trashed++;
          }
        }
        if (dryRun) report.images.note = 'dryRun 下 images.trashed 代表將會移到垃圾桶的圖片數量。';
      } catch (e3) {
        report.images.errors.push({ error: e3.message });
      }
    }
  }

  return report;
}

function resetCampaignIndexSheet(sheet) {
  var headers = ['更新時間','狀態','開團名稱','Spreadsheet ID','連結','備註'];
  sheet.clearContents();
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold').setBackground('#e5e7eb');
  sheet.autoResizeColumns(1, headers.length);
}

// ── 指定單一團務永久刪除工具 ──
// 安全設計：
// 1. 沒有 confirm=DELETE_CAMPAIGN 時，只做 dry run。
// 2. 只刪指定團，不會刪 boardColumns.groups、店名、主題、賣場說明。
// 3. Google Sheet 和圖片只會移到 Drive 垃圾桶，不會永久刪除。
function deleteCampaignCompletely(options) {
  options = options || {};
  var dryRun = options.dryRun !== false;
  var includeImages = options.includeImages === true;
  var campaignName = String(options.campaignName || '').trim();
  var ss = getMainSpreadsheetOrThrow();
  var props = PropertiesService.getScriptProperties();
  var report = {
    ok: true,
    dryRun: dryRun,
    includeImages: includeImages,
    campaignName: campaignName,
    message: dryRun ? 'DRY RUN：尚未刪除任何資料。正式刪除請加 confirm=DELETE_CAMPAIGN。' : '已永久刪除指定團務。',
    catalog: { found: false, removedTours: 0, tourCountBefore: 0, tourCountAfter: 0, parseError: '' },
    campaignSpreadsheet: { propertyFound: false, id: '', url: '', fileName: '', wouldTrash: false, trashed: false, propertyDeleted: false, error: '' },
    campaignIndex: { removedRows: 0 },
    images: { attempted: includeImages, ids: [], wouldTrash: 0, trashed: 0, errors: [] },
    nextSteps: [
      '後台重新整理後按「從雲端載入」或直接重開頁面。',
      '買家前台重新整理。若仍看到舊資料，清除瀏覽器 localStorage 的 twt-data 類快取。',
      '確認無誤後，到 Google Drive 垃圾桶永久刪除該團 Google Sheet 與圖片。'
    ]
  };

  if (!campaignName) {
    report.ok = false;
    report.message = '缺少 campaignName。';
    return report;
  }

  // 1) 從 catalog 移除指定團，保留 groups / storeDescription / theme / uiRoles。
  var settingSheet = ss.getSheetByName(SETTING_SHEET);
  var removedTours = [];
  if (settingSheet) {
    var raw = settingSheet.getRange('A1').getValue();
    var catalog = null;
    if (raw) {
      report.catalog.found = true;
      try {
        catalog = JSON.parse(raw);
      } catch (e) {
        report.catalog.parseError = e.message;
        catalog = { appData: { tours: [] }, boardColumns: {} };
      }
    } else {
      catalog = { appData: { tours: [] }, boardColumns: {} };
    }
    if (!catalog.appData) catalog.appData = {};
    var tours = getCatalogTours(catalog).slice();
    report.catalog.tourCountBefore = tours.length;
    var keptTours = [];
    tours.forEach(function(t) {
      if (String(getCatalogTourName(t) || '').trim() === campaignName) removedTours.push(t);
      else keptTours.push(t);
    });
    report.catalog.removedTours = removedTours.length;
    report.catalog.tourCountAfter = keptTours.length;
    if (includeImages) report.images.ids = collectTourImageIds(removedTours);
    if (!dryRun) {
      catalog.appData.tours = keptTours;
      if (Array.isArray(catalog.appData.campaigns)) {
        catalog.appData.campaigns = catalog.appData.campaigns.filter(function(c) {
          return String((c && (c.name || c.title || c.campaignName)) || '').trim() !== campaignName;
        });
      }
      settingSheet.getRange('A1').setValue(JSON.stringify(catalog));
    }
  }

  // 2) 該團 Google Sheet 移到垃圾桶，並刪 Script Properties 團名對應。
  var propKey = propKeyCampaign(campaignName);
  var ssId = props.getProperty(propKey);
  if (ssId) {
    report.campaignSpreadsheet.propertyFound = true;
    report.campaignSpreadsheet.id = ssId;
    report.campaignSpreadsheet.wouldTrash = true;
    try {
      var file = DriveApp.getFileById(ssId);
      report.campaignSpreadsheet.fileName = file.getName();
      report.campaignSpreadsheet.url = file.getUrl();
      if (!dryRun) {
        file.setTrashed(true);
        report.campaignSpreadsheet.trashed = true;
      }
    } catch (e2) {
      report.campaignSpreadsheet.error = '開團試算表不存在或無法存取：' + e2.message;
    }
    try {
      if (!dryRun) {
        props.deleteProperty(propKey);
        report.campaignSpreadsheet.propertyDeleted = true;
      }
    } catch (e3) {
      report.campaignSpreadsheet.error = report.campaignSpreadsheet.error ? (report.campaignSpreadsheet.error + '；刪除 ScriptProperties 失敗：' + e3.message) : ('刪除 ScriptProperties 失敗：' + e3.message);
    }
  }

  // 3) 從開團表單索引移除該團列。
  if (!dryRun) {
    report.campaignIndex.removedRows = removeCampaignFromIndex(campaignName);
  } else {
    report.campaignIndex.removedRows = countCampaignIndexRows(campaignName);
  }

  // 4) 可選：回收該團圖片。
  if (includeImages) {
    report.images.ids.forEach(function(id) {
      try {
        if (!dryRun) {
          if (trashImageFile(id)) report.images.trashed++;
          else report.images.errors.push({ id: id, error: '不在圖片資料夾內，未回收' });
        } else {
          report.images.wouldTrash++;
        }
      } catch (ie) {
        report.images.errors.push({ id: id, error: ie.message });
      }
    });
  }

  return report;
}

function collectTourImageIds(tours) {
  var ids = [];
  var seen = {};
  function pushUrl(u) {
    var id = extractDriveId(u);
    if (id && !seen[id]) { seen[id] = true; ids.push(id); }
  }
  (tours || []).forEach(function(t) {
    (t.coverImages || t.covers || []).forEach(pushUrl);
    (t.sections || []).forEach(function(sec) {
      pushUrl(sec.image || sec.img || '');
      (sec.items || sec.products || []).forEach(function(item) {
        pushUrl((item && (item.image || item.img)) || '');
      });
    });
  });
  return ids;
}

function countCampaignIndexRows(campaignName) {
  var ss = getMainSpreadsheetOrThrow();
  var sheet = ss.getSheetByName(CAMPAIGN_INDEX_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return 0;
  var rows = sheet.getDataRange().getValues();
  var hMap = getHeaderMap(rows[0]);
  var nameCol = hMap['開團名稱'] !== undefined ? hMap['開團名稱'] : 2;
  var count = 0;
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][nameCol] || '').trim() === campaignName) count++;
  }
  return count;
}

function removeCampaignFromIndex(campaignName) {
  var ss = getMainSpreadsheetOrThrow();
  var sheet = ss.getSheetByName(CAMPAIGN_INDEX_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return 0;
  var rows = sheet.getDataRange().getValues();
  var hMap = getHeaderMap(rows[0]);
  var nameCol = hMap['開團名稱'] !== undefined ? hMap['開團名稱'] : 2;
  var removed = 0;
  for (var r = rows.length - 1; r >= 1; r--) {
    if (String(rows[r][nameCol] || '').trim() === campaignName) {
      sheet.deleteRow(r + 1);
      removed++;
    }
  }
  return removed;
}

// ── saveCatalog ──
function saveCatalog(data) {
  var ss = getMainSpreadsheetOrThrow();
  var settingSheet = ss.getSheetByName(SETTING_SHEET);
  if (!settingSheet) settingSheet = ss.insertSheet(SETTING_SHEET);
 
  var catalog = { appData: data.appData || {}, boardColumns: data.boardColumns || {} };

  // 在覆寫 A1 前先讀「上一版 catalog」，比對相同 id 但團名不同的團，
  // 自動把舊的 Google Sheet 更名（檔名＋訂單明細「開團名稱」欄＋Script Properties 鍵），而不是新建表。
  var renameReport = reconcileCampaignRenames(readCatalogRawFromSheet(settingSheet), catalog);
 
  // 診斷：確認收到的 tours 數量，若為 0 直接回傳警告（設定仍會寫入）
  var receivedTours = getCatalogTours(catalog);
  if (receivedTours.length === 0) {
    settingSheet.getRange('A1').setValue(JSON.stringify(catalog));
    SpreadsheetApp.flush();
    return jsonResponse({
      ok: true,
      status: 'success',
      warning: 'tours_empty',
      message: '⚠️ 收到的開團列表是空的（tours.length === 0），沒有任何 Sheet 需要建立。請確認後台有開團資料再儲存。',
      createdSheets: [],
      existingSheets: [],
      skippedSheets: [],
      renamedSheets: renameReport,
      autoCreate: { tourCount: 0, created: [], existing: [], skipped: [], errors: [] }
    });
  }
 
  settingSheet.getRange('A1').setValue(JSON.stringify(catalog));
 
  // 現貨賣場 instock 不建訂單表
  var report = ensureCampaignSheetsFromCatalog(catalog);
  writeCampaignIndex(report);
 
  SpreadsheetApp.flush();
  return jsonResponse({
    ok: true,
    status: 'success',
    tourCount: receivedTours.length,
    createdSheets: report.created.map(function(x) { return x.name; }),
    existingSheets: report.existing.map(function(x) { return x.name; }),
    skippedSheets: report.skipped.map(function(x) { return x.name; }),
    renamedSheets: renameReport,
    autoCreate: report
  });
}
 
function readCatalogRawFromSheet(settingSheet) {
  try {
    if (!settingSheet) return null;
    var raw = settingSheet.getRange('A1').getValue();
    if (!raw) return null;
    return JSON.parse(raw);
  } catch (e) {
    return null;
  }
}

// 比對「上一版」與「這次」catalog，找出相同 id 但團名改變的團，
// 把對應的 Google Sheet 更名、搬移 Script Properties 鍵、更新訂單明細的「開團名稱」欄。
// 沒有舊資料或沒有改名時回傳空陣列（一般儲存幾乎是 no-op，不影響速度）。
function reconcileCampaignRenames(oldCatalog, newCatalog) {
  var report = [];
  if (!oldCatalog) return report;
  var props = PropertiesService.getScriptProperties();

  var oldNameById = {};
  getCatalogTours(oldCatalog).forEach(function(t) {
    if (t && t.id) oldNameById[String(t.id)] = getCatalogTourName(t);
  });

  getCatalogTours(newCatalog).forEach(function(t) {
    if (!t || !t.id) return;
    var id = String(t.id);
    var newName = getCatalogTourName(t);
    var oldName = oldNameById[id];
    if (!oldName || !newName || oldName === newName) return;

    var oldKey = propKeyCampaign(oldName);
    var newKey = propKeyCampaign(newName);
    var ssId = props.getProperty(oldKey);

    // 舊團名沒有對應表單（例如現貨團或從未建表）→ 沒東西可搬，交給後面 ensureCampaignSheets 處理。
    if (!ssId) return;

    // 防呆：若新團名已對應另一張不同的表單，不覆寫以免搞丟資料，改記錄衝突。
    var existingNewId = props.getProperty(newKey);
    if (existingNewId && existingNewId !== ssId) {
      report.push({ id: id, from: oldName, to: newName, ok: false, error: '新團名已對應另一張表單，未更名以免衝突。' });
      return;
    }

    var item = { id: id, from: oldName, to: newName, ok: true, error: '' };
    try {
      // 1) 搬移 Script Properties 鍵：新團名 → 同一個 spreadsheet id。
      props.setProperty(newKey, ssId);
      if (oldKey !== newKey) props.deleteProperty(oldKey);

      // 2) 更名 Google Sheet 檔案本身。
      var campSs = SpreadsheetApp.openById(ssId);
      campSs.rename(newName);

      // 3) 更新訂單明細「開團名稱」欄，讓後台對帳與買家查詢的歸戶一致。
      var orderSheet = campSs.getSheetByName(ORDER_SHEET);
      if (orderSheet) {
        var lastRow = getRealLastRow(orderSheet);
        if (lastRow > 1) {
          var headers = orderSheet.getRange(1, 1, 1, Math.max(1, orderSheet.getLastColumn())).getValues()[0];
          var nameCol = getHeaderMap(headers)['開團名稱'];
          if (nameCol !== undefined) {
            var col = [];
            for (var r = 2; r <= lastRow; r++) col.push([newName]);
            orderSheet.getRange(2, nameCol + 1, col.length, 1).setValues(col);
          }
        }
      }
    } catch (e) {
      item.ok = false;
      item.error = (e && e.message) ? e.message : String(e);
    }
    report.push(item);
  });

  return report;
}

function getMainSpreadsheetOrThrow() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) {
    throw new Error('找不到主控試算表。請從 Google Sheet 的「擴充功能 → Apps Script」建立此 GAS，不要使用 standalone Apps Script。');
  }
  return ss;
}
 
function readCatalogFromSettings() {
  var ss = getMainSpreadsheetOrThrow();
  var settingSheet = ss.getSheetByName(SETTING_SHEET);
  if (!settingSheet) return { appData: { tours: [] }, boardColumns: {} };
  var saved = settingSheet.getRange('A1').getValue();
  if (!saved) return { appData: { tours: [] }, boardColumns: {} };
  try {
    return JSON.parse(saved);
  } catch (e) {
    throw new Error('系統設定 A1 的 catalog JSON 解析失敗：' + e.message);
  }
}
 
function ensureCampaignSheetsFromCatalog(catalog) {
  var tours = getCatalogTours(catalog);
  var report = {
    tourCount: tours.length,
    created: [],
    existing: [],
    skipped: [],
    errors: [],
    folderUrl: ''
  };
 
  try {
    report.folderUrl = getCampaignFolder().getUrl();
  } catch (e) {
    report.errors.push({ name: '__folder__', error: '建立或讀取開團資料夾失敗：' + e.message });
  }
 
  tours.forEach(function(tour) {
    var name = getCatalogTourName(tour);
    var status = String((tour && tour.status) || '').toLowerCase();
    var type = String((tour && tour.type) || '').toLowerCase();
 
    if (!name) {
      report.skipped.push({ name: '(未命名)', status: status, type: type, reason: 'missing name' });
      return;
    }
    if (!shouldCreateSheetForTour(tour)) {
      report.skipped.push({ name: name, status: status, type: type, reason: 'instock / market' });
      return;
    }
 
    try {
      var ss = ensureCampaignSpreadsheet(name);
      setupCampaignSpreadsheet(ss, tour, name);
      var item = { name: name, id: ss.getId(), url: ss.getUrl(), status: status, type: type };
      if (ss.__twtCreatedNow) report.created.push(item);
      else report.existing.push(item);
    } catch (e) {
      report.errors.push({ name: name, status: status, type: type, error: e && e.stack ? e.stack : String(e) });
    }
  });
 
  return report;
}
 
