function updateItemSummary(ss, data, campaignName) {
  var sheet = ss.getSheetByName(ITEM_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(ITEM_SHEET);
  }
  ensureItemSummaryHeader(sheet);
 
  // 不再用 append 增加統計列。每次新訂單寫入後，依「訂單明細」整張重算，避免
  // 【區塊】 商品 和 區塊 - 商品 兩種 key 同時存在，造成統計表跑版。
  var tour = findCatalogTourByName(campaignName);
  var catalogItems = getCatalogItemObjects(tour || {});
  var catalogOrder = catalogItems.map(function(x) { return x.key; });
 
  var orderSheet = ss.getSheetByName(ORDER_SHEET);
  if (!orderSheet) return;
  var rows = orderSheet.getDataRange().getValues();
  if (rows.length <= 1) return;
  var hMap = getHeaderMap(rows[0]);
  var detailCol = hMap['訂單明細'];
  if (detailCol === undefined) return;
 
  var totals = {};
  for (var i = 1; i < rows.length; i++) {
    if (!rows[i].some(function(c) { return c !== '' && c !== null; })) continue;
    parseOrderItemsFromDetails(rows[i][detailCol]).forEach(function(item) {
      var key = canonicalizeOrderItemName(item.name, catalogItems);
      totals[key] = (totals[key] || 0) + item.qty;
    });
  }
 
  var orderedNames = [];
  catalogOrder.forEach(function(name) {
    if (orderedNames.indexOf(name) < 0) orderedNames.push(name);
  });
  Object.keys(totals).forEach(function(name) {
    if (orderedNames.indexOf(name) < 0) orderedNames.push(name);
  });
 
  var out = orderedNames.map(function(name) { return [name, totals[name] || 0]; });
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, 2).clearContent();
  if (out.length) sheet.getRange(2, 1, out.length, 2).setValues(out);
}
 
function writeSecondPayEntry(ss, data, orderId) {
  var sheet = ss.getSheetByName(SECOND_SHEET);
  if (!sheet) sheet = ss.insertSheet(SECOND_SHEET);
  var headers = ensureSecondHeaders(sheet);
  var hMap = getHeaderMap(headers);
 
  ['社群帳號','手機號碼','購買明細','二補收款狀態','訂單編號'].forEach(function(col) {
    if (hMap[col] !== undefined) sheet.getRange(1, hMap[col] + 1, sheet.getMaxRows(), 1).setNumberFormat('@');
  });
 
  // BUG FIX: 二補總計欄是整欄 ARRAYFORMULA。寫入新列時不要碰那一欄，否則寫進去的空字串
  // 會卡住公式展開（#REF! Array result was not expanded）。先寫入除了總計欄以外的資料，
  // 再於最後重設一次公式讓它重新展開到新列。
  var spCol = hMap[SECOND_TOTAL_HEADER];
  var row = new Array(headers.length).fill('');
  row[hMap['社群帳號']] = data.socialName || data.social || '';
  row[hMap['手機號碼']] = data.phone || '';
  row[hMap['購買明細']] = data.orderDetails || data.details || '';
  row[hMap['一補已付金額']] = Number(data.totalAmount || data.systemTotal || 0);
  if (hMap['商品重量(kg)'] !== undefined) row[hMap['商品重量(kg)']] = '';
  if (hMap['國際運費分攤'] !== undefined) row[hMap['國際運費分攤']] = '';
  if (hMap['包材費'] !== undefined) row[hMap['包材費']] = '';
  if (hMap['二補收款狀態'] !== undefined) row[hMap['二補收款狀態']] = '未收款';
  if (hMap['訂單編號'] !== undefined) row[hMap['訂單編號']] = orderId;
 
  var targetRow = getRealLastRow(sheet) + 1;
  if (spCol === undefined) {
    sheet.getRange(targetRow, 1, 1, row.length).setValues([row]);
  } else {
    // 分兩段寫入，跳過總計欄，避免覆蓋 ARRAYFORMULA 的展開範圍。
    if (spCol > 0) sheet.getRange(targetRow, 1, 1, spCol).setValues([row.slice(0, spCol)]);
    if (spCol < row.length - 1) sheet.getRange(targetRow, spCol + 2, 1, row.length - spCol - 1).setValues([row.slice(spCol + 1)]);
  }
 
  // 寫完資料列後重設公式，使其涵蓋新列並修復任何先前被卡住的狀態。
  ensureSecPayFormula(sheet, hMap);
}
 
// ── 圖片上傳到 Google Drive ──
function getImageFolder() {
  var props = PropertiesService.getScriptProperties();
  var key = '__IMAGE_FOLDER__';
  var saved = props.getProperty(key);
  if (saved) {
    try { return DriveApp.getFolderById(saved); } catch (ignore) {}
  }
  var folder = DriveApp.createFolder('TWT_代購平台_圖片');
  props.setProperty(key, folder.getId());
  return folder;
}
 
function uploadImage(data) {
  var base64 = data.base64 || '';
  var mime = data.mimeType || 'image/jpeg';
  if (data.dataUrl) {
    var m = String(data.dataUrl).match(/^data:([^;]+);base64,(.*)$/);
    if (m) { mime = m[1]; base64 = m[2]; }
  }
  if (!base64) return jsonResponse({ ok: false, error: 'no image data' });
  if (!/^image\/(jpeg|png|gif|webp)$/i.test(String(mime))) return jsonResponse({ ok: false, error: '只接受 JPG / PNG / GIF / WEBP 圖片' });
  if (base64.length > 14000000) return jsonResponse({ ok: false, error: '圖片太大（上限約 10MB）' });
 
  var bytes = Utilities.base64Decode(base64);
  var ext = (String(mime).split('/')[1] || 'jpg').replace('jpeg', 'jpg');
  var safe = data.name ? String(data.name).replace(/[^\w.\-]/g, '_') : ('img_' + Date.now());
  var blob = Utilities.newBlob(bytes, mime, safe + '.' + ext);
 
  var folder = getImageFolder();
  var file = folder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  var id = file.getId();
  return jsonResponse({
    ok: true,
    status: 'success',
    id: id,
    url: 'https://drive.google.com/thumbnail?id=' + id + '&sz=w1000',
    viewUrl: 'https://drive.google.com/file/d/' + id + '/view'
  });
}
 
function trashImages(data) {
  var ids = (data.ids || []).slice();
  if ((!ids || !ids.length) && data.urls) ids = (data.urls || []).map(extractDriveId).filter(Boolean);
  var trashed = 0;
  (ids || []).forEach(function(id) {
    try { if (trashImageFile(id)) trashed++; } catch (ignore) {}
  });
  return jsonResponse({ ok: true, status: 'success', trashed: trashed });
}

// 只回收放在「TWT_代購平台_圖片」資料夾裡的檔案，其他 Drive 檔案一律不動。
function trashImageFile(id) {
  var folderId = PropertiesService.getScriptProperties().getProperty('__IMAGE_FOLDER__');
  if (!folderId || !id) return false;
  var file = DriveApp.getFileById(id);
  var parents = file.getParents();
  while (parents.hasNext()) {
    if (parents.next().getId() === folderId) {
      file.setTrashed(true);
      return true;
    }
  }
  return false;
}
 
function extractDriveId(u) {
  if (!u) return '';
  u = String(u);
  var m = u.match(/[?&]id=([\w-]+)/); if (m) return m[1];
  m = u.match(/\/d\/([\w-]+)/); if (m) return m[1];
  return '';
}
