  row[hMap['開團名稱']] = campaignName;
  row[hMap['社群帳號']] = data.socialName || data.social || '';
  row[hMap['個人主頁連結']] = data.socialLink || '';
  row[hMap['電子郵件']] = data.email || '';
  row[hMap['手機號碼']] = data.phone || '';
  row[hMap['訂單明細']] = data.orderDetails || data.details || '';
  row[hMap['系統總計金額']] = Number(data.totalAmount || data.systemTotal || 0);
  if (hMap['原幣總金額'] !== undefined) row[hMap['原幣總金額']] = Number(data.originalAmount || data.origAmount || data.currencyTotal || data.originalTotal || 0);
  row[hMap['買家匯款金額']] = Number(data.remitAmount || data.buyerPaid || 0);
  row[hMap['匯款後五碼']] = String(data.bank5 || data.last5 || '').replace(/\D/g, '').slice(-5);
  row[hMap['備註']] = data.remark || '';
  var cardSortText = String(data.cardSort || data.cardPriority || '').trim();
  var cardSortMode = String(data.cardSortMode || data.fullGiftMode || '').trim();
  var priorityText = data.priorityData || buildPriorityDataText(cardSortText, cardSortMode, data.cardCount || data.fullGiftCount || 0);
  if (!cardSortMode && priorityText) cardSortMode = extractCardSortMode(priorityText);
  cardSortText = normalizeCardSortForSheet(cardSortText, cardSortMode, priorityText);
  if (hMap['滿額卡張數'] !== undefined) row[hMap['滿額卡張數']] = Number(data.cardCount || data.fullGiftCount || parseCardCount(priorityText) || 0);
  if (hMap['滿額卡排序'] !== undefined) row[hMap['滿額卡排序']] = cardSortText;
  row[hMap['付款狀態']] = data.payStatus || 'pending';
  row[hMap['訂單編號']] = orderId;
  sheet.getRange(getRealLastRow(sheet) + 1, 1, 1, row.length).setValues([row]);
}
 
 
 
function estimateOriginalAmountFromDetails(details, catalogItems) {
  var originalMap = {};
  (catalogItems || []).forEach(function(it) { originalMap[it.key] = Number(it.original || 0); });
  var total = 0;
  parseOrderItemsFromDetails(details).forEach(function(item) {
    var key = canonicalizeOrderItemName(item.name, catalogItems || []);
    total += (Number(originalMap[key] || 0) * Number(item.qty || 0));
  });
  return total;
}
 
function normalizeAllOrderSheets() {
  var allProps = PropertiesService.getScriptProperties().getProperties();
  var updated = [], skipped = [], errors = [];
  for (var campName in allProps) {
    if (isInternalPropKey(campName)) continue;
    try {
      var ss = SpreadsheetApp.openById(allProps[campName]);
      var sheet = ss.getSheetByName(ORDER_SHEET);
      if (!sheet) {
        skipped.push({ name: campName, reason: 'no order sheet' });
        continue;
      }
      normalizeOrderSheetColumns(sheet);
      updated.push({ name: campName, id: allProps[campName] });
    } catch (e) {
      errors.push({ name: campName, error: e && e.stack ? e.stack : String(e) });
    }
  }
  return { updated: updated, skipped: skipped, errors: errors };
}
 
function backfillOrderCardFields() {
  var catalog = readCatalogFromSettings();
  var tours = getCatalogTours(catalog);
  var props = PropertiesService.getScriptProperties();
  var updated = [], skipped = [], errors = [];
  tours.forEach(function(tour) {
    var name = getCatalogTourName(tour);
    if (!name || !shouldCreateSheetForTour(tour)) {
      skipped.push({ name: name || '(未命名)', reason: 'instock / missing name' });
      return;
    }
    var ssId = props.getProperty(propKeyCampaign(name));
    if (!ssId) {
      skipped.push({ name: name, reason: 'no spreadsheet id' });
      return;
    }
    try {
      var ss = SpreadsheetApp.openById(ssId);
      var sheet = ss.getSheetByName(ORDER_SHEET);
      if (!sheet) {
        skipped.push({ name: name, reason: 'no order sheet' });
        return;
      }
      var headers = normalizeOrderSheetColumns(sheet);
      var hMap = getHeaderMap(headers);
      var rows = sheet.getDataRange().getValues();
      if (rows.length <= 1) {
        skipped.push({ name: name, reason: 'no orders' });
        return;
      }
      var detailCol = hMap['訂單明細'];
      var originalCol = hMap['原幣總金額'];
      var cardCountCol = hMap['滿額卡張數'];
      var priorityCol = hMap['滿額卡排序'];
      var catalogItems = getCatalogItemObjects(tour || {});
      var threshold = Number(tour.threshold || 0);
      var changed = 0;
      for (var i = 1; i < rows.length; i++) {
        if (!rows[i].some(function(c) { return c !== '' && c !== null; })) continue;
        var detail = detailCol !== undefined ? rows[i][detailCol] : '';
        var priority = priorityCol !== undefined ? rows[i][priorityCol] : '';
        var original = originalCol !== undefined ? Number(rows[i][originalCol] || 0) : 0;
        if (!original) original = estimateOriginalAmountFromDetails(detail, catalogItems);
        var cardCount = cardCountCol !== undefined ? Number(rows[i][cardCountCol] || 0) : 0;
        if (!cardCount) cardCount = parseCardCount(priority);
        if (!cardCount && threshold > 0 && original > 0) cardCount = Math.floor(original / threshold) || 0;
        var extractedSort = normalizeCardSortForSheet(priority, '', priority);
        var r = i + 1;
        if (originalCol !== undefined && Number(rows[i][originalCol] || 0) !== original) {
          sheet.getRange(r, originalCol + 1).setValue(original);
          changed++;
        }
        if (cardCountCol !== undefined && Number(rows[i][cardCountCol] || 0) !== cardCount) {
          sheet.getRange(r, cardCountCol + 1).setValue(cardCount);
          changed++;
        }
        if (priorityCol !== undefined && extractedSort && String(rows[i][priorityCol] || '') !== extractedSort) {
          sheet.getRange(r, priorityCol + 1).setValue(extractedSort);
          changed++;
        }
      }
      updated.push({ name: name, id: ssId, changedCells: changed });
    } catch (e) {
      errors.push({ name: name, error: e && e.stack ? e.stack : String(e) });
    }
  });
  return { updated: updated, skipped: skipped, errors: errors };
}
 
