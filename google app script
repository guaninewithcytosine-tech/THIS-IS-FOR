function loadSecondPayDataMap(ss) {
  var byId = {}, byPhone = {};
  var secSheet = ss.getSheetByName(SECOND_SHEET);
  if (!secSheet) return { byId: byId, byPhone: byPhone };
  var secRows = secSheet.getDataRange().getValues();
  if (secRows.length <= 1) return { byId: byId, byPhone: byPhone };
  var hMap = getHeaderMap(secRows[0]);
  for (var j = 1; j < secRows.length; j++) {
    var info = {
      weight: hMap['商品重量(kg)'] !== undefined ? secRows[j][hMap['商品重量(kg)']] : '',
      intlShipping: hMap['國際運費分攤'] !== undefined ? secRows[j][hMap['國際運費分攤']] : '',
      packagingFee: hMap['包材費'] !== undefined ? secRows[j][hMap['包材費']] : '',
      secondPayment: hMap[SECOND_TOTAL_HEADER] !== undefined ? secRows[j][hMap[SECOND_TOTAL_HEADER]] : '',
      secondPayStatus: hMap['二補收款狀態'] !== undefined ? secRows[j][hMap['二補收款狀態']] : '未收款'
    };
    var id = hMap['訂單編號'] !== undefined ? String(secRows[j][hMap['訂單編號']] || '') : '';
    var phone = String(secRows[j][1] || '').replace(/\D/g, '');
    if (id) byId[id] = info;
    if (phone) byPhone[phone] = info;
  }
  return { byId: byId, byPhone: byPhone };
}
 
// ── updatePayStatus ──
function updatePayStatus(campaignName, orderId, status, bank5) {
  campaignName = propKeyCampaign(campaignName);
  var ssId = PropertiesService.getScriptProperties().getProperty(campaignName);
  if (!ssId) return;
  var ss = SpreadsheetApp.openById(ssId);
  var sheet = ss.getSheetByName(ORDER_SHEET);
  if (!sheet) return;
  var rows = sheet.getDataRange().getValues();
  var headers = rows[0];
  var hMap = getHeaderMap(headers);
  headers = ensureColumns(sheet, headers, ['付款狀態', '訂單編號']);
  hMap = getHeaderMap(headers);
  var idCol = hMap['訂單編號'], payCol = hMap['付款狀態'];
  var bank5Str = String(bank5 || '').replace(/\D/g, '').slice(-5);
  var target = -1;
  if (orderId && idCol !== undefined) {
    for (var i = 1; i < rows.length; i++) {
      if (String(rows[i][idCol] || '') === String(orderId)) { target = i; break; }
    }
  }
  if (target < 0 && bank5Str) {
    for (var j = 1; j < rows.length; j++) {
      var rb = String(getVal(rows[j], hMap, '匯款後五碼')).replace(/\D/g, '').slice(-5);
      if (rb === bank5Str) { target = j; break; }
    }
  }
  if (target < 0 || payCol === undefined) return;
  sheet.getRange(target + 1, payCol + 1).setValue(status || 'pending');
}
 
// ── updateSecondPaymentLogic ──
function updateSecondPaymentLogic(campaignName, orderId, weight, intlShipping, packagingFee, bank5, secondPayStatus) {
  campaignName = propKeyCampaign(campaignName);
  var ssId = PropertiesService.getScriptProperties().getProperty(campaignName);
  if (!ssId) return;
  var ss = SpreadsheetApp.openById(ssId);
  var orderSheet = ss.getSheetByName(ORDER_SHEET);
  var secSheet = ss.getSheetByName(SECOND_SHEET);
  if (!secSheet) return;
 
  var secHeaders = ensureSecondHeaders(secSheet);
  var secHMap = getHeaderMap(secHeaders);
  ensureSecPayFormula(secSheet, secHMap);
 
  var targetPhone = null;
  if ((!orderId || secHMap['訂單編號'] === undefined) && orderSheet) {
    var orderRows = orderSheet.getDataRange().getValues();
    var oM = getHeaderMap(orderRows[0]);
    var b = String(bank5 || '').replace(/\D/g, '').slice(-5);
    for (var i = 1; i < orderRows.length; i++) {
      var rb = String(getVal(orderRows[i], oM, '匯款後五碼')).replace(/\D/g, '').slice(-5);
      if (b && rb === b) {
        targetPhone = String(getVal(orderRows[i], oM, '手機號碼')).replace(/\D/g, '');
        break;
      }
    }
  }
 
  var secRows = secSheet.getDataRange().getValues();
  var idCol = secHMap['訂單編號'];
  for (var j = 1; j < secRows.length; j++) {
    var idMatch = orderId && idCol !== undefined && String(secRows[j][idCol] || '') === String(orderId);
    var phoneMatch = !idMatch && targetPhone && String(secRows[j][1] || '').replace(/\D/g, '') === targetPhone;
    if (idMatch || phoneMatch) {
      var r = j + 1;
      if (secHMap['商品重量(kg)'] !== undefined) secSheet.getRange(r, secHMap['商品重量(kg)'] + 1).setValue(weight);
      if (secHMap['國際運費分攤'] !== undefined) secSheet.getRange(r, secHMap['國際運費分攤'] + 1).setValue(intlShipping);
      if (secHMap['包材費'] !== undefined) secSheet.getRange(r, secHMap['包材費'] + 1).setValue(packagingFee);
      if (secHMap['二補收款狀態'] !== undefined) secSheet.getRange(r, secHMap['二補收款狀態'] + 1).setValue(normalizeSecondStatus(secondPayStatus));
      break;
    }
  }
}
 
function ensureSecPayFormula(secSheet, hMap) {
  var spCol = hMap[SECOND_TOTAL_HEADER];
  var intlCol = hMap['國際運費分攤'];
  var packCol = hMap['包材費'];
  if (spCol === undefined || intlCol === undefined || packCol === undefined) return;
  var intlLetter = colToLetter(intlCol);
  var packLetter = colToLetter(packCol);
  var maxRows = secSheet.getMaxRows();
  if (maxRows > 1) secSheet.getRange(2, spCol + 1, maxRows - 1).clearContent();
  secSheet.getRange(1, spCol + 1).setFormula(
    '={"' + SECOND_TOTAL_HEADER + '"; ARRAYFORMULA(IF(A2:A="", "", IFERROR(' + intlLetter + '2:' + intlLetter + '*1, 0) + IFERROR(' + packLetter + '2:' + packLetter + '*1, 0)))}'
  );
}
 
// ── createNewOrder ──
function createNewOrder(data) {
  var timestamp = new Date();
  // 買家送來的金額一律不採信：用 catalog 找出開團，依商品 id 與數量在伺服器端重算。
  var tour = findOrderableTour(data.tourId || data.campaignId, data.campaignName);
  var campaignName = getCatalogTourName(tour);
  var order = buildServerOrder(tour, data);
  var orderId = makeOrderId(timestamp);

  var ss = ensureCampaignSpreadsheet(campaignName);
  if (ss.__twtCreatedNow) setupCampaignSpreadsheet(ss, tour, campaignName);

  writeOrderDetail(ss, order, timestamp, campaignName, orderId);
  updateItemSummary(ss, order, campaignName);
  writeSecondPayEntry(ss, order, orderId);
  return jsonResponse({ ok: true, status: 'success', orderId: orderId });
}

function findOrderableTour(tourId, campaignName) {
  var tours = getCatalogTours(readCatalogFromSettings());
  tourId = String(tourId || '').trim();
  campaignName = String(campaignName || '').trim();
  var tour = null;
  for (var i = 0; i < tours.length && !tour; i++) {
    if (tourId && String((tours[i] && tours[i].id) || '').trim() === tourId) tour = tours[i];
  }
  for (var j = 0; j < tours.length && !tour && !tourId; j++) {
    if (campaignName && getCatalogTourName(tours[j]) === campaignName) tour = tours[j];
  }
  if (!tour) throw new Error('找不到這個開團，請重新整理頁面');
  if (String(tour.status || 'open').toLowerCase() !== 'open') throw new Error('這個開團已停止收單');
  if (!getCatalogTourName(tour)) throw new Error('開團缺少名稱');
  return tour;
}

function cleanText(v, maxLen) {
  return String(v == null ? '' : v).trim().slice(0, maxLen);
}

// 依 catalog 價格建立訂單內容；明細格式與買家頁面一致：「【區塊】 商品 xN」。
function buildServerOrder(tour, data) {
  var items = Array.isArray(data.items) ? data.items : [];
  if (!items.length) throw new Error('購物車是空的，請重新整理頁面後再下單');
  var lines = [], total = 0, original = 0;
  items.forEach(function(it) {
    var qty = Number(it && it.qty);
    if (!(qty >= 1 && qty <= 999 && Math.floor(qty) === qty)) throw new Error('商品數量不正確');
    var sec = (tour.sections || []).filter(function(s) { return String(s.id) === String(it.sectionId); })[0];
    var item = sec && (sec.items || []).filter(function(x) { return String(x.id) === String(it.itemId); })[0];
    if (!item) throw new Error('商品已變更，請重新整理頁面');
    total += (Number(item.twd) || 0) * qty;
    original += (Number(item.original) || 0) * qty;
    lines.push((sec.title ? '【' + sec.title + '】 ' : '') + item.name + ' x' + qty);
  });

  var socialName = cleanText(data.socialName, 100);
  var phone = String(data.phone || '').replace(/\D/g, '');
  var bank5 = String(data.bank5 || '').replace(/\D/g, '');
  var remit = Number(String(data.remitAmount || '').replace(/[^\d.]/g, ''));
  if (!socialName) throw new Error('請填寫社群帳號');
  if (phone.length < 8 || phone.length > 15) throw new Error('手機號碼格式不正確');
  if (bank5.length !== 5) throw new Error('匯款後五碼需為 5 位數字');
  if (!(remit > 0)) throw new Error('請填寫正確的匯款金額');

  var threshold = Number(tour.threshold || 0);
  var cardCount = threshold > 0 ? Math.floor(original / threshold) : 0;
  var cardSort = '', cardSortMode = '';
  if (cardCount > 0) {
    if (isRandomCardSortText(data.cardSortMode)) {
      cardSortMode = '隨機分配';
    } else {
      // 只保留這個團真的有的成員名稱
      var memberNames = (tour.cardMembers || []).map(function(m) { return String((m && m.name) || ''); });
      cardSort = String(data.cardSort || '').split('>').map(function(s) { return s.trim(); })
        .filter(function(s) { return memberNames.indexOf(s) >= 0; }).join(' > ');
      if (cardSort) cardSortMode = '自選排序';
    }
  }

  return {
    socialName: socialName,
    socialLink: cleanText(data.socialLink, 300),
    phone: phone,
    email: cleanText(data.email, 200),
    orderDetails: lines.join('\n'),
    totalAmount: total,
    originalAmount: original,
    remitAmount: remit,
    bank5: bank5,
    remark: cleanText(data.remark, 1000),
    cardCount: cardCount,
    cardSort: cardSort,
    cardSortMode: cardSortMode,
    priorityData: buildPriorityDataText(cardSort, cardSortMode, cardCount),
    payStatus: 'pending'
  };
}

function writeOrderDetail(ss, data, timestamp, campaignName, orderId) {
  var sheet = ss.getSheetByName(ORDER_SHEET);
  if (!sheet) sheet = ss.insertSheet(ORDER_SHEET, 0);
  var headers = normalizeOrderSheetColumns(sheet);
  var hMap = getHeaderMap(headers);
 
  applyOrderTextFormats(sheet, hMap);
 
  var row = new Array(headers.length).fill('');
  row[hMap['時間戳記']] = timestamp;
  row[hMap['開團名稱']] = campaignName;
  row[hMap['社群帳號']] = data.socialName || data.social || '';
  row[hMap['個人主頁連結']] = data.socialLink || '';
  row[hMap['電子郵件']] = data.email || '';
  row[hMap['手機號碼']] = data.phone || '';
  row[hMap['訂單明細']] = data.orderDetails || data.details || '';
  row[hMap['系統總計金額']] = Number(data.totalAmount || data.systemTotal || 0);
  if (hMap['原幣總金額'] !== undefined) row[hMap['原幣總金額']] = Number(data.originalAmount || data.origAmount || data.currencyTotal || data.originalTotal || 0);
  row[hMap['買家匯款金額']] = Number(data.remitAmount || data.buyerPaid || 0);
  row[hMap['匯款後五碼']] = String(data.bank5 || data.last5 || '').replace(/\D/g, '').slice(-5);
  row[hMap['備註']] = data.remark || '';
  var cardSortText = String(data.cardSort || data.cardPriority || '').trim();
  var cardSortMode = String(data.cardSortMode || data.fullGiftMode || '').trim();
  var priorityText = data.priorityData || buildPriorityDataText(cardSortText, cardSortMode, data.cardCount || data.fullGiftCount || 0);
  if (!cardSortMode && priorityText) cardSortMode = extractCardSortMode(priorityText);
  cardSortText = normalizeCardSortForSheet(cardSortText, cardSortMode, priorityText);
  if (hMap['滿額卡張數'] !== undefined) row[hMap['滿額卡張數']] = Number(data.cardCount || data.fullGiftCount || parseCardCount(priorityText) || 0);
  if (hMap['滿額卡排序'] !== undefined) row[hMap['滿額卡排序']] = cardSortText;
  row[hMap['付款狀態']] = data.payStatus || 'pending';
  row[hMap['訂單編號']] = orderId;
  sheet.getRange(getRealLastRow(sheet) + 1, 1, 1, row.length).setValues([row]);
}
 
 
 
function estimateOriginalAmountFromDetails(details, catalogItems) {
  var originalMap = {};
  (catalogItems || []).forEach(function(it) { originalMap[it.key] = Number(it.original || 0); });
  var total = 0;
  parseOrderItemsFromDetails(details).forEach(function(item) {
    var key = canonicalizeOrderItemName(item.name, catalogItems || []);
    total += (Number(originalMap[key] || 0) * Number(item.qty || 0));
  });
  return total;
}
 
function normalizeAllOrderSheets() {
  var allProps = PropertiesService.getScriptProperties().getProperties();
  var updated = [], skipped = [], errors = [];
  for (var campName in allProps) {
    if (isInternalPropKey(campName)) continue;
    try {
      var ss = SpreadsheetApp.openById(allProps[campName]);
      var sheet = ss.getSheetByName(ORDER_SHEET);
      if (!sheet) {
        skipped.push({ name: campName, reason: 'no order sheet' });
        continue;
      }
      normalizeOrderSheetColumns(sheet);
      updated.push({ name: campName, id: allProps[campName] });
    } catch (e) {
      errors.push({ name: campName, error: e && e.stack ? e.stack : String(e) });
    }
  }
  return { updated: updated, skipped: skipped, errors: errors };
}
 
function backfillOrderCardFields() {
  var catalog = readCatalogFromSettings();
  var tours = getCatalogTours(catalog);
  var props = PropertiesService.getScriptProperties();
  var updated = [], skipped = [], errors = [];
  tours.forEach(function(tour) {
    var name = getCatalogTourName(tour);
    if (!name || !shouldCreateSheetForTour(tour)) {
      skipped.push({ name: name || '(未命名)', reason: 'instock / missing name' });
      return;
    }
    var ssId = props.getProperty(propKeyCampaign(name));
    if (!ssId) {
      skipped.push({ name: name, reason: 'no spreadsheet id' });
      return;
    }
    try {
      var ss = SpreadsheetApp.openById(ssId);
      var sheet = ss.getSheetByName(ORDER_SHEET);
      if (!sheet) {
        skipped.push({ name: name, reason: 'no order sheet' });
        return;
      }
      var headers = normalizeOrderSheetColumns(sheet);
      var hMap = getHeaderMap(headers);
      var rows = sheet.getDataRange().getValues();
      if (rows.length <= 1) {
        skipped.push({ name: name, reason: 'no orders' });
        return;
      }
      var detailCol = hMap['訂單明細'];
      var originalCol = hMap['原幣總金額'];
      var cardCountCol = hMap['滿額卡張數'];
      var priorityCol = hMap['滿額卡排序'];
      var catalogItems = getCatalogItemObjects(tour || {});
      var threshold = Number(tour.threshold || 0);
      var changed = 0;
      for (var i = 1; i < rows.length; i++) {
        if (!rows[i].some(function(c) { return c !== '' && c !== null; })) continue;
        var detail = detailCol !== undefined ? rows[i][detailCol] : '';
        var priority = priorityCol !== undefined ? rows[i][priorityCol] : '';
        var original = originalCol !== undefined ? Number(rows[i][originalCol] || 0) : 0;
        if (!original) original = estimateOriginalAmountFromDetails(detail, catalogItems);
        var cardCount = cardCountCol !== undefined ? Number(rows[i][cardCountCol] || 0) : 0;
        if (!cardCount) cardCount = parseCardCount(priority);
        if (!cardCount && threshold > 0 && original > 0) cardCount = Math.floor(original / threshold) || 0;
        var extractedSort = normalizeCardSortForSheet(priority, '', priority);
        var r = i + 1;
        if (originalCol !== undefined && Number(rows[i][originalCol] || 0) !== original) {
          sheet.getRange(r, originalCol + 1).setValue(original);
          changed++;
        }
        if (cardCountCol !== undefined && Number(rows[i][cardCountCol] || 0) !== cardCount) {
          sheet.getRange(r, cardCountCol + 1).setValue(cardCount);
          changed++;
        }
        if (priorityCol !== undefined && extractedSort && String(rows[i][priorityCol] || '') !== extractedSort) {
          sheet.getRange(r, priorityCol + 1).setValue(extractedSort);
          changed++;
        }
      }
      updated.push({ name: name, id: ssId, changedCells: changed });
    } catch (e) {
      errors.push({ name: name, error: e && e.stack ? e.stack : String(e) });
    }
  });
  return { updated: updated, skipped: skipped, errors: errors };
}
 
function rebuildAllItemSummaries() {
  var catalog = readCatalogFromSettings();
  var tours = getCatalogTours(catalog);
  var props = PropertiesService.getScriptProperties();
  var updated = [], skipped = [], errors = [];
  tours.forEach(function(tour) {
