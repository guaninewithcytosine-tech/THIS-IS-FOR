}
 
// 儲存格內容不是有效日期時回傳空字串，避免整個開團的訂單因一格錯誤而全部讀不到。
function safeIsoTime(v) {
  if (!v) return '';
  var d = v instanceof Date ? v : new Date(v);
  return isNaN(d.getTime()) ? '' : d.toISOString();
}

// ── getAllOrders ──
function getAllOrders() {
  var allProps = PropertiesService.getScriptProperties().getProperties();
  var result = [];
  for (var campName in allProps) {
    if (isInternalPropKey(campName)) continue;
    try {
      var ssId = allProps[campName];
      var ss = SpreadsheetApp.openById(ssId);
      var sheet = ss.getSheetByName(ORDER_SHEET);
      if (!sheet) continue;
      var rows = sheet.getDataRange().getValues();
      if (rows.length <= 1) continue;
      var hMap = getHeaderMap(rows[0]);
      var secMaps = loadSecondPayDataMap(ss);
 
      for (var i = 1; i < rows.length; i++) {
        var row = rows[i];
        if (!row.some(function(c) { return c !== '' && c !== null; })) continue;
        var phoneVal = String(getVal(row, hMap, '手機號碼')).replace(/\D/g, '');
        var orderId = String(getVal(row, hMap, '訂單編號'));
        var secInfo = (orderId && secMaps.byId[orderId]) || secMaps.byPhone[phoneVal] || { weight: '', intlShipping: '', packagingFee: '', secondPayment: '', secondPayStatus: '未收款' };
        var rawCardSortText = getVal(row, hMap, '滿額卡排序');
        var cardSortMode = getVal(row, hMap, '滿額卡分配方式') || extractCardSortMode(rawCardSortText);
        var cardSortText = normalizeCardSortForSheet(rawCardSortText, cardSortMode, rawCardSortText);
        var priorityData = buildPriorityDataText(cardSortText, cardSortMode, getVal(row, hMap, '滿額卡張數', 0));
        var originalAmount = Number(getVal(row, hMap, '原幣總金額', 0)) || 0;
        var storedCardCount = Number(getVal(row, hMap, '滿額卡張數', 0)) || parseCardCount(priorityData);
        result.push({
          rowIndex: i + 1,
          spreadsheetId: ssId,
          orderId: orderId,
          campaignName: getVal(row, hMap, '開團名稱', campName),
          timestamp: hMap['時間戳記'] !== undefined ? safeIsoTime(row[hMap['時間戳記']]) : '',
          socialName: getVal(row, hMap, '社群帳號'),
          socialLink: getVal(row, hMap, '個人主頁連結'),
          phone: phoneVal,
          orderDetails: getVal(row, hMap, '訂單明細'),
          totalAmount: Number(getVal(row, hMap, '系統總計金額', 0)) || 0,
          remitAmount: Number(getVal(row, hMap, '買家匯款金額', 0)) || 0,
          originalAmount: originalAmount,
          bank5: String(getVal(row, hMap, '匯款後五碼')).replace(/\D/g, '').slice(-5),
          remark: getVal(row, hMap, '備註'),
          priorityData: priorityData,
          cardSort: cardSortText,
          cardSortMode: cardSortMode,
          cardCount: storedCardCount,
          payStatus: getVal(row, hMap, '付款狀態', 'pending'),
          weight: secInfo.weight,
          intlShipping: secInfo.intlShipping,
          packagingFee: secInfo.packagingFee,
          secondPayment: secInfo.secondPayment,
          secondPayStatus: normalizeSecondStatus(secInfo.secondPayStatus)
        });
      }
    } catch (ignore) {}
  }
  return result;
}
 
