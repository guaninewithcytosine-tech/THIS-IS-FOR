function makeItemKey(sectionName, itemName) {
  sectionName = String(sectionName || '').trim();
  itemName = String(itemName || '').trim();
  return sectionName ? ('【' + sectionName + '】 ' + itemName) : itemName;
}
 
function normalizeItemText(s) {
  return String(s || '')
    .replace(/[【】\[\]（）()]/g, ' ')
    .replace(/[·・･\-－—–:：|｜]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}
 
function getCatalogItemObjects(tour) {
  var out = [];
  var seen = {};
  (tour && tour.sections || []).forEach(function(sec, si) {
    var secTitle = String(sec.title || sec.name || '').trim();
    (sec.items || sec.products || []).forEach(function(item, ii) {
      var itemName = item && item.name ? String(item.name).trim() : '';
      if (!itemName) return;
      var key = makeItemKey(secTitle, itemName);
      if (seen[key]) return;
      seen[key] = true;
      out.push({
        key: key,
        section: secTitle,
        name: itemName,
        normSection: normalizeItemText(secTitle),
        normName: normalizeItemText(itemName),
        normFull: normalizeItemText(secTitle + ' ' + itemName),
        original: Number(item.original || item.defaultOriginal || 0),
        twd: Number(item.twd || item.defaultTwd || 0),
        order: si * 10000 + ii
      });
    });
  });
  return out;
}
 
function getCatalogItemRows(tour) {
  return getCatalogItemObjects(tour || {}).map(function(x) { return x.key; });
}
 
function findCatalogTourByName(campaignName) {
  try {
    var catalog = readCatalogFromSettings();
    var tours = getCatalogTours(catalog);
    campaignName = String(campaignName || '').trim();
    for (var i = 0; i < tours.length; i++) {
      if (String(getCatalogTourName(tours[i]) || '').trim() === campaignName) return tours[i];
    }
  } catch (ignore) {}
  return null;
}
 
function parseOrderItemsFromDetails(details) {
  var out = [];
  String(details || '').split(/\r?\n/).forEach(function(line) {
    line = String(line || '').trim();
    if (!line) return;
    if (line.indexOf('📝') === 0 || line.indexOf('【滿額卡排序】') === 0 || line.indexOf('🎲') === 0) return;
    if (/滿額卡/i.test(line) || line.indexOf('張 |') >= 0) return;
    var m = line.match(/^(.+?)\s*x\s*(\d+)\s*$/i);
    if (!m) return;
    var name = String(m[1] || '').trim();
    var qty = parseInt(m[2], 10) || 0;
    if (name && qty > 0) out.push({ name: name, qty: qty });
  });
  return out;
}
 
function canonicalizeOrderItemName(rawName, catalogItems) {
  rawName = String(rawName || '').trim();
  var rawNorm = normalizeItemText(rawName);
  if (!rawNorm) return rawName;
 
  for (var i = 0; i < catalogItems.length; i++) {
    if (catalogItems[i].normFull === rawNorm || normalizeItemText(catalogItems[i].key) === rawNorm) return catalogItems[i].key;
  }
 
  // 前台常見格式：區塊 · 商品、區塊 - 商品。轉成 catalog 中的「【區塊】 商品」。
  var best = null;
  for (var j = 0; j < catalogItems.length; j++) {
    var it = catalogItems[j];
    if (it.normSection && it.normName && rawNorm === normalizeItemText(it.normSection + ' ' + it.normName)) return it.key;
    if (it.normSection && it.normName && rawNorm.indexOf(it.normSection) >= 0 && rawNorm.indexOf(it.normName) >= 0) {
      best = best || it;
    }
  }
  if (best) return best.key;
 
  // 如果訂單明細只剩商品名，且 catalog 內沒有重名，就可對應。
  var sameName = catalogItems.filter(function(it) { return it.normName === rawNorm; });
  if (sameName.length === 1) return sameName[0].key;
 
  return rawName;
}
 
function removeDefaultBlankSheet(ss) {
  var sheets = ss.getSheets();
  if (sheets.length <= 1) return;
  sheets.forEach(function(sh) {
    var n = sh.getName();
    if ((n === '工作表1' || n === '工作表 1' || n === 'Sheet1') && sh.getLastRow() <= 1 && sh.getLastColumn() <= 1 && !sh.getRange(1, 1).getValue()) {
      try { ss.deleteSheet(sh); } catch (ignore) {}
    }
  });
}
 
function ensureSecondHeaders(sheet) {
  var headers = ensureHeaderRow(sheet, SECOND_HEADERS);
