var PUBLIC_POST_ACTIONS = { 'login': true, 'createNewOrder': true };

function doPost(e) {
  _catalogMemo = null;
  var data;
  try {
    data = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (err) {
    return jsonResponse({ ok: false, error: 'invalid request' });
  }
  var action = data.action || '';
  if (action === 'login') return jsonResponse(login(data.password));
  if (action === 'logout') { logout(data.token); return jsonResponse({ ok: true }); }
  if (!PUBLIC_POST_ACTIONS[action] && !isValidToken(data.token)) return unauthorizedResponse();
  return withScriptLock(function() { return handlePost(action, data); });
}

// 後台改了付款或二補後，更新那幾個團在索引表單的數字；失敗也不影響原本的動作
function touchIndex(campaignNames) {
  try { updateCampaignIndexRows(campaignSheetIds(campaignNames)); } catch (ignore) {}
}

function handlePost(action, data) {
  try {
    switch (action) {
      case 'updatePayStatus':
        updatePayStatus(data.campaignName || data.tourName, data.orderId, data.status || data.payStatus, data.bank5 || data.last5);
        touchIndex([data.campaignName || data.tourName]);
        return jsonResponse({ ok: true, status: 'success' });
      case 'batchUpdatePayStatus':
        (data.updates || []).forEach(function(u) {
          updatePayStatus(u.campaignName || u.tourName, u.orderId, u.status || u.payStatus || 'paid', u.bank5 || u.last5);
        });
        touchIndex((data.updates || []).map(function(u) { return u.campaignName || u.tourName; }));
        return jsonResponse({ ok: true, status: 'success', count: (data.updates || []).length });
      case 'batchUpdateSecondPayment':
        (data.updates || []).forEach(function(u) {
          updateSecondPaymentLogic(u.campaignName || u.tourName, u.orderId, u.weight, u.intlShipping, u.packageFee != null ? u.packageFee : u.packagingFee, u.bank5 || u.last5, u.secondPayStatus);
        });
        SpreadsheetApp.flush();
        touchIndex((data.updates || []).map(function(u) { return u.campaignName || u.tourName; }));
        return jsonResponse({ ok: true, status: 'success', count: (data.updates || []).length });
      case 'uploadImage':
        return uploadImage(data);
      case 'trashImages':
        return trashImages(data);
      case 'clearTestData':
        return jsonResponse(clearTestData({
          dryRun: String(data.confirm || '') !== 'DELETE_TEST_DATA',
          includeImages: data.includeImages === true || data.includeImages === 1 || String(data.includeImages || '').toLowerCase() === 'true'
        }));
      case 'deleteCampaignCompletely':
        return jsonResponse(deleteCampaignCompletely({
          campaignName: data.campaignName || data.tourName || data.name || '',
          dryRun: String(data.confirm || '') !== 'DELETE_CAMPAIGN',
          includeImages: data.includeImages === true || data.includeImages === 1 || String(data.includeImages || '').toLowerCase() === 'true'
        }));
      case 'listCampaignSpreadsheets':
        return jsonResponse(listCampaignSpreadsheets({ includeActive: true }));
      case 'listResidualCampaignSpreadsheets':
        return jsonResponse(listCampaignSpreadsheets({
          includeActive: data.includeActive === true || data.includeActive === 1 || String(data.includeActive || '').toLowerCase() === 'true'
        }));
      case 'saveCatalog':
        return saveCatalog(data);
      case 'createNewOrder':
        return createNewOrder(data);
      default:
        return jsonResponse({ ok: false, error: 'unknown action: ' + action });
    }
  } catch (error) {
    return errorResponse(error);
  }
}
 


// ── 開團 Google Sheet 表單掃描 ──
// 列出 Script Properties 裡所有「團名 → Spreadsheet ID」對應。
// inCatalog = 網站上還在的團；residual = 已結束（後台已刪除）的團，表單保留。
function listCampaignSpreadsheets(options) {
  options = options || {};
  var includeActive = options.includeActive === true;
  var props = PropertiesService.getScriptProperties().getProperties();
  var activeNames = {};
  var catalogInfo = { found: false, tourCount: 0, parseError: '' };

  try {
    activeNames = activeTourNames();
    catalogInfo.found = true;
    catalogInfo.tourCount = Object.keys(activeNames).length;
  } catch (e) {
    catalogInfo.parseError = e.message;
  }

  var items = [];
  Object.keys(props).forEach(function(k) {
    if (isInternalPropKey(k)) return;
    var id = props[k];
    var inCatalog = !!activeNames[propKeyCampaign(k)];
    if (!includeActive && inCatalog) return;

    var item = {
      name: k,
      id: id,
      url: '',
      fileName: '',
      inCatalog: inCatalog,
      residual: !inCatalog,
      wouldTrash: !inCatalog,
      error: ''
    };
    try {
      var file = DriveApp.getFileById(id);
      item.fileName = file.getName();
      item.url = file.getUrl();
    } catch (e2) {
      item.error = '表單不存在或無法存取：' + e2.message;
    }
    items.push(item);
  });

  items.sort(function(a, b) {
    if (a.residual !== b.residual) return a.residual ? -1 : 1;
    return String(a.name || '').localeCompare(String(b.name || ''), 'zh-Hant');
  });

  return {
    ok: true,
    includeActive: includeActive,
    catalog: catalogInfo,
    count: items.length,
    residualCount: items.filter(function(x) { return x.residual; }).length,
    activeCount: items.filter(function(x) { return !x.residual; }).length,
    items: items,
    message: items.length ? '已列出開團 Google Sheet 表單。' : '目前沒有開團 Google Sheet 表單。'
  };
}

// 舊版函式名稱相容。
function listResidualCampaignSpreadsheets(options) {
  return listCampaignSpreadsheets(options);
}

// ── 清空測試資料工具 ──
// 安全設計：
// 1. 沒有 confirm=DELETE_TEST_DATA 時，只會 dry run，不會真的刪除。
// 2. 只清「開團資料」與「開團試算表」，保留系統設定 sheet、B1 密碼、店名、主題、賣場說明。
// 3. DriveApp 只能移到垃圾桶，確認無誤後請到 Google Drive 垃圾桶手動永久刪除。
function clearTestData(options) {
  options = options || {};
  var dryRun = options.dryRun !== false;
  var includeImages = options.includeImages === true;
  var ss = getMainSpreadsheetOrThrow();
  var props = PropertiesService.getScriptProperties();
  var allProps = props.getProperties();
  var report = {
    ok: true,
    dryRun: dryRun,
    includeImages: includeImages,
    message: dryRun ? 'DRY RUN：尚未刪除任何資料。正式清空請加 confirm=DELETE_TEST_DATA。' : '已清空測試資料。',
    catalog: { found: false, tourCountBefore: 0, cleared: false, parseError: '' },
    campaignSpreadsheets: { count: 0, items: [], trashed: 0, propertyDeleted: 0, errors: [] },
    campaignIndex: { cleared: false },
    images: { attempted: false, folderId: '', trashed: 0, errors: [] },
    nextSteps: [
      '後台重新整理後按「從雲端載入」或直接重開頁面。',
      '買家前台重新整理。若仍看到舊資料，清除瀏覽器 localStorage 的 twt-data 類快取。',
      '確認無誤後，到 Google Drive 垃圾桶永久刪除舊測試開團試算表。'
    ]
  };

  // 1) 清空團務資料（含已結束的團），保留系統設定（店名、主題、說明、團體等）。
  var catalog;
  try {
    catalog = readCatalogFromSettings();
    report.catalog.found = true;
  } catch (e) {
    report.catalog.parseError = e.message;
    catalog = { appData: { tours: [] }, boardColumns: {} };
  }
  report.catalog.tourCountBefore = getCatalogTours(catalog).length;
  catalog.appData = { tours: [] };
  if (!dryRun) {
    writeCatalog(catalog, { purgeAll: true });
    report.catalog.cleared = true;
  }

  // 2) 移除所有開團 spreadsheet，並刪掉 ScriptProperties 的團名→Spreadsheet ID 對應。
  Object.keys(allProps).forEach(function(k) {
    if (isInternalPropKey(k)) return;
    var id = allProps[k];
    var item = { name: k, id: id, url: '', fileName: '', wouldTrash: true, trashed: false, propertyDeleted: false, error: '' };
    report.campaignSpreadsheets.count++;
    try {
      var file = DriveApp.getFileById(id);
      item.fileName = file.getName();
      item.url = file.getUrl();
      if (!dryRun) {
        file.setTrashed(true);
        item.trashed = true;
        report.campaignSpreadsheets.trashed++;
      }
    } catch (e) {
      item.error = '開團試算表不存在或無法存取：' + e.message;
      report.campaignSpreadsheets.errors.push({ name: k, id: id, error: item.error });
    }
    try {
      if (!dryRun) {
        props.deleteProperty(k);
        item.propertyDeleted = true;
        report.campaignSpreadsheets.propertyDeleted++;
      }
    } catch (e2) {
      report.campaignSpreadsheets.errors.push({ name: k, id: id, error: '刪除 ScriptProperties 失敗：' + e2.message });
    }
    report.campaignSpreadsheets.items.push(item);
  });

  // 3) 清 TWT 代購管理表的團務索引表單，不留下測試團列。
  if (!dryRun) {
    refreshCampaignIndex(null, []);
    report.campaignIndex.cleared = true;
  }

  // 4) 可選：清空圖片資料夾。預設不做，避免誤刪正式封面圖。
  if (includeImages) {
    report.images.attempted = true;
    var imageFolderId = allProps['__IMAGE_FOLDER__'] || '';
    report.images.folderId = imageFolderId;
    if (imageFolderId) {
      try {
        var folder = DriveApp.getFolderById(imageFolderId);
        var files = folder.getFiles();
        while (files.hasNext()) {
          var f = files.next();
          if (!dryRun) {
            try { f.setTrashed(true); report.images.trashed++; }
            catch (ie) { report.images.errors.push({ id: f.getId(), name: f.getName(), error: ie.message }); }
          } else {
            report.images.trashed++;
          }
        }
        if (dryRun) report.images.note = 'dryRun 下 images.trashed 代表將會移到垃圾桶的圖片數量。';
      } catch (e3) {
        report.images.errors.push({ error: e3.message });
      }
    }
  }

  return report;
}


// ── 指定單一團務永久刪除工具 ──
// 安全設計：
// 1. 沒有 confirm=DELETE_CAMPAIGN 時，只做 dry run。
// 2. 只刪指定團，不會刪 boardColumns.groups、店名、主題、賣場說明。
// 3. Google Sheet 和圖片只會移到 Drive 垃圾桶，不會永久刪除。
function deleteCampaignCompletely(options) {
  options = options || {};
  var dryRun = options.dryRun !== false;
  var includeImages = options.includeImages === true;
  var campaignName = String(options.campaignName || '').trim();
  var ss = getMainSpreadsheetOrThrow();
  var props = PropertiesService.getScriptProperties();
  var report = {
    ok: true,
    dryRun: dryRun,
    includeImages: includeImages,
    campaignName: campaignName,
    message: dryRun ? 'DRY RUN：尚未刪除任何資料。正式刪除請加 confirm=DELETE_CAMPAIGN。' : '已永久刪除指定團務。',
    catalog: { found: false, removedTours: 0, tourCountBefore: 0, tourCountAfter: 0, parseError: '' },
    campaignSpreadsheet: { propertyFound: false, id: '', url: '', fileName: '', wouldTrash: false, trashed: false, propertyDeleted: false, error: '' },
    campaignIndex: { removedRows: 0 },
    images: { attempted: includeImages, ids: [], wouldTrash: 0, trashed: 0, errors: [] },
    nextSteps: [
      '後台重新整理後按「從雲端載入」或直接重開頁面。',
      '買家前台重新整理。若仍看到舊資料，清除瀏覽器 localStorage 的 twt-data 類快取。',
      '確認無誤後，到 Google Drive 垃圾桶永久刪除該團 Google Sheet 與圖片。'
    ]
  };

  if (!campaignName) {
    report.ok = false;
    report.message = '缺少 campaignName。';
    return report;
  }

  // 1) 從團務資料移除指定團（不論是否已結束），系統設定不動。
  var removedTours = [];
  var catalog = null;
  try {
    catalog = readCatalogFromSettings();
    report.catalog.found = true;
  } catch (e) {
    report.catalog.parseError = e.message;
  }
  if (catalog) {
    var tours = getCatalogTours(catalog).slice();
    report.catalog.tourCountBefore = tours.length;
    var keptTours = [];
    tours.forEach(function(t) {
      if (String(getCatalogTourName(t) || '').trim() === campaignName) removedTours.push(t);
      else keptTours.push(t);
    });
    report.catalog.removedTours = removedTours.length;
    report.catalog.tourCountAfter = keptTours.length;
    if (includeImages) report.images.ids = collectTourImageIds(removedTours);
    if (!dryRun) {
      catalog.appData.tours = keptTours;
      writeCatalog(catalog, { purgeName: campaignName });
    }
  }

  // 2) 該團 Google Sheet 移到垃圾桶，並刪 Script Properties 團名對應。
  var propKey = propKeyCampaign(campaignName);
  var ssId = props.getProperty(propKey);
  if (ssId) {
    report.campaignSpreadsheet.propertyFound = true;
    report.campaignSpreadsheet.id = ssId;
    report.campaignSpreadsheet.wouldTrash = true;
    try {
      var file = DriveApp.getFileById(ssId);
      report.campaignSpreadsheet.fileName = file.getName();
      report.campaignSpreadsheet.url = file.getUrl();
      if (!dryRun) {
        file.setTrashed(true);
        report.campaignSpreadsheet.trashed = true;
      }
    } catch (e2) {
      report.campaignSpreadsheet.error = '開團試算表不存在或無法存取：' + e2.message;
    }
    try {
      if (!dryRun) {
        props.deleteProperty(propKey);
        report.campaignSpreadsheet.propertyDeleted = true;
      }
    } catch (e3) {
      report.campaignSpreadsheet.error = report.campaignSpreadsheet.error ? (report.campaignSpreadsheet.error + '；刪除 ScriptProperties 失敗：' + e3.message) : ('刪除 ScriptProperties 失敗：' + e3.message);
    }
  }

  // 3) 從團務索引表單移除該團列。
  if (!dryRun) {
    report.campaignIndex.removedRows = removeCampaignFromIndex(campaignName);
  } else {
    report.campaignIndex.removedRows = countCampaignIndexRows(campaignName);
  }

  // 4) 可選：回收該團圖片。
  if (includeImages) {
    report.images.ids.forEach(function(id) {
      try {
        if (!dryRun) {
          if (trashImageFile(id)) report.images.trashed++;
          else report.images.errors.push({ id: id, error: '不在圖片資料夾內，未回收' });
        } else {
          report.images.wouldTrash++;
        }
      } catch (ie) {
        report.images.errors.push({ id: id, error: ie.message });
      }
    });
  }

  return report;
}

function collectTourImageIds(tours) {
  var ids = [];
  var seen = {};
  function pushUrl(u) {
    var id = extractDriveId(u);
    if (id && !seen[id]) { seen[id] = true; ids.push(id); }
  }
  (tours || []).forEach(function(t) {
    (t.coverImages || t.covers || []).forEach(pushUrl);
    (t.sections || []).forEach(function(sec) {
      pushUrl(sec.image || sec.img || '');
      (sec.items || sec.products || []).forEach(function(item) {
        pushUrl((item && (item.image || item.img)) || '');
      });
    });
  });
  return ids;
}

function countCampaignIndexRows(campaignName) {
  var ss = getMainSpreadsheetOrThrow();
  var sheet = ss.getSheetByName(CAMPAIGN_INDEX_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return 0;
  var rows = sheet.getDataRange().getValues();
  var hMap = getHeaderMap(rows[0]);
  var nameCol = hMap['團務名稱'] !== undefined ? hMap['團務名稱'] : (hMap['開團名稱'] !== undefined ? hMap['開團名稱'] : 0);
  var count = 0;
  for (var i = 1; i < rows.length; i++) {
    if (String(rows[i][nameCol] || '').trim() === campaignName) count++;
  }
  return count;
}

function removeCampaignFromIndex(campaignName) {
  var ss = getMainSpreadsheetOrThrow();
  var sheet = ss.getSheetByName(CAMPAIGN_INDEX_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return 0;
  var rows = sheet.getDataRange().getValues();
  var hMap = getHeaderMap(rows[0]);
  var nameCol = hMap['團務名稱'] !== undefined ? hMap['團務名稱'] : (hMap['開團名稱'] !== undefined ? hMap['開團名稱'] : 0);
  var removed = 0;
  for (var r = rows.length - 1; r >= 1; r--) {
    if (String(rows[r][nameCol] || '').trim() === campaignName) {
      sheet.deleteRow(r + 1);
      removed++;
    }
  }
  return removed;
}

// ── saveCatalog ──
function saveCatalog(data) {
  var catalog = { appData: data.appData || {}, boardColumns: data.boardColumns || {} };
  var receivedTours = getCatalogTours(catalog);
  assertNoLocalImages(receivedTours);

  // 相同 id 但團名不同的團：把舊的 Google Sheet 更名，而不是新建表
  var previous = { appData: { tours: readStoredTours(getMainSpreadsheetOrThrow()).tours } };
  var renameReport = reconcileCampaignRenames(previous, catalog);

  // 現貨賣場 instock 不建訂單表
  var report = receivedTours.length ? ensureCampaignSheetsFromCatalog(catalog)
    : { tourCount: 0, created: [], existing: [], skipped: [], errors: [] };
  // 後台刪除的團 → 團務資料標記「已結束」並刪除圖片，該團的 Google Sheet 保留
  var written = writeCatalog(catalog);
  refreshCampaignIndex(report);

  SpreadsheetApp.flush();
  return jsonResponse({
    ok: true,
    status: 'success',
    warning: receivedTours.length ? '' : 'tours_empty',
    tourCount: receivedTours.length,
    createdSheets: report.created.map(function(x) { return x.name; }),
    existingSheets: report.existing.map(function(x) { return x.name; }),
    skippedSheets: report.skipped.map(function(x) { return x.name; }),
    renamedSheets: renameReport,
    endedTours: written.ended,
    autoCreate: report
  });
}

// 比對「上一版」與「這次」catalog，找出相同 id 但團名改變的團，
// 把對應的 Google Sheet 更名、搬移 Script Properties 鍵、更新訂單明細的「開團名稱」欄。
// 沒有舊資料或沒有改名時回傳空陣列（一般儲存幾乎是 no-op，不影響速度）。
function reconcileCampaignRenames(oldCatalog, newCatalog) {
  var report = [];
  if (!oldCatalog) return report;
  var props = PropertiesService.getScriptProperties();

  var oldNameById = {};
  getCatalogTours(oldCatalog).forEach(function(t) {
    if (t && t.id) oldNameById[String(t.id)] = getCatalogTourName(t);
  });

  getCatalogTours(newCatalog).forEach(function(t) {
    if (!t || !t.id) return;
    var id = String(t.id);
    var newName = getCatalogTourName(t);
    var oldName = oldNameById[id];
    if (!oldName || !newName || oldName === newName) return;

    var oldKey = propKeyCampaign(oldName);
    var newKey = propKeyCampaign(newName);
    var ssId = props.getProperty(oldKey);

    // 舊團名沒有對應表單（例如現貨團或從未建表）→ 沒東西可搬，交給後面 ensureCampaignSheets 處理。
    if (!ssId) return;

    // 防呆：若新團名已對應另一張不同的表單，不覆寫以免搞丟資料，改記錄衝突。
    var existingNewId = props.getProperty(newKey);
    if (existingNewId && existingNewId !== ssId) {
      report.push({ id: id, from: oldName, to: newName, ok: false, error: '新團名已對應另一張表單，未更名以免衝突。' });
      return;
    }

    var item = { id: id, from: oldName, to: newName, ok: true, error: '' };
    try {
      // 1) 搬移 Script Properties 鍵：新團名 → 同一個 spreadsheet id。
      props.setProperty(newKey, ssId);
      if (oldKey !== newKey) props.deleteProperty(oldKey);

      // 2) 更名 Google Sheet 檔案本身。
      var campSs = SpreadsheetApp.openById(ssId);
      campSs.rename(newName);

      // 3) 更新訂單明細「開團名稱」欄，讓後台對帳與買家查詢的歸戶一致。
      var orderSheet = campSs.getSheetByName(ORDER_SHEET);
      if (orderSheet) {
        var lastRow = getRealLastRow(orderSheet);
        if (lastRow > 1) {
          var headers = orderSheet.getRange(1, 1, 1, Math.max(1, orderSheet.getLastColumn())).getValues()[0];
          var nameCol = getHeaderMap(headers)['開團名稱'];
          if (nameCol !== undefined) {
            var col = [];
            for (var r = 2; r <= lastRow; r++) col.push([newName]);
            orderSheet.getRange(2, nameCol + 1, col.length, 1).setValues(col);
          }
        }
      }
    } catch (e) {
      item.ok = false;
      item.error = (e && e.message) ? e.message : String(e);
    }
    report.push(item);
  });

  return report;
}

function getMainSpreadsheetOrThrow() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) {
    throw new Error('找不到 TWT 代購管理表。請從 Google Sheet 的「擴充功能 → Apps Script」建立此 GAS，不要使用 standalone Apps Script。');
  }
  return ss;
}
 
// ══════════════════════════════════════════
// 資料儲存
// ・TWT 代購管理表「系統設定」：只放系統設定，一列一個項目（A1/B1 = 後台密碼）
// ・TWT 代購管理表「團務資料」：每個團一列（名稱、狀態、說明、連結…），網站顯示的內容
// ・各團自己的 Google Sheet「商品清單」：該團的區塊與商品
// ・後台刪除的團：「團務資料」狀態改為「已結束」、圖片刪除；該團的 Google Sheet（訂單、商品）保留
// 舊版格式（系統設定 A1 的 JSON、「開團資料」「商品資料」分頁）仍可讀取，下次儲存時自動轉成新格式。
// ══════════════════════════════════════════
var TOUR_SHEET = '團務資料';
var LEGACY_TOUR_SHEET = '開團資料';
var LEGACY_ITEM_SHEET = '商品資料';
var PRODUCT_SHEET = '商品清單';
var LEGACY_INDEX_SHEET = '開團表單索引';
var PRODUCT_CACHE_TTL = 600; // 各團商品清單快取 10 分鐘，避免每次開買家頁面都要打開每個團的試算表

var STATUS_LABELS = { open: '開團中', closed: '停止收單', sorting: '理貨中', instock: '現貨賣場', ended: '團務結束', deleted: '已結束' };
var STORE_CATEGORY_LABELS = { stock: '現貨賣場', group: '團務下單賣場' };
var LOGI_STEP_LABELS = ['已結單', '已下單', '在途中', '清關中', '理貨中', '出貨中'];
var BOARD_COLUMN_KEYS = ['open', 'closed', 'sorting', 'instock', 'ended'];
var BOARD_COLUMN_LABELS = { open: '開團中欄', closed: '停止收單欄', sorting: '理貨欄', instock: '現貨賣場欄', ended: '團務結束欄' };
var PALETTE_LABELS = ['主題色 1（主色）', '主題色 2（副色）', '主題色 3（點綴）', '主題色 4（強調）', '主題色 5（補充）'];
var UI_ROLE_LABELS = [
  ['btnPrimary', '主要按鈕'], ['btnSecondary', '副按鈕'], ['btnDanger', '刪除／危險按鈕'], ['accent', '重點強調色'],
  ['tagOpen', '收單中標籤'], ['tagClosed', '已結單標籤'], ['tagSorting', '團務結束標籤'], ['tagInstock', '現貨標籤'],
  ['tagService', '團務下單標籤'], ['badgePaid', '已付款徽章'], ['badgePending', '待付款徽章'],
  ['brand', '店名顏色'], ['logiActive', '團務進度條'], ['cardRankNum', '順位編號顏色']
];

var TOUR_HEADERS = ['團務名稱', '狀態', '團體', '幣別', '滿額門檻', '滿額禮名稱', '滿額禮單位', '團務進度', '賣場分類', '賣貨便連結',
  '開團說明', '匯款說明', '排序說明', '排序方式', '排序成員', '封面圖', '團務ID（系統用）'];
var TOUR_HEADER_ALIASES = { '團務名稱': ['開團名稱'], '團務ID（系統用）': ['開團ID（系統用）'] };
var TOUR_NUMBER_COLS = ['滿額門檻'];
var TOUR_WRAP_COLS = ['開團說明', '匯款說明', '排序說明', '排序成員', '封面圖'];

var PRODUCT_HEADERS = ['區塊', '商品名稱', '台幣價', '原幣價', '重量(kg)', '商品圖片',
  '區塊圖片', '區塊預設台幣', '區塊預設原幣', '區塊預設重量', '區塊ID（系統用）', '商品ID（系統用）'];
var PRODUCT_NUMBER_COLS = ['台幣價', '原幣價', '重量(kg)', '區塊預設台幣', '區塊預設原幣', '區塊預設重量'];

var _catalogMemo = null; // 同一次請求內重複讀取時直接用

// 網站（後台、買家頁面）用的資料：不含已結束（後台已刪除）的團
function readCatalogFromSettings() {
  if (_catalogMemo) return JSON.parse(_catalogMemo);
  var ss = getMainSpreadsheetOrThrow();
  var stored = readStoredTours(ss);
  var tours = stored.tours.filter(function(t) { return t.status !== 'deleted'; });
  if (!stored.legacyJson) {
    var legacyItems = readLegacyItemSheet(ss);
    tours.forEach(function(t) { t.sections = readTourProducts(t, legacyItems); });
  }
  var catalog = { appData: { tours: tours }, boardColumns: readSystemSettings(ss, stored.legacyJson) };
  _catalogMemo = JSON.stringify(catalog);
  return catalog;
}

// options.purgeAll：連已結束的團也一起從團務資料移除（清空測試資料用）
// options.purgeName：把這個團名從團務資料完全移除（永久刪除用）
function writeCatalog(catalog, options) {
  options = options || {};
  var ss = getMainSpreadsheetOrThrow();
  var tours = getCatalogTours(catalog).map(function(t) { var c = JSON.parse(JSON.stringify(t)); c.status = String(c.status || 'open').toLowerCase(); return c; });
  assertNoLocalImages(tours);
  var activeIds = {};
  tours.forEach(function(t) { activeIds[String(t.id)] = true; });

  // 上一版不在這次列表裡的團 → 已結束（保留列、刪圖片、保留該團的 Google Sheet）
  // 收到空的列表（例如後台還沒載入資料就按了儲存）時不動任何團，避免全部被標成已結束、圖片被刪
  var keepMissing = !tours.length && !options.purgeAll && !options.purgeName;
  var stored = readStoredTours(ss);
  var legacyItems = stored.legacyJson ? null : readLegacyItemSheet(ss);
  var ended = [], newlyEnded = [];
  stored.tours.forEach(function(t) {
    if (activeIds[String(t.id)]) return;
    if (options.purgeAll || (options.purgeName && getCatalogTourName(t) === options.purgeName)) return;
    if (t.status !== 'deleted' && keepMissing) {
      // 舊格式轉換時把商品搬到該團的試算表
      if (stored.legacyJson || legacyItems) {
        if (!stored.legacyJson) t.sections = readTourProducts(t, legacyItems);
        writeTourProducts(t);
      }
      ended.push(t);
      return;
    }
    if (t.status !== 'deleted') {
      if (!t.sections) t.sections = readTourProducts(t, legacyItems);
      trashTourImages(t);
      newlyEnded.push(getCatalogTourName(t));
      t.status = 'deleted';
      t.coverImages = [];
      clearProductImages(t);
    }
    ended.push(t);
  });

  tours.forEach(function(t) { writeTourInfo(writeTourProducts(t), t); });
  writeTable(ss, TOUR_SHEET, TOUR_HEADERS, tours.concat(ended).map(tourToRow), TOUR_NUMBER_COLS, TOUR_WRAP_COLS);
  writeSystemSettings(ss, (catalog && catalog.boardColumns) || {});
  // 舊版分頁轉換完成後移除
  var oldItems = ss.getSheetByName(LEGACY_ITEM_SHEET);
  if (oldItems) ss.deleteSheet(oldItems);
  _catalogMemo = null;
  return { ended: newlyEnded };
}

// ── 團務資料（TWT 代購管理表）──
function getTourSheet(ss) {
  var sheet = ss.getSheetByName(TOUR_SHEET);
  if (sheet) return sheet;
  var old = ss.getSheetByName(LEGACY_TOUR_SHEET);
  if (old) { old.setName(TOUR_SHEET); return old; }
  return null;
}

// 回傳 { tours（含已結束）, legacyJson（舊版 A1 JSON，沒有就是 null）}
function readStoredTours(ss) {
  var sheet = getTourSheet(ss);
  if (sheet) {
    var tours = [];
    readTable(sheet, TOUR_HEADER_ALIASES).forEach(function(get, i) {
      var name = cellText(get('團務名稱')).trim();
      var rawId = cellText(get('團務ID（系統用）')).trim();
      if (!name && !rawId) return;
      var status = labelToKey(STATUS_LABELS, get('狀態')) || String(get('狀態') || 'open').trim().toLowerCase();
      var progress = String(get('團務進度') || '').trim();
      var stepIdx = LOGI_STEP_LABELS.indexOf(progress);
      tours.push({
        id: rawId || ('c_row' + (i + 2)),
        type: status === 'instock' ? 'instock' : 'group',
        status: status,
        storeCategory: labelToKey(STORE_CATEGORY_LABELS, get('賣場分類')),
        name: name,
        group: cellText(get('團體')).trim(),
        coverImages: splitLines(get('封面圖')),
        description: cellText(get('開團說明')),
        paymentInfo: cellText(get('匯款說明')),
        currency: cellText(get('幣別')).trim().toUpperCase() || 'JPY',
        threshold: cellNumber(get('滿額門檻')),
        giftName: cellText(get('滿額禮名稱')).trim(),
        giftUnit: cellText(get('滿額禮單位')).trim(),
        sellLink: cellText(get('賣貨便連結')).trim(),
        cardSortNote: cellText(get('排序說明')),
        cardSortRandom: /隨機/.test(cellText(get('排序方式'))),
        cardMembers: splitLines(get('排序成員')).map(function(n) { return { name: n, random: false }; }),
        lStep: stepIdx >= 0 ? stepIdx : clampStep(progress)
      });
    });
    return { tours: tours, legacyJson: null };
  }
  var legacy = readLegacyCatalog(ss);
  return { tours: (legacy && legacy.appData && legacy.appData.tours) || [], legacyJson: legacy };
}

// 團務進度：停止收單以後才有（開團中、現貨賣場沒有）
function tourProgressLabel(t) {
  var status = String(t.status || 'open').toLowerCase();
  var showStep = status === 'closed' || status === 'sorting' || status === 'ended' || status === 'deleted';
  return showStep ? LOGI_STEP_LABELS[clampStep(t.lStep)] : '';
}

function tourToRow(t) {
  var status = String(t.status || 'open').toLowerCase();
  return [
    getCatalogTourName(t), STATUS_LABELS[status] || status, t.group || '', t.currency || '',
    Number(t.threshold || 0), t.giftName || '', t.giftUnit || '', tourProgressLabel(t),
    STORE_CATEGORY_LABELS[t.storeCategory] || '', t.sellLink || '',
    t.description || '', t.paymentInfo || '', t.cardSortNote || '',
    t.cardSortRandom ? '隨機分配' : ((t.cardMembers || []).length ? '買家排序' : ''),
    (t.cardMembers || []).map(function(m) { return typeof m === 'string' ? m : (m && m.name) || ''; }).filter(Boolean).join('\n'),
    (t.coverImages || []).join('\n'), t.id || ''
  ];
}

// 舊版格式：整份 catalog JSON 在「系統設定」A1
function readLegacyCatalog(ss) {
  var sheet = ss.getSheetByName(SETTING_SHEET);
  var a1 = sheet ? String(sheet.getRange('A1').getValue() || '') : '';
  if (a1.charAt(0) !== '{') return null;
  try { return JSON.parse(a1); } catch (e) { throw new Error('系統設定 A1 的舊版資料解析失敗：' + e.message); }
}

// ── 商品清單（各團自己的 Google Sheet）──
function tourSpreadsheet(t, create) {
  var name = getCatalogTourName(t);
  if (!name) return null;
  var id = PropertiesService.getScriptProperties().getProperty(propKeyCampaign(name));
  if (id) { try { return SpreadsheetApp.openById(id); } catch (ignore) {} }
  return create ? ensureCampaignSpreadsheet(name) : null;
}

function readTourProducts(t, legacyItems) {
  var cache = CacheService.getScriptCache();
  var key = 'prod_' + t.id;
  var hit = cache.get(key);
  if (hit) return JSON.parse(hit);
  var sections = [];
  var ss = tourSpreadsheet(t, false);
  var sheet = ss && ss.getSheetByName(PRODUCT_SHEET);
  if (sheet) sections = rowsToSections(readTable(sheet, {}));
  else if (legacyItems && legacyItems[t.id]) sections = legacyItems[t.id];
  try { cache.put(key, JSON.stringify(sections), PRODUCT_CACHE_TTL); } catch (ignore) {}
  return sections;
}

function rowsToSections(rows) {
  var sections = [], byId = {};
  rows.forEach(function(get, i) {
    var title = cellText(get('區塊')).trim();
    var secId = cellText(get('區塊ID（系統用）')).trim() || ('s_' + title);
    var sec = byId[secId];
    if (!sec) {
      sec = byId[secId] = {
        id: secId, title: title, image: cellText(get('區塊圖片')).trim(),
        defaultTwd: cellNumber(get('區塊預設台幣')), defaultOriginal: cellNumber(get('區塊預設原幣')),
        defaultWeight: cellNumber(get('區塊預設重量')), items: []
      };
      sections.push(sec);
    }
    var name = cellText(get('商品名稱')).trim();
    var itemId = cellText(get('商品ID（系統用）')).trim();
    if (!name && !itemId) return; // 只有區塊、還沒有商品
    sec.items.push({
      id: itemId || ('p_row' + (i + 2)), name: name,
      twd: cellNumber(get('台幣價')), original: cellNumber(get('原幣價')),
      image: cellText(get('商品圖片')).trim(), weight: cellNumber(get('重量(kg)'))
    });
  });
  return sections;
}

function sectionsToRows(sections) {
  var rows = [];
  (sections || []).forEach(function(s) {
    var secCols = [s.image || '', Number(s.defaultTwd || 0), Number(s.defaultOriginal || 0), Number(s.defaultWeight || 0), s.id || ''];
    var items = s.items || [];
    if (!items.length) rows.push([s.title || '', '', '', '', '', ''].concat(secCols, ['']));
    items.forEach(function(it) {
      rows.push([s.title || '', it.name || '', Number(it.twd || 0), Number(it.original || 0), Number(it.weight || 0), it.image || '']
        .concat(secCols, [it.id || '']));
    });
  });
  return rows;
}

function writeTourProducts(t) {
  var sections = t.sections || [];
  var ss = tourSpreadsheet(t, sections.length > 0);
  if (ss) writeTable(ss, PRODUCT_SHEET, PRODUCT_HEADERS, sectionsToRows(sections), PRODUCT_NUMBER_COLS, []);
  try { CacheService.getScriptCache().put('prod_' + t.id, JSON.stringify(sections), PRODUCT_CACHE_TTL); } catch (ignore) {}
  return ss;
}

// 網址是 http(s) 開頭才做成可以點的連結
function isWebLink(s) { return /^https?:\/\/\S+$/i.test(String(s || '').trim()); }

// 各團自己的 Google Sheet 裡的「團務資訊」分頁：團務名稱、賣貨便連結（沒變就不寫）
var INFO_SHEET = '團務資訊';
function writeTourInfo(ss, t) {
  if (!ss) return;
  var link = String(t.sellLink || '').trim();
  var rows = [['項目', '內容'], ['團務名稱', getCatalogTourName(t)], ['賣貨便連結', link]];
  var sheet = ss.getSheetByName(INFO_SHEET);
  if (sheet && sheet.getLastRow() >= 3 && JSON.stringify(sheet.getRange(1, 1, 3, 2).getValues()) === JSON.stringify(rows)) return;
  if (!sheet) sheet = ss.insertSheet(INFO_SHEET);
  sheet.getRange(1, 1, 3, 2).setNumberFormat('@').setValues(rows);
  sheet.getRange(1, 1, 1, 2).setFontWeight('bold').setBackground('#e5e7eb');
  sheet.getRange(2, 1, 2, 1).setFontWeight('bold');
  if (isWebLink(link)) sheet.getRange(3, 2).setRichTextValues([[SpreadsheetApp.newRichTextValue().setText(link).setLinkUrl(link).build()]]);
  sheet.autoResizeColumns(1, 2);
}

// 已結束的團：商品清單裡的圖片欄清空（商品本身保留）
function clearProductImages(t) {
  (t.sections || []).forEach(function(s) {
    s.image = '';
    (s.items || []).forEach(function(it) { it.image = ''; });
  });
  if (tourSpreadsheet(t, false)) writeTourProducts(t);
}

function trashTourImages(t) {
  collectTourImageIds([t]).forEach(function(id) { try { trashImageFile(id); } catch (ignore) {} });
}

// 舊版「商品資料」分頁（轉換前才會有）
function readLegacyItemSheet(ss) {
  var sheet = ss.getSheetByName(LEGACY_ITEM_SHEET);
  if (!sheet) return null;
  var byTour = {};
  var rowsByTour = {};
  readTable(sheet, {}).forEach(function(get) {
    var id = cellText(get('開團ID（系統用）')).trim();
    if (id) (rowsByTour[id] = rowsByTour[id] || []).push(get);
  });
  Object.keys(rowsByTour).forEach(function(id) { byTour[id] = rowsToSections(rowsByTour[id]); });
  return byTour;
}

// 本機暫存圖（data: 開頭）太大，放不進儲存格，也不該存到雲端
function assertNoLocalImages(tours) {
  tours.forEach(function(t) {
    var urls = [].concat(t.coverImages || []);
    (t.sections || []).forEach(function(s) {
      urls.push(s.image || '');
      (s.items || []).forEach(function(it) { urls.push((it && it.image) || ''); });
    });
    if (urls.some(function(u) { return String(u || '').indexOf('data:') === 0; })) {
      throw new Error('「' + getCatalogTourName(t) + '」有圖片還沒上傳到雲端（目前是本機暫存圖）。請在後台重新上傳那張圖片後再儲存。');
    }
  });
}

// ── 表格讀寫工具 ──
function splitLines(v) {
  return String(v == null ? '' : v).split(/\r?\n/).map(function(s) { return s.trim(); }).filter(Boolean);
}
function cellText(v) { return v == null ? '' : String(v); }
function cellNumber(v) { var n = Number(v); return isFinite(n) ? n : 0; }
function labelToKey(map, label) {
  label = String(label || '').trim();
  if (map.hasOwnProperty(label.toLowerCase())) return label.toLowerCase();
  for (var k in map) if (map[k] === label) return k;
  return '';
}
function clampStep(v) {
  var n = Math.round(Number(v) || 0);
  return Math.max(0, Math.min(LOGI_STEP_LABELS.length - 1, n));
}

function readTable(sheet, aliases) {
  var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return [];
  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  var head = getHeaderMap(values[0]);
  Object.keys(aliases || {}).forEach(function(name) {
    if (head[name] === undefined) aliases[name].forEach(function(a) { if (head[name] === undefined && head[a] !== undefined) head[name] = head[a]; });
  });
  return values.slice(1)
    .filter(function(r) { return r.some(function(c) { return c !== '' && c !== null; }); })
    .map(function(r) { return function(name) { var i = head[name]; return i === undefined ? '' : r[i]; }; });
}

function writeTable(ss, name, headers, rows, numberCols, wrapCols) {
  var sheet = ss.getSheetByName(name) || ss.insertSheet(name);
  var width = headers.length;
  var total = Math.max(rows.length + 1, sheet.getLastRow(), 2);
  var values = [headers.slice()].concat(rows);
  while (values.length < total) values.push(new Array(width).fill(''));
  // 文字欄設成純文字，名稱像數字或以 = 開頭時也不會被改掉或當成公式；相鄰的文字欄一次設定，數字欄保持預設格式
  for (var c = 0; c < width; c++) {
    if (numberCols.indexOf(headers[c]) >= 0) continue;
    var end = c;
    while (end + 1 < width && numberCols.indexOf(headers[end + 1]) < 0) end++;
    sheet.getRange(1, c + 1, total, end - c + 1).setNumberFormat('@');
    c = end;
  }
  sheet.getRange(1, 1, total, width).setValues(values); // 一次寫入，多出來的舊列同時清空
  sheet.getRange(1, 1, 1, width).setFontWeight('bold').setBackground('#e5e7eb');
  headers.forEach(function(h, c) {
    if (h.indexOf('（系統用）') >= 0) sheet.getRange(1, c + 1).setBackground('#f3f4f6').setFontColor('#9ca3af');
    if (wrapCols.indexOf(h) >= 0) sheet.getRange(2, c + 1, total - 1, 1).setWrap(true);
  });
  sheet.setFrozenRows(1);
  return sheet;
}

// ── 系統設定（一列一個項目，B1 = 後台密碼）──
function readSystemSettings(ss, legacy) {
  if (legacy) return legacy.boardColumns || {};
  var sheet = ss.getSheetByName(SETTING_SHEET);
  var map = {};
  if (sheet && sheet.getLastRow() >= 2) {
    sheet.getRange(1, 1, sheet.getLastRow(), 2).getValues().forEach(function(r) {
      var k = String(r[0] || '').trim();
      if (k) map[k] = r[1];
    });
  }
  var columns = {};
  BOARD_COLUMN_KEYS.forEach(function(k) {
    var v = cellText(map['看板欄位名稱・' + BOARD_COLUMN_LABELS[k]]).trim();
    if (v) columns[k] = v;
  });
  var palette = PALETTE_LABELS.map(function(l) { return cellText(map[l]).trim().toLowerCase(); });
  var uiRoles = {};
  UI_ROLE_LABELS.forEach(function(pair) {
    var v = cellText(map['介面配色・' + pair[1]]).trim();
    var m = v.match(/^(?:主題色\s*|c)([1-5])/i);
    if (m) uiRoles[pair[0]] = 'c' + m[1];
  });
  var bc = {
    columns: columns,
    groups: splitLines(map['團體']),
    storeDescription: cellText(map['賣場說明']),
    brandName: cellText(map['店名']).trim(),
    uiRoles: uiRoles,
    // 買家頁面相容用：tagColors 由介面配色推算，不另外存
    tagColors: { open: uiRoles.tagOpen || 'c1', closed: uiRoles.tagClosed || 'c2', sorting: uiRoles.tagSorting || 'c3', instock: uiRoles.tagInstock || 'c4' }
  };
  if (palette.every(function(h) { return /^#[0-9a-f]{6}$/.test(h); })) {
    bc.theme = { palette: palette, colors: { c1: palette[0], c2: palette[1], c3: palette[2], c4: palette[3], c5: palette[4] } };
  }
  return bc;
}

function writeSystemSettings(ss, bc) {
  var sheet = ss.getSheetByName(SETTING_SHEET) || ss.insertSheet(SETTING_SHEET);
  var t = bc.theme || {};
  var pal = Array.isArray(t.palette) ? t.palette : [];
  if (!pal.length && t.colors) pal = [t.colors.c1, t.colors.c2, t.colors.c3, t.colors.c4, t.colors.c5];
  var ur = bc.uiRoles || {};
  var rows = [
    ['店名', bc.brandName || ''],
    ['賣場說明', bc.storeDescription || ''],
    ['團體', (bc.groups || []).map(function(g) { return typeof g === 'string' ? g : (g && g.name) || ''; }).filter(Boolean).join('\n')],
    ['', '']
  ];
  BOARD_COLUMN_KEYS.forEach(function(k) { rows.push(['看板欄位名稱・' + BOARD_COLUMN_LABELS[k], (bc.columns || {})[k] || '']); });
  rows.push(['', '']);
  var paletteStart = rows.length + 2; // 第 2 列開始寫
  PALETTE_LABELS.forEach(function(l, i) { rows.push([l, pal[i] || '']); });
  rows.push(['', '']);
  UI_ROLE_LABELS.forEach(function(pair) {
    var v = String(ur[pair[0]] || '').match(/^c([1-5])$/);
    rows.push(['介面配色・' + pair[1], v ? '主題色 ' + v[1] : '']);
  });

  var total = Math.max(rows.length, sheet.getLastRow() - 1);
  while (rows.length < total) rows.push(['', '']);
  sheet.getRange('A1').setValue('後台密碼').setFontWeight('bold'); // B1 是密碼，不動
  sheet.getRange(2, 1, total, 2).setNumberFormat('@').setBackground(null);
  sheet.getRange(2, 1, total, 2).setValues(rows);
  sheet.getRange(1, 1, total + 1, 1).setFontWeight('bold').setBackground('#f3f4f6');
  sheet.getRange(2, 2, total, 1).setWrap(true);
  PALETTE_LABELS.forEach(function(l, i) {
    if (/^#[0-9a-f]{6}$/i.test(pal[i] || '')) sheet.getRange(paletteStart + i, 2).setBackground(pal[i]);
  });
}

