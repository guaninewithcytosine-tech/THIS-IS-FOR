// 團務索引表單：每個團的 Google Sheet 連結與訂單數字（狀態等設定看「團務資料」）
// ══════════════════════════════════════════
// 試算表ID：「訂單總覽」的程式用它找到各團的 Google Sheet
var INDEX_HEADERS = ['團務名稱', '訂單數', '訂單總額', '已付款', '未付款', '金額不符', '二補待收', '賣貨便連結', '備註', '試算表ID（系統用）'];
var INDEX_NUMBER_COUNT = 6; // 訂單數 ~ 二補待收

// 一個團在索引表單上的數字（金額不符、退款不算進已付款或未付款）
function indexNumbers(orders) {
  var s = campaignStats(orders || []);
  return [s.count, s.total, s.paid, s.unpaid, s.mismatch, s.second];
}
function groupOrdersBySheet(orders) {
  var out = {};
  (orders || []).forEach(function(o) { (out[o.spreadsheetId] = out[o.spreadsheetId] || []).push(o); });
  return out;
}
function indexStamp(sheet) {
  sheet.getRange(1, INDEX_HEADERS.length + 2).setValue('更新：' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy/MM/dd HH:mm')).setFontColor('#6b7280');
}

// 訂單有變動時，只更新那幾個團在「團務索引表單」的那一列（不用打開每個團的試算表）
// 表格還沒建好、是舊格式、或找不到那一列時，整張重建
// orders：已經讀好的訂單（可省略，省略時只讀這幾個團）
function updateCampaignIndexRows(ssIds, orders) {
  var want = {};
  (ssIds || []).forEach(function(id) { if (id) want[id] = true; });
  var ids = Object.keys(want);
  if (!ids.length) return;
  var sheet = getMainSpreadsheetOrThrow().getSheetByName(CAMPAIGN_INDEX_SHEET);
  var width = INDEX_HEADERS.length;
  if (!sheet || sheet.getLastRow() < 2 || sheet.getRange(1, 1, 1, width).getValues()[0].join('|') !== INDEX_HEADERS.join('|')) {
    refreshCampaignIndex();
    return;
  }
  var byCamp = groupOrdersBySheet(orders || getAllOrders({ onlyIds: want }));
  var props = PropertiesService.getScriptProperties().getProperties();
  var nameOf = {};
  Object.keys(props).forEach(function(k) { if (!isInternalPropKey(k)) nameOf[props[k]] = k; });
  var names = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues().map(function(r) { return String(r[0]).trim(); });
  for (var i = 0; i < ids.length; i++) {
    var row = names.indexOf(nameOf[ids[i]]);
    if (row < 0) { refreshCampaignIndex(); return; }
    sheet.getRange(row + 2, 2, 1, INDEX_NUMBER_COUNT).setValues([indexNumbers(byCamp[ids[i]])]);
  }
  indexStamp(sheet);
}
function campaignSheetIds(names) {
  var props = PropertiesService.getScriptProperties();
  return (names || []).map(function(n) { return props.getProperty(propKeyCampaign(n)); }).filter(Boolean);
}

function getIndexSheet(ss) {
  var sheet = ss.getSheetByName(CAMPAIGN_INDEX_SHEET);
  if (sheet) return sheet;
  var old = ss.getSheetByName(LEGACY_INDEX_SHEET);
  if (old) { old.setName(CAMPAIGN_INDEX_SHEET); return old; }
  return ss.insertSheet(CAMPAIGN_INDEX_SHEET);
}

// orders：要含已結束的團（getAllOrders({ includeEnded: true })）
function refreshCampaignIndex(report, orders) {
  var ss = getMainSpreadsheetOrThrow();
  var sheet = getIndexSheet(ss);
  if (!orders) orders = getAllOrders({ includeEnded: true });
  var props = PropertiesService.getScriptProperties().getProperties();

  var byCamp = groupOrdersBySheet(orders);
  var errors = {};
  ((report && report.errors) || []).forEach(function(e) { errors[e.name] = String(e.error || '').split('\n')[0].slice(0, 200); });

  // 依「團務資料」的順序列出有 Google Sheet 的團，已結束的排在後面
  var rows = [], listed = {};
  var stored = readStoredTours(ss).tours;
  stored.filter(function(t) { return t.status !== 'deleted'; }).concat(stored.filter(function(t) { return t.status === 'deleted'; }))
    .forEach(function(t) {
      var key = propKeyCampaign(getCatalogTourName(t));
      if (!key || listed[key] || !props[key]) return;
      listed[key] = true;
      rows.push({ name: key, ssId: props[key], ended: t.status === 'deleted', link: String(t.sellLink || '').trim() });
    });
  Object.keys(props).forEach(function(k) {
    if (!isInternalPropKey(k) && !listed[k]) rows.push({ name: k, ssId: props[k], ended: true });
  });

  var width = INDEX_HEADERS.length;
  sheet.clear();
  sheet.getRange(1, 1, 1, width).setValues([INDEX_HEADERS]).setFontWeight('bold').setBackground('#e5e7eb');
  indexStamp(sheet);
  if (rows.length) {
    sheet.getRange(2, 1, rows.length, width).setValues(rows.map(function(r) {
      return [''].concat(indexNumbers(byCamp[r.ssId]), [r.link || '', errors[r.name] || (r.ended ? '已結束' : ''), r.ssId]);
    }));
    // 賣貨便連結可以直接點
    var linkCol = INDEX_HEADERS.indexOf('賣貨便連結') + 1;
    sheet.getRange(2, linkCol, rows.length, 1).setNumberFormat('@');
    rows.forEach(function(r, i) {
      if (isWebLink(r.link)) sheet.getRange(i + 2, linkCol).setRichTextValues([[SpreadsheetApp.newRichTextValue().setText(r.link).setLinkUrl(r.link).build()]]);
    });
    // 團名直接連到該團的 Google Sheet
    sheet.getRange(2, 1, rows.length, 1).setRichTextValues(rows.map(function(r) {
      return [SpreadsheetApp.newRichTextValue().setText(r.name).setLinkUrl('https://docs.google.com/spreadsheets/d/' + r.ssId + '/edit').build()];
    }));
    sheet.getRange(2, 3, rows.length, 1).setNumberFormat('#,##0');
    sheet.getRange(1, width).setBackground('#f3f4f6').setFontColor('#9ca3af');
    rows.forEach(function(r, i) { if (r.ended) sheet.getRange(i + 2, 1, 1, width).setFontColor('#9ca3af'); });
  }
  sheet.setFrozenRows(1);
  sheet.autoResizeColumns(1, width);
  return { rows: rows.length };
}

// 只讀一個團（含商品），下單時用，不必打開每個團的試算表
function findActiveTour(match) {
  var ss = getMainSpreadsheetOrThrow();
  var stored = readStoredTours(ss);
  var t = stored.tours.filter(function(x) { return x.status !== 'deleted' && match(x); })[0] || null;
  if (t && !stored.legacyJson) t.sections = readTourProducts(t, readLegacyItemSheet(ss));
  return t;
}

// 網站上還在的團（後台、買家查詢只看這些團的訂單）
function activeTourNames() {
  var names = {};
  readStoredTours(getMainSpreadsheetOrThrow()).tours.forEach(function(t) {
    if (t.status !== 'deleted') names[propKeyCampaign(getCatalogTourName(t))] = true;
  });
  return names;
}
 
function ensureCampaignSheetsFromCatalog(catalog) {
  var tours = getCatalogTours(catalog);
  var report = {
    tourCount: tours.length,
    created: [],
    existing: [],
    skipped: [],
    errors: [],
    folderUrl: ''
  };
 
  try {
    report.folderUrl = getCampaignFolder().getUrl();
  } catch (e) {
    report.errors.push({ name: '__folder__', error: '建立或讀取開團資料夾失敗：' + e.message });
  }
 
  tours.forEach(function(tour) {
    var name = getCatalogTourName(tour);
    var status = String((tour && tour.status) || '').toLowerCase();
    var type = String((tour && tour.type) || '').toLowerCase();
 
    if (!name) {
      report.skipped.push({ name: '(未命名)', status: status, type: type, reason: 'missing name' });
      return;
    }
    if (!shouldCreateSheetForTour(tour)) {
      report.skipped.push({ name: name, status: status, type: type, reason: 'instock / market' });
      return;
    }
 
    try {
      var ss = ensureCampaignSpreadsheet(name);
      setupCampaignSpreadsheet(ss, tour, name);
      var item = { name: name, id: ss.getId(), url: ss.getUrl(), status: status, type: type };
      if (ss.__twtCreatedNow) report.created.push(item);
      else report.existing.push(item);
    } catch (e) {
      report.errors.push({ name: name, status: status, type: type, error: e && e.stack ? e.stack : String(e) });
    }
  });
 
  return report;
}
 
// BUG FIX: 移除 campaigns 相容路徑（死碼）。
// 前台 adminToStandard() 固定送出 appData.tours 格式，campaigns 路徑永遠不會被走到。
function getCatalogTours(catalog) {
  if (!catalog || !catalog.appData) return [];
  if (Array.isArray(catalog.appData.tours)) return catalog.appData.tours;
  return [];
}
 
function shouldCreateSheetForTour(tour) {
  if (!tour) return false;
  var status = String(tour.status || '').toLowerCase();
  var type = String(tour.type || '').toLowerCase();
  if (status === 'instock' || type === 'instock' || type === 'market' || type === 'store') return false;
  return true;
}
 
function getCatalogTourName(tour) {
  return String((tour && (tour.name || tour.title || tour.campaignName)) || '').trim();
}
 
function ensureCampaignSpreadsheet(campaignName) {
  var props = PropertiesService.getScriptProperties();
  var key = propKeyCampaign(campaignName);
  var ssId = props.getProperty(key);
  var ss;
 
  if (ssId) {
    try {
      ss = SpreadsheetApp.openById(ssId);
      ss.__twtCreatedNow = false;
      tryMoveCampaignSpreadsheetToFolder(ss.getId());
      return ss;
    } catch (ignore) {
      // 如果 property 裡的 ID 失效，下面會重新建立。
    }
  }
 
  ss = SpreadsheetApp.create(campaignName);
  ss.__twtCreatedNow = true;
  props.setProperty(key, ss.getId());
  tryMoveCampaignSpreadsheetToFolder(ss.getId());
  return ss;
}
 
function getCampaignFolder() {
  var props = PropertiesService.getScriptProperties();
  var saved = props.getProperty(CAMPAIGN_FOLDER_KEY);
  if (saved) {
    try {
      var old = DriveApp.getFolderById(saved);
      if (!old.isTrashed()) {
        if (old.getName() === LEGACY_CAMPAIGN_FOLDER_NAME) old.setName(TWT_FOLDER_NAME); // 原本的「TWT_開團表單」改名
        return old;
      }
    } catch (ignore) {}
  }
  var folder = DriveApp.createFolder(TWT_FOLDER_NAME);
  props.setProperty(CAMPAIGN_FOLDER_KEY, folder.getId());
  return folder;
}
 
function tryMoveCampaignSpreadsheetToFolder(fileId) {
  try {
    var folder = getCampaignFolder();
    var file = DriveApp.getFileById(fileId);
    file.moveTo(folder);
  } catch (ignore) {
    // 不讓移動資料夾失敗阻斷建表。沒有 Drive 權限時至少仍會在 Drive 根目錄建立檔案。
  }
}
 
function setupCampaignSpreadsheet(ss, tour, campaignName) {
  var orderSheet = ss.getSheetByName(ORDER_SHEET);
  if (!orderSheet) orderSheet = ss.insertSheet(ORDER_SHEET, 0);
  var orderHeaders = normalizeOrderSheetColumns(orderSheet);
  applyOrderTextFormats(orderSheet, getHeaderMap(orderHeaders));
 
  var itemSheet = ss.getSheetByName(ITEM_SHEET);
  if (!itemSheet) itemSheet = ss.insertSheet(ITEM_SHEET);
  ensureItemSummaryHeader(itemSheet);
  seedOrRefreshItemSummary(itemSheet, tour);
  var existingOrderSheet = ss.getSheetByName(ORDER_SHEET);
  if (existingOrderSheet && existingOrderSheet.getLastRow() > 1) {
    updateItemSummary(ss, {}, campaignName);
  }
 
  var secondSheet = ss.getSheetByName(SECOND_SHEET);
  if (!secondSheet) secondSheet = ss.insertSheet(SECOND_SHEET);
  var secondHeaders = ensureSecondHeaders(secondSheet);
  applySecondTextFormats(secondSheet, getHeaderMap(secondHeaders));
  ensureSecPayFormula(secondSheet, getHeaderMap(secondHeaders));
 
  // SpreadsheetApp.create 預設會有一張空白「工作表 1」。如果仍然是空白，就清掉。
  removeDefaultBlankSheet(ss);
}
 
function seedOrRefreshItemSummary(sheet, tour) {
  var catalogNames = getCatalogItemRows(tour || {});
  if (!catalogNames.length) return;
 
  var existing = {};
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0]) existing[String(data[i][0])] = Number(data[i][1] || 0);
  }
 
  var out = [];
  var used = {};
  catalogNames.forEach(function(name) {
    out.push([name, existing[name] != null ? existing[name] : 0]);
    used[name] = true;
  });
  Object.keys(existing).forEach(function(name) {
    if (!used[name]) out.push([name, existing[name]]);
  });
 
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, 2).clearContent();
  if (out.length) sheet.getRange(2, 1, out.length, 2).setValues(out);
}
 
