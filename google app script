  // 買家送來的金額一律不採信：用 catalog 找出開團，依商品 id 與數量在伺服器端重算。
  var tour = findOrderableTour(data.tourId || data.campaignId, data.campaignName);
  var campaignName = getCatalogTourName(tour);
  var order = buildServerOrder(tour, data);
  var orderId = makeOrderId(timestamp);

  var ss = ensureCampaignSpreadsheet(campaignName);
  if (ss.__twtCreatedNow) setupCampaignSpreadsheet(ss, tour, campaignName);

  writeOrderDetail(ss, order, timestamp, campaignName, orderId);
  updateItemSummary(ss, order, campaignName);
  writeSecondPayEntry(ss, order, orderId);
  try { updateCampaignIndexRows([ss.getId()]); } catch (ignore) {} // 索引表單的數字跟著更新；失敗也不影響下單
  return jsonResponse({ ok: true, status: 'success', orderId: orderId });
}

function findOrderableTour(tourId, campaignName) {
  tourId = String(tourId || '').trim();
  campaignName = String(campaignName || '').trim();
  var tour = findActiveTour(function(t) {
    return tourId ? String(t.id || '').trim() === tourId : (campaignName && getCatalogTourName(t) === campaignName);
  });
  if (!tour) throw new Error('找不到這個開團，請重新整理頁面');
  if (String(tour.status || 'open').toLowerCase() !== 'open') throw new Error('這個開團已停止收單');
  if (!getCatalogTourName(tour)) throw new Error('開團缺少名稱');
  return tour;
}

function cleanText(v, maxLen) {
  return String(v == null ? '' : v).trim().slice(0, maxLen);
}

// 依 catalog 價格建立訂單內容；明細格式與買家頁面一致：「【區塊】 商品 xN」。
function buildServerOrder(tour, data) {
  var items = Array.isArray(data.items) ? data.items : [];
  if (!items.length) throw new Error('購物車是空的，請重新整理頁面後再下單');
  var lines = [], total = 0, original = 0;
  items.forEach(function(it) {
    var qty = Number(it && it.qty);
    if (!(qty >= 1 && qty <= 999 && Math.floor(qty) === qty)) throw new Error('商品數量不正確');
    var sec = (tour.sections || []).filter(function(s) { return String(s.id) === String(it.sectionId); })[0];
    var item = sec && (sec.items || []).filter(function(x) { return String(x.id) === String(it.itemId); })[0];
    if (!item) throw new Error('商品已變更，請重新整理頁面');
    total += (Number(item.twd) || 0) * qty;
    original += (Number(item.original) || 0) * qty;
    lines.push((sec.title ? '【' + sec.title + '】 ' : '') + item.name + ' x' + qty);
  });

  var socialName = cleanText(data.socialName, 100);
  var phone = String(data.phone || '').replace(/\D/g, '');
  var bank5 = String(data.bank5 || '').replace(/\D/g, '');
  var remit = Number(String(data.remitAmount || '').replace(/[^\d.]/g, ''));
  if (!socialName) throw new Error('請填寫社群帳號');
  if (phone.length < 8 || phone.length > 15) throw new Error('手機號碼格式不正確');
  if (bank5.length !== 5) throw new Error('匯款後五碼需為 5 位數字');
  if (!(remit > 0)) throw new Error('請填寫正確的匯款金額');

  var threshold = Number(tour.threshold || 0);
  var cardCount = threshold > 0 ? Math.floor(original / threshold) : 0;
  var cardSort = '', cardSortMode = '';
  if (cardCount > 0) {
    // 後台設定隨機分配時，不論買家送什麼都記為隨機
    if (tour.cardSortRandom || isRandomCardSortText(data.cardSortMode)) {
      cardSortMode = '隨機分配';
    } else {
      // 只保留這個團真的有的成員名稱
      var memberNames = (tour.cardMembers || []).map(function(m) { return String((m && m.name) || ''); });
      cardSort = String(data.cardSort || '').split('>').map(function(s) { return s.trim(); })
        .filter(function(s) { return memberNames.indexOf(s) >= 0; }).join(' > ');
      if (cardSort) cardSortMode = '自選排序';
    }
  }

  return {
    socialName: socialName,
    socialLink: cleanText(data.socialLink, 300),
    phone: phone,
    email: cleanText(data.email, 200),
    orderDetails: lines.join('\n'),
    totalAmount: total,
    originalAmount: original,
    remitAmount: remit,
    bank5: bank5,
    remark: cleanText(data.remark, 1000),
    cardCount: cardCount,
    cardSort: cardSort,
    cardSortMode: cardSortMode,
    priorityData: buildPriorityDataText(cardSort, cardSortMode, cardCount),
    payStatus: 'pending'
  };
}

function writeOrderDetail(ss, data, timestamp, campaignName, orderId) {
  var sheet = ss.getSheetByName(ORDER_SHEET);
