function parseOrderItemsFromDetails(details) {
  var out = [];
  String(details || '').split(/\r?\n/).forEach(function(line) {
    line = String(line || '').trim();
    if (!line) return;
    if (line.indexOf('📝') === 0 || line.indexOf('【滿額卡排序】') === 0 || line.indexOf('🎲') === 0) return;
    if (/滿額卡/i.test(line) || line.indexOf('張 |') >= 0) return;
    var m = line.match(/^(.+?)\s*x\s*(\d+)\s*$/i);
    if (!m) return;
    var name = String(m[1] || '').trim();
    var qty = parseInt(m[2], 10) || 0;
    if (name && qty > 0) out.push({ name: name, qty: qty });
  });
  return out;
}
 
function canonicalizeOrderItemName(rawName, catalogItems) {
  rawName = String(rawName || '').trim();
  var rawNorm = normalizeItemText(rawName);
  if (!rawNorm) return rawName;
 
  for (var i = 0; i < catalogItems.length; i++) {
    if (catalogItems[i].normFull === rawNorm || normalizeItemText(catalogItems[i].key) === rawNorm) return catalogItems[i].key;
  }
 
  // 前台常見格式：區塊 · 商品、區塊 - 商品。轉成 catalog 中的「【區塊】 商品」。
  var best = null;
  for (var j = 0; j < catalogItems.length; j++) {
    var it = catalogItems[j];
    if (it.normSection && it.normName && rawNorm === normalizeItemText(it.normSection + ' ' + it.normName)) return it.key;
    if (it.normSection && it.normName && rawNorm.indexOf(it.normSection) >= 0 && rawNorm.indexOf(it.normName) >= 0) {
      best = best || it;
    }
  }
  if (best) return best.key;
 
  // 如果訂單明細只剩商品名，且 catalog 內沒有重名，就可對應。
  var sameName = catalogItems.filter(function(it) { return it.normName === rawNorm; });
  if (sameName.length === 1) return sameName[0].key;
 
  return rawName;
}
 
