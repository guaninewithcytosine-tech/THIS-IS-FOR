// ── updateSecondPaymentLogic ──
function updateSecondPaymentLogic(campaignName, orderId, weight, intlShipping, packagingFee, bank5, secondPayStatus) {
  campaignName = propKeyCampaign(campaignName);
  var ssId = PropertiesService.getScriptProperties().getProperty(campaignName);
  if (!ssId) return;
  var ss = SpreadsheetApp.openById(ssId);
  var orderSheet = ss.getSheetByName(ORDER_SHEET);
  var secSheet = ss.getSheetByName(SECOND_SHEET);
  if (!secSheet) return;
 
  var secHeaders = ensureSecondHeaders(secSheet);
  var secHMap = getHeaderMap(secHeaders);
  ensureSecPayFormula(secSheet, secHMap);
 
  var targetPhone = null;
  if ((!orderId || secHMap['訂單編號'] === undefined) && orderSheet) {
    var orderRows = orderSheet.getDataRange().getValues();
    var oM = getHeaderMap(orderRows[0]);
    var b = String(bank5 || '').replace(/\D/g, '').slice(-5);
    for (var i = 1; i < orderRows.length; i++) {
      var rb = String(getVal(orderRows[i], oM, '匯款後五碼')).replace(/\D/g, '').slice(-5);
      if (b && rb === b) {
        targetPhone = String(getVal(orderRows[i], oM, '手機號碼')).replace(/\D/g, '');
        break;
      }
    }
  }
 
  var secRows = secSheet.getDataRange().getValues();
  var idCol = secHMap['訂單編號'];
  for (var j = 1; j < secRows.length; j++) {
    var idMatch = orderId && idCol !== undefined && String(secRows[j][idCol] || '') === String(orderId);
    var phoneMatch = !idMatch && targetPhone && String(secRows[j][1] || '').replace(/\D/g, '') === targetPhone;
    if (idMatch || phoneMatch) {
      var r = j + 1;
      if (secHMap['商品重量(kg)'] !== undefined) secSheet.getRange(r, secHMap['商品重量(kg)'] + 1).setValue(weight);
      if (secHMap['國際運費分攤'] !== undefined) secSheet.getRange(r, secHMap['國際運費分攤'] + 1).setValue(intlShipping);
      if (secHMap['包材費'] !== undefined) secSheet.getRange(r, secHMap['包材費'] + 1).setValue(packagingFee);
      if (secHMap['二補收款狀態'] !== undefined) secSheet.getRange(r, secHMap['二補收款狀態'] + 1).setValue(normalizeSecondStatus(secondPayStatus));
      break;
    }
  }
}
 
function ensureSecPayFormula(secSheet, hMap) {
  var spCol = hMap[SECOND_TOTAL_HEADER];
  var intlCol = hMap['國際運費分攤'];
  var packCol = hMap['包材費'];
  if (spCol === undefined || intlCol === undefined || packCol === undefined) return;
  var intlLetter = colToLetter(intlCol);
  var packLetter = colToLetter(packCol);
  var maxRows = secSheet.getMaxRows();
  if (maxRows > 1) secSheet.getRange(2, spCol + 1, maxRows - 1).clearContent();
  secSheet.getRange(1, spCol + 1).setFormula(
    '={"' + SECOND_TOTAL_HEADER + '"; ARRAYFORMULA(IF(A2:A="", "", IFERROR(' + intlLetter + '2:' + intlLetter + '*1, 0) + IFERROR(' + packLetter + '2:' + packLetter + '*1, 0)))}'
  );
}
 
