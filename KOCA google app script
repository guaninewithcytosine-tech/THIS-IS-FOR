    if (m) { label = m[1].trim(); val = m[2]; }
    else if (i + 1 < end && !isValue(label) && isValue(lines[i + 1])) { val = lines[++i]; }
    else continue;
    if (/訂單金額/.test(label)) continue;
    var amt = Math.abs(emailMoney(val) || 0);
    out.text.push(label + ' ' + val.replace(/\s+/g, ''));
