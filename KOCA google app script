// 讀新的通知信。第一次（或讀信規則改了之後）讀全部的信；之後從上次讀到的地方往前多看兩天
function scanMail(ss, er, budgetMs) {
  var started = Date.now();
  var sp = PropertiesService.getUserProperties(); // 每個帳號各自讀自己的信箱
  var fresh = sp.getProperty(KEY_PARSER) !== PARSER_VERSION;
  var since = fresh ? 0 : Number(sp.getProperty(KEY_SINCE) || 0);
  if (!since) fresh = true;
  var after = fresh ? 0 : Math.max(0, since - OVERLAP_SEC);
  var seen = fresh ? {} : loadChunked(KEY_SEEN, sp);
  var threads = [];
  for (var start = 0; start < 5000; start += 100) {
    var batch = GmailApp.search(MAIL_QUERY + (after ? ' after:' + after : ''), start, 100);
    threads = threads.concat(batch);
    if (batch.length < 100) break;
  }
  er.fresh = fresh;
  er.found = threads.length;
  var items = [];
  if (threads.length) {
    GmailApp.getMessagesForThreads(threads).forEach(function(list) {
      list.forEach(function(m) {
        var sec = Math.floor(m.getDate().getTime() / 1000);
        if (sec >= after && !seen[m.getId()]) items.push({ msg: m, sec: sec });
      });
