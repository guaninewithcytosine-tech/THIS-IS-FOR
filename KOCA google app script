  var isValue = function(l) { return new RegExp('^(?:' + VALUE + ')$', 'i').test(l); };
  var end = e < 0 ? Math.min(lines.length, s + 20) : e;
  for (var i = s + 1; i < end; i++) {
    var label = lines[i], val;
    var m = label.match(new RegExp('^(.+?)\\s*[:：]\\s*(' + VALUE + ')$', 'i')) ||
