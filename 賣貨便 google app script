// 設定 Notion，設定好就同步一次
function notionSetup() {
  var ui = SpreadsheetApp.getUi(), c = channel();
  var props = PropertiesService.getScriptProperties();
  var oldToken = props.getProperty(NOTION_TOKEN_KEY), oldRoot = props.getProperty(NOTION_ROOT_KEY);
  var r1 = ui.prompt(c.name + '：設定 Notion（1/2）', '貼上 Notion 連接的存取權杖（開發人員工具 → 連接 → 你建立的連接 → 設定／Configuration）' +
    (oldToken ? '\n已經設定過的話可以留空，沿用之前的權杖。' : ''), ui.ButtonSet.OK_CANCEL);
  if (r1.getSelectedButton() !== ui.Button.OK) return;
  var token = String(r1.getResponseText() || '').trim() || oldToken;
  if (!token) return ui.alert('沒有輸入存取權杖');
  var r2 = ui.prompt(c.name + '：設定 Notion（2/2）', '貼上要放「' + c.title + '」的 Notion 頁面連結（這個頁面要先在右上角「⋯ → 連接」加入你建立的連接；TWT 代購、KOCA 也放在同一個頁面）。' +
    '\n之前已經在這個頁面建立的「' + c.title + '」會直接沿用。' + (oldRoot ? '\n留空就用之前的頁面。' : ''), ui.ButtonSet.OK_CANCEL);
  if (r2.getSelectedButton() !== ui.Button.OK) return;
  var linkText = String(r2.getResponseText() || '').trim();
  var rootId = linkText ? extractNotionId(linkText) : oldRoot || '';
  if (!rootId) return ui.alert('看不出這是 Notion 頁面連結，請在 Notion 頁面按「分享 → 複製連結」再貼上');
  props.setProperty(NOTION_TOKEN_KEY, token);
  try {
    notionFetch('get', 'pages/' + rootId); // 先確認頁面已經加入連接
  } catch (e) {
    if (oldToken) props.setProperty(NOTION_TOKEN_KEY, oldToken); else props.deleteProperty(NOTION_TOKEN_KEY);
    return ui.alert('設定失敗：' + e.message);
  }
  props.setProperty(NOTION_ROOT_KEY, rootId);
  if (oldRoot && oldRoot !== rootId) saveChunked(c.notionKey, {}); // 換了頁面：在新的頁面重新建
  ui.alert(c.name + '：Notion 設定完成', notionSyncOnce(), ui.ButtonSet.OK);
}
function notionSyncNow() { return notify(channel().name + '：同步到 Notion', notionSyncOnce()); }

// 同步一次；回傳要給你看的文字
function notionSyncOnce() {
  var sp = PropertiesService.getScriptProperties(), c = channel();
  var root = sp.getProperty(NOTION_ROOT_KEY);
  if (!sp.getProperty(NOTION_TOKEN_KEY) || !root) return '還沒設定 Notion：請先按「' + c.name + ' → 設定 Notion（選用）」。';
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return '正在讀信或同步中，請過 1～2 分鐘再按一次。';
  var report = { created: 0, updated: 0, pulled: 0, errors: [], pending: false };
  try {
    var text = syncChannel(c, SpreadsheetApp.getActiveSpreadsheet(), { root: root }, report, Date.now());
    return 'Notion「' + c.emoji + ' ' + c.title + '」：' + text + '。' +
      (report.viewsFailed ? '\n（有些表格的欄位順序沒有設定成功，可以在 Notion 自己拖曳調整；資料同步不受影響）' : '') +
      (report.errors.length ? '\n\n有 ' + report.errors.length + ' 筆沒同步成功：' + report.errors[0] : '') +
      (report.pending ? '\n\n資料比較多，還沒同步完：再按一次會接著做。' : '') +
      '\n\n要更新「訂單總覽」：到 Google Sheet「訂單總覽」按「訂單總覽 → 更新全部」。';
  } catch (e) {
    return 'Notion 同步失敗：' + e.message;
  } finally {
    lock.releaseLock();
  }
}

// 這個檔案的訂單同步到 Notion；回傳要給你看的文字
function syncChannel(c, ss, pages, report, started) {
  if (!ss.getSheetByName(ORDER_TAB)) throw new Error('這個檔案裡沒有「' + ORDER_TAB + '」分頁：請先按「' + c.name + ' → 讀取通知信」');
  var ext = channelPage(c, pages);
  try {
    var rows = readRows(ss, ORDER_TAB, c.headers);
    if (!notionSyncChannelRows(c, ss, ext, rows, report, started)) { report.pending = true; }
    else {
      notionUpdateCallout(ext, 'sum', c.summary(c, rows, [], ss.getUrl()));
    }
  } finally {
    saveChunked(c.notionKey, ext);
  }
  return '新增 ' + report.created + ' 筆、更新 ' + report.updated + ' 筆' +
    (report.pulled ? '；把 Notion 改的 ' + report.pulled + ' 筆狀態寫回這個檔案' : '');
}

// 看這個帳號的信箱裡有沒有賣貨便寄來的信（不寫入任何資料）
function checkMailbox() {
  var title = '賣貨便：檢查這個帳號的信箱';
  var threads = [];
  try {
    for (var start = 0; start < 5000; start += 100) {
      var batch = GmailApp.search(MAIL_QUERY, start, 100);
      threads = threads.concat(batch);
      if (batch.length < 100) break;
    }
  } catch (e) {
    return notify(title, '讀取失敗：' + e.message);
  }
  var lines = ['帳號：' + (me() || '（看不到，可能還沒授權）')];
  if (!threads.length) {
    lines.push('這個信箱裡找不到寄件人含 sp88.com 或 7-11.com.tw 的信。',
      '請確認上面的帳號是不是要讀的那個；如果不是，用那個帳號打開這個檔案（建議開無痕視窗、只登入那個帳號）再按一次。');
  } else {
    lines.push('寄件人含 sp88.com 或 7-11.com.tw 的信：' + threads.length + ' 個對話', '最新的幾封：');
    threads.slice(0, 5).forEach(function(t) { lines.push('・' + fmtTime(t.getLastMessageDate()) + '　' + t.getFirstMessageSubject()); });
    lines.push('最舊的一封：' + fmtTime(threads[threads.length - 1].getLastMessageDate()));
  }
  return notify(title, lines.join('\n'));
}
