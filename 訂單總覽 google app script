// 這個檔案裡的分頁：把三個平台的訂單統整過來
// 只放統計（不算平台之間的合計），每次更新整張重寫
// ══════════════════════════════════════════
// 寫一個分頁（整張重寫）：由幾個區塊從上往下排，區塊中間空一行
// 文字區塊：{ text: ['第一行（粗體）', '第二行', …] }；表格區塊：{ headers, rows, numbers: [數字欄], wrap: [自動換行的欄] }
// 文字欄設成純文字（訂單編號、日期不會被改成數字或日期），數字欄保持數字
function writeBlocks(book, name, blocks) {
  var sheet = book.getSheetByName(name) || book.insertSheet(name);
  sheet.clear();
  var row = 1;
  blocks.forEach(function(b) {
    if (b.text) {
      sheet.getRange(row, 1, b.text.length, 1).setNumberFormat('@').setValues(b.text.map(function(t) { return [t]; }));
      sheet.getRange(row, 1).setFontWeight('bold').setFontSize(14);
      row += b.text.length + 1;
      return;
    }
    var numbers = b.numbers || [], wrap = b.wrap || [], width = b.headers.length, count = b.rows.length + 1;
    for (var c = 0; c < width; c++) {
      var end = c, isNum = numbers.indexOf(b.headers[c]) >= 0;
      while (end + 1 < width && (numbers.indexOf(b.headers[end + 1]) >= 0) === isNum) end++;
      sheet.getRange(row, c + 1, count, end - c + 1).setNumberFormat(isNum ? '#,##0' : '@');
      c = end;
    }
    sheet.getRange(row, 1, count, width).setValues([b.headers.slice()].concat(b.rows));
    sheet.getRange(row, 1, 1, width).setFontWeight('bold').setBackground('#e5e7eb');
    b.headers.forEach(function(h, c) { if (wrap.indexOf(h) >= 0 && b.rows.length) sheet.getRange(row + 1, c + 1, b.rows.length, 1).setWrap(true); });
    row += count + 1;
  });
  return sheet;
}
// 之前版本的分頁（程式建立的才移除）
function dropOldTabs(book) {
  Object.keys(OLD_TABS).forEach(function(name) {
    var old = book.getSheetByName(name);
    if (!old || book.getSheets().length < 2 || old.getLastColumn() < 1) return;
    if (String(old.getRange(1, 1).getValue()).trim() === OLD_TABS[name]) book.deleteSheet(old);
  });
}
function isTwtActive(c) { return c.status !== 'deleted'; }
// 更新這個檔案裡一個平台的分頁和總覽用的數字；回傳要給你看的文字
function mirrorPlatform(id, src, report) {
  var book = SpreadsheetApp.getActiveSpreadsheet();
  return id === 'twt' ? mirrorTwt(src, book, report) : mirrorChannel(channelById(id), src, book);
}
// TWT 代購：一頁，只有統計：每個團一列（進行中的團排在前面）。每一筆訂單的細節在 TWT 代購管理表和各團的 Google Sheet
function mirrorTwt(src, book, report) {
  var camps = readTwtCampaigns(src);
  camps = camps.filter(isTwtActive).concat(camps.filter(function(c) { return !isTwtActive(c); }));
  var all = [], liveCount = 0, orderCount = 0, total = { count: 0, total: 0, paid: 0, unpaid: 0, mismatch: 0, second: 0 }, shown = 0;
  camps.forEach(function(c) {
    var orders;
    try { orders = readCampaignOrders(c.ssId); }
    catch (e) { report.errors.push(c.name + '：' + e.message); return; }
    var st = campaignStats(orders);
    all.push([c.name, STATUS_LABELS[c.status] || c.status, st.count, st.total, st.paid, st.unpaid, st.mismatch, st.second]);
    if (isTwtActive(c)) {
      liveCount++;
      Object.keys(total).forEach(function(k) { total[k] += st[k]; });
    }
    orderCount += st.count;
    shown++;
  });
  total.campCount = liveCount;
  writeBlocks(book, TAB_TWT, [
    { text: ['TWT 代購', '這一頁只有統計。每一筆訂單的細節在「TWT 代購管理表」和各團自己的 Google Sheet。',
      '進行中 ' + liveCount + ' 團・訂單 ' + total.count + ' 筆・總額 ' + fmtMoney(total.total) + '・已付款 ' + total.paid + '・未付款 ' + total.unpaid +
      (total.mismatch ? '・金額不符 ' + total.mismatch : '') + (total.second ? '・二補待收 ' + total.second : '')] },
    { headers: ['團務', '狀態', '訂單數', '訂單總額', '已付款', '未付款', '金額不符', '二補待收'], rows: all, numbers: ['訂單數', '訂單總額', '已付款', '未付款', '金額不符', '二補待收'] }
  ]);
  dropOldTabs(book);
  saveStats('twt', total);
  return orderCount + ' 筆訂單（' + shown + ' 個團）';
}
// 賣貨便、KOCA：各一頁，只有統計：各狀態的筆數和金額（KOCA 還有平台服務費、金流服務費、進帳、提領）。每一筆訂單的細節在它們自己的 Google Sheet
function mirrorChannel(c, src, book) {
  if (!src.getSheetByName(ORDER_TAB)) throw new Error('「' + c.file + '」裡沒有「' + ORDER_TAB + '」分頁：請先在那個檔案按「' + c.name + ' → 讀取通知信」');
  var rows = readRows(src, ORDER_TAB, c.headers), payouts = c.payouts ? readRows(src, PAYOUT_TAB, KOCA_PAYOUT_HEADERS) : [];
  var st = channelStats(c, rows, payouts), money = c.payouts ? '總金額' : '商品金額';
  var statusRows = [], seen = {};
  c.options.map(function(o) { return o.name; }).concat(Object.keys(st.status)).forEach(function(name) {
    if (seen[name] || !st.status[name]) return;
    seen[name] = true;
    statusRows.push([name, st.status[name], emailSum(rows.filter(function(r) { return (String(r['狀態'] || '').trim() || '未知') === name; }), money)]);
  });
  var blocks = [{ text: [c.name, '這一頁只有統計。每一筆訂單的細節在「' + c.file + '」。',
    c.payouts ? '共 ' + st.count + ' 筆・已完成的進帳 ' + fmtMoney(st.income) + '・已提領入帳 ' + fmtMoney(st.payout)
      : '共 ' + st.count + ' 筆・商品金額 ' + fmtMoney(st.total) + '（不含運費、已取消、退貨）'] },
    { headers: ['狀態', '筆數', money], rows: statusRows, numbers: ['筆數', money] }];
  if (c.payouts) {
    blocks.push({ headers: ['KOCA 費用', '筆數', '總金額', '運費', '平台服務費', '金流服務費', '其他扣款', '進帳金額'],
      rows: [['已完成的訂單', st.done.count, st.done.total, st.done.shipping, st.done.platform, st.done.payment, st.done.other, st.done.income],
        ['還沒完成的訂單（完成後才知道實際扣多少）', st.open.count, st.open.total, '', '', '', '', '']],
      numbers: ['筆數', '總金額', '運費', '平台服務費', '金流服務費', '其他扣款', '進帳金額'] });
    blocks.push({ headers: ['KOCA 提領', '次數', '提領金額', '提領手續費', '入帳金額'],
      rows: [['已入帳', st.payouts.count, st.payouts.amount, st.payouts.fee, st.payouts.net]], numbers: ['次數', '提領金額', '提領手續費', '入帳金額'] });
  }
  writeBlocks(book, pageName(c.id), blocks);
  dropOldTabs(book);
  saveStats(c.id, { count: st.count, status: st.status, total: st.total, shipping: st.shipping, income: st.income, payout: st.payout });
  return rows.length + ' 筆訂單' + (c.payouts ? '、' + payouts.length + ' 筆提領' : '');
}
// 「總覽」：三個平台並排的簡單比較（沒有把平台加在一起的合計），細節在各平台自己的分頁
function summaryRows(stats) {
  var t = stats.twt, m = stats.myship, k = stats.koca;
  var at = function(x) { return x ? x.at.slice(5) : '還沒更新'; };
  return [
    ['TWT 代購', t ? t.count : '', t ? '訂單總額 ' + fmtMoney(t.total) : '', at(t),
      t ? '進行中 ' + t.campCount + ' 團・已付款 ' + t.paid + '・未付款 ' + t.unpaid + (t.mismatch ? '・金額不符 ' + t.mismatch : '') + (t.second ? '・二補待收 ' + t.second : '') : ''],
    ['賣貨便', m ? m.count : '', m ? '商品金額 ' + fmtMoney(m.total) : '', at(m), m ? statusLine(m.status, MYSHIP_STATUS_OPTIONS) : ''],
    ['KOCA', k ? k.count : '', k ? '進帳 ' + fmtMoney(k.income) : '', at(k),
      k ? statusLine(k.status, KOCA_STATUS_OPTIONS) + (k.payout ? '・已提領入帳 ' + fmtMoney(k.payout) : '') : '']
  ];
}
function writeSummary() {
  var book = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = writeBlocks(book, TAB_SUMMARY, [
    { text: ['訂單總覽', '三個平台各自計算，不會混在一起。這個檔案只放統計，各平台有自己的一頁（TWT 代購、賣貨便、KOCA）；每一筆訂單的細節留在各平台自己的 Google Sheet。每次更新整張重寫，要修改請到各平台的 Google Sheet。'] },
    { headers: ['平台', '訂單數', '金額', '最後更新', '狀態'], rows: summaryRows(loadStats()), numbers: ['訂單數'] }
  ]);
  if (book.getSheets()[0].getName() !== TAB_SUMMARY) { try { book.setActiveSheet(sheet); book.moveActiveSheet(1); } catch (ignore) {} } // 排在最前面
  sheet.setColumnWidth(1, 160);
  sheet.setColumnWidth(3, 170);
}

// ══════════════════════════════════════════
// 讀 TWT 代購管理表：團務資料、團務索引表單，和各團 Google Sheet 的訂單明細、匯率與二補
// ══════════════════════════════════════════
function payLabel(v) {
  var s = String(v || '').trim();
  if (s === 'paid' || s === '已付款') return '已付款';
  if (!s || s === 'pending' || s === '未付款' || s === '未收款') return '未付款';
  return s;
}
function normalizeSecondStatus(s) {
  s = String(s || '').trim();
  if (!s || s === '未通知' || s === 'pending' || s === '未付款' || s === '未收款') return '未收款';
  if (s === 'paid' || s === '已付款' || s === '已收款') return '已收款';
  return s;
}
function safeIsoTime(v) {
  if (!v) return '';
  var d = v instanceof Date ? v : new Date(v);
  return isNaN(d.getTime()) ? '' : d.toISOString();
}
// TWT 代購管理表裡的團（含已結束的團）：[{ ssId, name, status, group, progress, sellLink }]
function readTwtCampaigns(ss) {
  var tourSheet = ss.getSheetByName(TWT_TOUR_SHEET), index = ss.getSheetByName(TWT_INDEX_SHEET);
  if (!tourSheet) throw new Error('TWT 代購管理表裡找不到「' + TWT_TOUR_SHEET + '」分頁');
  var head = index && index.getLastColumn() ? getHeaderMap(index.getRange(1, 1, 1, index.getLastColumn()).getValues()[0]) : {};
  if (head[TWT_INDEX_ID] === undefined) {
    throw new Error('TWT 代購管理表的「' + TWT_INDEX_SHEET + '」還沒有各團的試算表ID：請先更新 TWT 代購管理表的程式，再按「TWT 代購 → 整理系統設定」');
  }
  var idByName = {};
  readTable(index).forEach(function(get) {
    var name = cellText(get('團務名稱')).trim(), id = cellText(get(TWT_INDEX_ID)).trim();
    if (name && id) idByName[name] = id;
  });
  var camps = [], seen = {};
  readTable(tourSheet).forEach(function(get) {
    var name = cellText(get('團務名稱') || get('開團名稱')).trim(), id = idByName[name];
    if (!name || !id || seen[id]) return;
    seen[id] = true;
    var rawStatus = String(get('狀態') || 'open').trim();
    camps.push({ ssId: id, name: name, status: labelToKey(STATUS_LABELS, rawStatus) || rawStatus.toLowerCase(),
      group: cellText(get('團體')).trim(), progress: cellText(get('團務進度')).trim(), sellLink: cellText(get('賣貨便連結')).trim() });
  });
  return camps;
}
// 一個團的訂單（含二補）
function readCampaignOrders(ssId) {
  var ss = SpreadsheetApp.openById(ssId);
  var sheet = ss.getSheetByName(TWT_ORDER_SHEET);
  if (!sheet) return [];
  var second = {}, secondByPhone = {};
  var sec = ss.getSheetByName(TWT_SECOND_SHEET);
  if (sec) {
    readTable(sec).forEach(function(get) {
      var info = { weight: get('商品重量(kg)'), intlShipping: get('國際運費分攤'), packagingFee: get('包材費'),
        secondPayment: get(TWT_SECOND_TOTAL), secondPayStatus: get('二補收款狀態') };
      var id = cellText(get('訂單編號')), phone = cellText(get('手機號碼')).replace(/\D/g, '');
      if (id) second[id] = info;
      if (phone) secondByPhone[phone] = info;
    });
  }
  return readTable(sheet).map(function(get) {
    var orderId = cellText(get('訂單編號')).trim(), phone = cellText(get('手機號碼')).replace(/\D/g, '');
    var s = (orderId && second[orderId]) || secondByPhone[phone] || {};
    return {
      spreadsheetId: ssId, orderId: orderId, phone: phone,
      timestamp: safeIsoTime(get('時間戳記')),
      socialName: cellText(get('社群帳號')),
      orderDetails: cellText(get('訂單明細')),
      totalAmount: Number(get('系統總計金額')) || 0,
      remitAmount: Number(get('買家匯款金額')) || 0,
      bank5: cellText(get('匯款後五碼')).replace(/\D/g, '').slice(-5),
      payStatus: cellText(get('付款狀態')) || 'pending',
      weight: s.weight, intlShipping: s.intlShipping, packagingFee: s.packagingFee,
      secondPayment: s.secondPayment, secondPayStatus: normalizeSecondStatus(s.secondPayStatus)
    };
  });
}
// 金額不符、退款各自分開，不算進已付款或未付款
function campaignStats(orders) {
  var s = { count: 0, total: 0, paid: 0, unpaid: 0, mismatch: 0, refund: 0, second: 0, secondPaid: 0 };
  orders.forEach(function(o) {
    var pay = payLabel(o.payStatus);
    s.count++;
    s.total += Number(o.totalAmount) || 0;
    if (pay === '已付款') s.paid++;
    else if (pay === '金額不符') s.mismatch++;
    else if (pay === '退款') s.refund++;
    else s.unpaid++;
    if ((Number(o.secondPayment) || 0) > 0) {
      if (normalizeSecondStatus(o.secondPayStatus) === '已收款') s.secondPaid++; else s.second++;
    }
  });
  return s;
}

// ══════════════════════════════════════════
// 賣貨便、KOCA：讀它們自己的 Google Sheet 算出總覽用的數字
// ══════════════════════════════════════════
function channelById(id) { return channels().filter(function(c) { return c.id === id; })[0]; }
function countStatus(rows) {
  var count = {};
  rows.forEach(function(r) { var s = String(r['狀態'] || '').trim() || '未知'; count[s] = (count[s] || 0) + 1; });
  return count;
}
function emailSum(rows, col) { return rows.reduce(function(t, r) { return t + (Number(r[col]) || 0); }, 0); }
function channelStats(c, rows, payouts) {
  var live = rows.filter(function(r) { return !/取消|退/.test(String(r['狀態'] || '')); });
  var s = { count: rows.length, status: countStatus(rows), total: emailSum(live, c.payouts ? '總金額' : '商品金額'), shipping: emailSum(live, '運費'),
    income: emailSum(rows, '進帳金額'), payout: emailSum(payouts, '入帳金額') };
  if (c.payouts) {
    var done = rows.filter(function(r) { return extNum(r['進帳金額']) != null; });
    var open = live.filter(function(r) { return extNum(r['進帳金額']) == null; });
    s.done = { count: done.length, total: emailSum(done, '總金額'), shipping: emailSum(done, '運費'), platform: emailSum(done, '平台服務費'),
      payment: emailSum(done, '金流服務費'), other: emailSum(done, '其他扣款'), income: emailSum(done, '進帳金額') };
    s.open = { count: open.length, total: emailSum(open, '總金額') };
    s.payouts = { count: payouts.length, amount: emailSum(payouts, '提領金額'), net: emailSum(payouts, '入帳金額'), fee: emailSum(payouts, '提領手續費') };
  }
  return s;
}
