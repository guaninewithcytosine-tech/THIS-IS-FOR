function notify(title, msg) {
  try { SpreadsheetApp.getUi().alert(title, msg, SpreadsheetApp.getUi().ButtonSet.OK); return msg; } catch (ignore) {}
  try { SpreadsheetApp.getActiveSpreadsheet().toast(msg, title, 10); } catch (ignore) {} // 從 Apps Script 編輯器執行時沒有對話框
  console.log(title + '：' + msg);
  return msg;
}

// 設定 Notion（選用）：只用來在你指定的頁面最上面放「三個平台總覽」
function setupNow() {
  var ui = SpreadsheetApp.getUi();
  var props = PropertiesService.getScriptProperties();
  var oldToken = props.getProperty(NOTION_TOKEN_KEY), oldPages = loadJson(NOTION_PAGES_KEY);
  var r1 = ui.prompt('設定 Notion（1/2）', '貼上 Notion 連接的存取權杖（開發人員工具 → 連接 → 你建立的連接 → 設定／Configuration）' +
    (oldToken ? '\n已經設定過的話可以留空，沿用之前的權杖。' : ''), ui.ButtonSet.OK_CANCEL);
  if (r1.getSelectedButton() !== ui.Button.OK) return;
  var token = String(r1.getResponseText() || '').trim() || oldToken;
  if (!token) return ui.alert('沒有輸入存取權杖');
  var r2 = ui.prompt('設定 Notion（2/2）', '貼上要放總覽的 Notion 頁面連結（這個頁面要先在右上角「⋯ → 連接」加入你建立的連接）。' +
    '\n總覽會放在這個頁面的最上面。賣貨便、KOCA、TWT 代購各自的 Notion 頁面，請在它們自己的 Google Sheet 按「設定 Notion」。' +
    (oldPages && oldPages.root ? '\n留空就用之前的頁面。' : ''), ui.ButtonSet.OK_CANCEL);
  if (r2.getSelectedButton() !== ui.Button.OK) return;
  var linkText = String(r2.getResponseText() || '').trim();
  var rootId = linkText ? extractNotionId(linkText) : (oldPages && oldPages.root) || '';
  if (!rootId) return ui.alert('看不出這是 Notion 頁面連結，請在 Notion 頁面按「分享 → 複製連結」再貼上');
  props.setProperty(NOTION_TOKEN_KEY, token);
  try {
    notionFetch('get', 'pages/' + rootId); // 先確認頁面已經加入連接
  } catch (e) {
    if (oldToken) props.setProperty(NOTION_TOKEN_KEY, oldToken); else props.deleteProperty(NOTION_TOKEN_KEY);
    return ui.alert('設定失敗：' + e.message);
  }
  if (!oldPages || oldPages.root !== rootId) saveJson(NOTION_PAGES_KEY, { root: rootId }); // 換了頁面：在新的頁面最上面重新放
  var ids = sourceIds(true);
  var msg = syncSources(['myship', 'koca', 'twt'], ids);
  var missing = sources().filter(function(s) { return !ids[s.id]; }).map(function(s) { return s.label; });
  ui.alert('Notion 設定完成', msg +
    (missing.length ? '\n\n還沒找到「' + missing.join('」「') + '」：建好之後把它的 Google Sheet 連結貼到這個檔案的「' + SOURCE_TAB + '」分頁，再按一次更新。' : '') +
    '\n\n不會自動更新：之後要更新時，按「訂單總覽 → 更新全部」。', ui.ButtonSet.OK);
}
function notionConfigured() {
  var pages = loadJson(NOTION_PAGES_KEY);
  return !!(PropertiesService.getScriptProperties().getProperty(NOTION_TOKEN_KEY) && pages && pages.root);
}

function syncNow(which) {
  var ids = sourceIds(true);
  if (which.indexOf('twt') >= 0 && !ids.twt) askTwtLink(ids);
  return notify('更新總覽', syncSources(which, ids) + (notionConfigured() ? '' :
    '\n\nNotion 最上面的總覽還沒設定（選用）：按「訂單總覽 → 設定 Notion（選用）」。賣貨便、KOCA、TWT 代購各自的 Notion 頁面，請在它們自己的 Google Sheet 按「同步到 Notion」。'));
}
// 找不到 TWT 代購管理表時，請你貼它的連結
function askTwtLink(ids) {
  try {
    var ui = SpreadsheetApp.getUi();
    var r = ui.prompt('TWT 代購管理表', '找不到 TWT 代購管理表。請貼上它的 Google Sheet 連結（不更新 TWT 代購就按取消）', ui.ButtonSet.OK_CANCEL);
    if (r.getSelectedButton() !== ui.Button.OK) return;
    var id = extractSheetId(r.getResponseText());
    var bad = id ? checkSource('twt', id) : '看不出這是 Google Sheet 連結';
    if (bad) { ui.alert(bad + '\n之後可以在「' + SOURCE_TAB + '」分頁貼上連結。'); return; }
    setSourceCell('twt', 2, sheetUrl(id));
    ids.twt = id;
  } catch (ignore) {} // 從 Apps Script 編輯器執行時沒有對話框
}

// 依序更新幾個平台：讀平台的 Google Sheet，更新這個檔案；最後更新總覽。回傳要給你看的文字
function syncSources(which, ids) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return '正在更新中，請過 1～2 分鐘再按一次。';
  var lines = [], errors = [];
  try {
    var folderMsg = organizeDrive(ids);
    for (var i = 0; i < which.length; i++) {
      var id = which[i], src = sources().filter(function(s) { return s.id === id; })[0];
      if (!ids[id]) {
        lines.push(src.name + '：還沒有 Google Sheet（在「' + SOURCE_TAB + '」分頁貼上「' + src.label + '」的連結）');
        try { placeholderPage(src); } catch (ignore) {}
        continue;
      }
      var report = { errors: [] };
      try {
        lines.push(src.name + '：總覽表 ' + mirrorPlatform(id, SpreadsheetApp.openById(ids[id]), report));
        setSourceCell(id, 3, fmtTime(new Date()));
        setSourceCell(id, 4, report.errors.length ? report.errors.length + ' 筆失敗：' + report.errors[0] : '');
      } catch (e) {
        lines.push(src.name + '：總覽表沒有更新（' + e.message + '）');
        setSourceCell(id, 4, '沒有更新：' + e.message);
        report.errors.push(src.name + '：' + e.message);
      }
      errors = errors.concat(report.errors);
    }
    try { writeSummary(); } catch (e) { errors.push('總覽：' + e.message); }
    var notionMsg = '';
    if (notionConfigured()) {
      try { updateOverview(); notionMsg = '\n\nNotion 最上面的總覽已更新。'; }
      catch (e) { errors.push('Notion 總覽：' + e.message); }
    }
    return lines.join('\n') + (folderMsg ? '\n\n' + folderMsg : '') + notionMsg +
      (errors.length ? '\n\n有 ' + errors.length + ' 筆沒更新成功：' + errors[0] : '');
  } finally {
    lock.releaseLock();
  }
}


// 三個平台各有自己的一頁：還沒有 Google Sheet 的平台先放一頁說明
function pageName(id) { return id === 'twt' ? TAB_TWT : id === 'myship' ? TAB_MYSHIP : TAB_KOCA; }
function placeholderPage(src) {
  var book = SpreadsheetApp.getActiveSpreadsheet();
  if (book.getSheetByName(pageName(src.id))) return;
  writeBlocks(book, pageName(src.id), [{ text: [src.name, '還沒有找到「' + src.label + '」。建好之後，把它的 Google Sheet 連結貼到「' + SOURCE_TAB + '」分頁，再按「訂單總覽 → 更新全部」。'] }]);
}

// ── 「來源」分頁：三個 Google Sheet 的連結 ──
function sourceSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SOURCE_TAB);
  if (sheet) return sheet;
  var sheets = ss.getSheets();
  // 新建的空白試算表：把預設的分頁改名成「來源」
  if (sheets.length === 1 && sheets[0].getLastRow() === 0) sheet = sheets[0].setName(SOURCE_TAB);
  else sheet = ss.insertSheet(SOURCE_TAB, 0);
  var rows = [SOURCE_HEADERS].concat(sources().map(function(s) { return [s.label, '', '', '']; }));
  sheet.getRange(1, 1, rows.length, SOURCE_HEADERS.length).setNumberFormat('@').setValues(rows);
  sheet.getRange(1, 1, 1, SOURCE_HEADERS.length).setFontWeight('bold').setBackground('#e5e7eb');
  sheet.getRange(2, 1, rows.length - 1, 1).setFontWeight('bold');
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(2, 420);
  if (/^(未命名|Untitled)/i.test(ss.getName())) ss.rename(TOP_FOLDER);
  return sheet;
}
// 「來源」分頁裡屬於這個平台的列（名稱有平台的字就算，打錯一點也找得到）；一列都沒有時回傳空陣列
function sourceRows(sheet, id) {
  var src = sources().filter(function(s) { return s.id === id; })[0], out = [];
  var col = sheet.getRange(1, 1, Math.max(1, sheet.getLastRow()), 1).getValues();
  for (var i = 1; i < col.length; i++) if (src.match.test(String(col[i][0]))) out.push(i + 1);
  return out;
}
// 這個平台在「來源」分頁的列；名稱不是標準寫法時改成標準寫法，一列都沒有時加一列
function sourceRow(sheet, id) {
  var label = sources().filter(function(s) { return s.id === id; })[0].label;
  var rows = sourceRows(sheet, id);
  if (rows.length) {
    if (String(sheet.getRange(rows[0], 1).getValue()).trim() !== label) sheet.getRange(rows[0], 1).setNumberFormat('@').setValue(label);
    return rows[0];
  }
  var row = Math.max(1, sheet.getLastRow()) + 1;
  sheet.getRange(row, 1).setNumberFormat('@').setValue(label);
  return row;
}
function setSourceCell(id, col, value) {
  try {
    var sheet = sourceSheet();
    sheet.getRange(sourceRow(sheet, id), col).setNumberFormat('@').setValue(value);
  } catch (ignore) {} // 只是記錄，寫不進去也不影響同步
}
function sheetUrl(id) { return 'https://docs.google.com/spreadsheets/d/' + id + '/edit'; }
function extractSheetId(text) {
  var s = String(text || '').trim();
  var m = s.match(/\/spreadsheets\/d\/([\w-]+)/) || s.match(/^([\w-]{30,})$/);
  return m ? m[1] : '';
}
// 讀「來源」分頁的連結；detect：空著的自動在雲端硬碟裡找，找到就填進去
function sourceIds(detect) {
  var sheet = sourceSheet(), out = {};
  sources().forEach(function(s) {
    var row = sourceRow(sheet, s.id), id = '', rows = sourceRows(sheet, s.id);
    // 同一個平台有好幾列時（例如多打了一列），用第一個有連結的
    rows.forEach(function(r) {
      var v = extractSheetId(sheet.getRange(r, 2).getValue());
      if (!id && v) id = v;
    });
    if (id && rows.length > 1 && !extractSheetId(sheet.getRange(row, 2).getValue())) sheet.getRange(row, 2).setNumberFormat('@').setValue(sheetUrl(id));
    if (!id && detect) {
      id = s.id === 'twt' ? detectTwt(s) : detectByName(s.file);
      if (id) sheet.getRange(row, 2).setNumberFormat('@').setValue(sheetUrl(id));
    }
    // 多出來、沒有連結的列清掉（只留第一列）
    rows.slice(1).forEach(function(r) {
      if (!String(sheet.getRange(r, 2).getValue()).trim() && !String(sheet.getRange(r, 3).getValue()).trim()) sheet.getRange(r, 1, 1, SOURCE_HEADERS.length).clearContent();
    });
    if (id) out[s.id] = id;
  });
  return out;
}
// 你貼的連結是不是對的檔案：回傳問題（沒問題時回傳空字串）
function checkSource(id, ssId) {
  var ss;
  try { ss = SpreadsheetApp.openById(ssId); } catch (e) { return '打不開這個 Google Sheet'; }
  if (id === 'twt') return ss.getSheetByName(TWT_TOUR_SHEET) ? '' : '這個 Google Sheet 裡沒有「' + TWT_TOUR_SHEET + '」分頁，不是 TWT 代購管理表';
  return ss.getSheetByName(ORDER_TAB) ? '' : '這個 Google Sheet 裡沒有「' + ORDER_TAB + '」分頁';
}
// 賣貨便、KOCA：檔名是「賣貨便訂單」「KOCA 訂單」、有「訂單」分頁的 Google Sheet（有好幾個時用最近更新的）
function detectByName(name) {
  var best = null;
  try {
    var it = DriveApp.getFilesByName(name);
    while (it.hasNext()) {
      var f = it.next();
      if (f.isTrashed() || f.getMimeType() !== MimeType.GOOGLE_SHEETS) continue;
      try { if (!SpreadsheetApp.openById(f.getId()).getSheetByName(ORDER_TAB)) continue; } catch (e) { continue; }
      if (!best || f.getLastUpdated().getTime() > best.getLastUpdated().getTime()) best = f;
    }
  } catch (ignore) {}
  return best ? best.getId() : '';
}
// TWT 代購管理表：「TWT 代購」資料夾裡有「團務資料」分頁的 Google Sheet
function detectTwt(s) {
  try {
    for (var i = 0; i < s.folders.length; i++) {
      var folders = DriveApp.getFoldersByName(s.folders[i]);
      while (folders.hasNext()) {
        var folder = folders.next();
        if (folder.isTrashed()) continue;
        var files = folder.getFilesByType(MimeType.GOOGLE_SHEETS), n = 0;
        while (files.hasNext() && n++ < 80) {
          var f = files.next();
          try { if (SpreadsheetApp.openById(f.getId()).getSheetByName(TWT_TOUR_SHEET)) return f.getId(); } catch (ignore) {}
        }
      }
    }
  } catch (ignore) {}
  return '';
}

// ── 雲端硬碟：這個檔案和三個平台的資料夾放在同一個「訂單總覽」資料夾 ──
function organizeDrive(ids) {
  try {
    var me = DriveApp.getFileById(SpreadsheetApp.getActiveSpreadsheet().getId());
    var top = topFolder(me), moved = [];
    sources().forEach(function(s) {
      if (!ids[s.id]) return;
      var parents = DriveApp.getFileById(ids[s.id]).getParents();
      while (parents.hasNext()) {
        var p = parents.next();
        if (s.folders.indexOf(p.getName()) < 0 || p.getId() === top.getId()) continue;
        var up = p.getParents(), inside = false;
        while (up.hasNext()) if (up.next().getId() === top.getId()) inside = true;
        if (!inside) { p.moveTo(top); moved.push(p.getName()); }
      }
    });
    return moved.length ? '雲端硬碟：「' + moved.join('」「') + '」資料夾已經放進「' + top.getName() + '」資料夾。' : '';
  } catch (e) {
    return ''; // 整理資料夾失敗不影響同步
  }
}
function topFolder(me) {
  var props = PropertiesService.getScriptProperties();
  var saved = props.getProperty(TOP_FOLDER_KEY);
  if (saved) { try { var f = DriveApp.getFolderById(saved); if (!f.isTrashed()) return f; } catch (ignore) {} }
  var root = DriveApp.getRootFolder(), parents = me.getParents(), parent = null;
  while (parents.hasNext() && !parent) parent = parents.next();
  var top;
  if (parent && parent.getId() !== root.getId()) {
    top = parent; // 這個檔案已經放在某個資料夾：就用那個資料夾
  } else {
    var found = root.getFoldersByName(TOP_FOLDER);
    top = found.hasNext() ? found.next() : root.createFolder(TOP_FOLDER);
    me.moveTo(top);
  }
  props.setProperty(TOP_FOLDER_KEY, top.getId());
  return top;
}

// ── 表格讀寫與小工具 ──
function getHeaderMap(headers) {
  var map = {};
  headers.forEach(function(h, i) { if (h !== '' && h !== null && h !== undefined) map[String(h).trim()] = i; });
  return map;
}
function readTable(sheet) {
  var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return [];
  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  var head = getHeaderMap(values[0]);
  return values.slice(1)
    .filter(function(r) { return r.some(function(c) { return c !== '' && c !== null; }); })
    .map(function(r) { return function(name) { var i = head[name]; return i === undefined ? '' : r[i]; }; });
}
// 一個分頁讀成 [{ 欄名: 值 }]
function readRows(ss, name, headers) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) return [];
  return readTable(sheet).map(function(get) {
    var o = {};
    headers.forEach(function(h) { o[h] = get(h); });
    return o;
  });
}
// 大一點的紀錄分段存在 Script Properties（每段 8000 字）
function loadChunked(prefix) {
  var props = PropertiesService.getScriptProperties();
  var n = Number(props.getProperty(prefix + 'N__') || 0), text = '';
  for (var i = 0; i < n; i++) text += props.getProperty(prefix + i) || '';
  try { return text ? JSON.parse(text) : {}; } catch (e) { return {}; }
}
function saveChunked(prefix, obj) {
  var props = PropertiesService.getScriptProperties();
  var text = JSON.stringify(obj), chunks = [];
  for (var i = 0; i < text.length; i += 8000) chunks.push(text.slice(i, i + 8000));
  var old = Number(props.getProperty(prefix + 'N__') || 0);
  var put = {};
  chunks.forEach(function(c, i) { put[prefix + i] = c; });
  put[prefix + 'N__'] = String(chunks.length);
  props.setProperties(put);
  for (var j = chunks.length; j < old; j++) props.deleteProperty(prefix + j);
}
function loadJson(key) {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(key) || 'null'); } catch (e) { return null; }
}
function saveJson(key, obj) { PropertiesService.getScriptProperties().setProperty(key, JSON.stringify(obj)); }
function fmtTime(date) { return Utilities.formatDate(date, TZ, 'yyyy-MM-dd HH:mm'); }
function fmtMoney(n) { return '$' + String(Math.round(Number(n) || 0)).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
function cellText(v) { return v == null ? '' : String(v); }
function extNum(v) { return (v === '' || v == null || !isFinite(Number(v))) ? null : Number(v); }
function labelToKey(map, label) {
  label = String(label || '').trim();
  if (map.hasOwnProperty(label.toLowerCase())) return label.toLowerCase();
  for (var k in map) if (map[k] === label) return k;
