}
function richText(s) { return s ? [{ type: 'text', text: { content: s } }] : []; }
function readText(x) { return ((x && (x.title || x.rich_text)) || []).map(function(t) { return t.plain_text || (t.text && t.text.content) || ''; }).join(''); }
function numOrNull(v) { var n = Number(v); return (v === '' || v == null || !isFinite(n) || n === 0) ? null : n; }

// ── Notion：只在你指定的頁面最上面放「三個平台總覽」 ──
function notionFetch(method, path, body) {
  var token = PropertiesService.getScriptProperties().getProperty(NOTION_TOKEN_KEY);
  if (!token) throw new Error('尚未設定 Notion 存取權杖');
  for (var attempt = 0; attempt < 4; attempt++) {
    var options = {
      method: method,
      headers: { Authorization: 'Bearer ' + token, 'Notion-Version': NOTION_VERSION },
      muteHttpExceptions: true
    };
    if (body) { options.contentType = 'application/json'; options.payload = JSON.stringify(body); }
    var res;
    try {
      res = UrlFetchApp.fetch(NOTION_API + path, options);
    } catch (e) {
      // 這支程式之前授權時還沒有「連到外部服務」：要在 Apps Script 編輯器裡執行一次，重新授權
      if (/external_request|UrlFetchApp/.test(String(e && e.message))) {
        throw new Error('要連到 Notion，需要先授權這支程式「連到外部服務」。請打開「擴充功能 → Apps Script」，在上方的函式選單選「syncAllNow」，按「執行」，在跳出的視窗按「檢閱權限」→ 選帳號 →「進階」→「前往…（不安全）」→「允許」，授權後再回來按一次。');
      }
      throw e;
    }
    var code = res.getResponseCode();
    if (code === 429 || code >= 500) {
      var headers = res.getHeaders() || {};
      var wait = Number(headers['Retry-After'] || headers['retry-after'] || 0) || (attempt + 1);
      Utilities.sleep(Math.min(30, wait) * 1000);
      continue;
    }
    var json = {};
    try { json = JSON.parse(res.getContentText() || '{}'); } catch (ignore) {}
    if (code >= 400) {
      var msg = code === 401 ? 'Notion 存取權杖不正確或已失效'
        : code === 404 ? 'Notion 找不到這個頁面或資料庫：請在 Notion 頁面右上角「⋯ → 連接」加入你建立的連接'
        : 'Notion ' + code + '：' + (json.message || '');
      var err = new Error(msg);
      err.status = code;
      throw err;
    }
    return json;
  }
  throw new Error('Notion 目前太忙，稍後再試');
}
// 從 Notion 連結取出頁面 ID（最後一段 32 碼）
function extractNotionId(text) {
  var clean = String(text || '').split('?')[0].replace(/-/g, '');
  var all = clean.match(/[0-9a-f]{32}/gi);
  if (!all) return '';
  var id = all[all.length - 1].toLowerCase();
  return id.slice(0, 8) + '-' + id.slice(8, 12) + '-' + id.slice(12, 16) + '-' + id.slice(16, 20) + '-' + id.slice(20);
}
function notionBareId(id) { return String(id || '').replace(/-/g, ''); }
// 在頁面最下面加區塊，回傳新區塊的 ID
function notionAppendBlocks(parentId, children) {
  var res = notionFetch('patch', 'blocks/' + parentId + '/children', { children: children });
  return (res.results || []).map(function(b) { return b.id; });
}
// 在頁面最上面加一個區塊；Notion 不接受時改加在最下面
function notionInsertTop(parentId, block) {
  try {
    var res = notionFetch('patch', 'blocks/' + parentId + '/children', { children: [block], position: { type: 'start' } });
    return ((res.results || [])[0] || {}).id;
  } catch (e) {
    if (e.status !== 400) throw e;
    return notionAppendBlocks(parentId, [block])[0];
  }
}
function notionBlockGone(blockId) {
  try {
    var b = notionFetch('get', 'blocks/' + blockId);
    return !!(b.in_trash || b.archived);
  } catch (e) {
    if (e.status === 404) return true;
    throw e;
  }
}
// 頁面裡的區塊：[{ id, type, title（子頁面、表格的名稱）, text（摘要框的文字）}]
function notionChildren(pageId) {
  var out = [], cursor = null;
  do {
    var res = notionFetch('get', 'blocks/' + pageId + '/children?page_size=100' + (cursor ? '&start_cursor=' + encodeURIComponent(cursor) : ''));
    (res.results || []).forEach(function(b) {
      if (b.in_trash || b.archived) return;
      out.push({ id: b.id, type: b.type,
        title: (b.child_page && b.child_page.title) || (b.child_database && b.child_database.title) || '',
        text: b.callout ? readText({ rich_text: b.callout.rich_text }) : '' });
    });
    cursor = res.has_more ? res.next_cursor : null;
  } while (cursor);
  return out;
}
// parts：[文字, 粗體, 連結網址]
function notionRich(parts) {
  return parts.filter(function(p) { return p[0]; }).map(function(p) {
    var t = { type: 'text', text: { content: String(p[0]).slice(0, 1900) } };
    if (p[2]) t.text.link = { url: p[2] };
    if (p[1]) t.annotations = { bold: true };
    return t;
  });
}
function notionCallout(parts, emoji) {
  return { object: 'block', type: 'callout', callout: { rich_text: notionRich(parts), icon: { type: 'emoji', emoji: emoji }, color: 'gray_background' } };
}
function notionHash(s) {
  var h = 0;
  for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
  return (h >>> 0).toString(36);
}
// 摘要框：有變才更新；在 Notion 刪掉了就不再加回來（holder[key] 變成 false）
function notionUpdateCallout(holder, key, block) {
  var id = holder[key], hash = notionHash(JSON.stringify(block.callout));
  if (!id || holder[key + 'Hash'] === hash) return;
  try {
    notionFetch('patch', 'blocks/' + id, { callout: block.callout });
    holder[key + 'Hash'] = hash;
  } catch (e) {
    if ((e.status !== 404 && e.status !== 400) || !notionBlockGone(id)) throw e;
    holder[key] = false;
  }
}

