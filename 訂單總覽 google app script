}

// ══════════════════════════════════════════
// TWT 代購：讀 TWT 代購主控表（團務資料、團務索引表單）和各團的 Google Sheet（訂單明細、匯率與二補）
// 每個團一個頁面：最上面是摘要，下面是「訂單與二補」表格，用分頁切換「訂單」「二補」
// 雙向：付款狀態、二補收款狀態（在 Notion 改了會寫回該團的 Google Sheet）；其他欄位由 Google Sheet 寫到 Notion
// 團在後台刪除（已結束）後，整個頁面搬到「已結束團務」保留，之後不再同步
// ══════════════════════════════════════════
function notionOrderSpec() {
  return {
    title: NOTION_TABLE_TITLE, keyField: 'orderId',
    fields: [
      ['title', '社群帳號', 'title'],
      ['pay', '付款狀態', 'select', NOTION_PAY_OPTIONS],
      ['bank5', '匯款後五碼', 'text'],
      ['remit', '匯款金額', 'number'],
      ['total', '系統總計', 'number'],
      ['secondTotal', '二補金額', 'number'],
      ['time', '下單時間', 'date'],
      ['details', '明細', 'text'],
      ['weight', '訂單重量(kg)', 'number', 'number'],
      ['intl', '國際運費', 'number'],
      ['pack', '包材費', 'number'],
      ['second', '二補收款狀態', 'select', NOTION_SECOND_OPTIONS],
      ['orderId', '訂單編號', 'text']
    ],
    views: [
      { name: '訂單', groupBy: '付款狀態',
        columns: ['社群帳號', '付款狀態', '匯款後五碼', '匯款金額', '系統總計', '金額相符', '二補金額', '下單時間', '明細'] },
      { name: '二補', groupBy: '二補收款狀態',
        columns: ['社群帳號', '明細', '訂單重量(kg)', '國際運費', '包材費', '二補金額', '二補收款狀態'],
        filter: { or: [{ property: '二補金額', number: { is_not_empty: true } }, { property: '訂單重量(kg)', number: { is_not_empty: true } }] } }
    ]
  };
}
function payLabel(v) {
  var s = String(v || '').trim();
  if (s === 'paid' || s === '已付款') return '已付款';
  if (!s || s === 'pending' || s === '未付款' || s === '未收款') return '未付款';
  return s;
}
function payValueForSheet(label) {
  if (label === '已付款') return 'paid';
  if (label === '未付款') return 'pending';
  return label;
}
function normalizeSecondStatus(s) {
  s = String(s || '').trim();
  if (!s || s === '未通知' || s === 'pending' || s === '未付款' || s === '未收款') return '未收款';
  if (s === 'paid' || s === '已付款' || s === '已收款') return '已收款';
  return s;
}
// 兩邊不一樣時，看上次同步的值判斷是哪一邊改的；兩邊都改時以 Notion 為準
// 沒有同步紀錄（第一次接手之前建立的表格）時以 Google Sheet 為準：後台改過的付款狀態不會被 Notion 上舊的值蓋掉
function resolveTwoWay(sheetVal, notionVal, baseVal) {
  if (sheetVal === notionVal) return sheetVal;
  if (baseVal === undefined) return sheetVal;
  if (notionVal !== baseVal && sheetVal === baseVal) return notionVal;
  if (sheetVal !== baseVal && notionVal === baseVal) return sheetVal;
  return notionVal;
}
function safeIsoTime(v) {
  if (!v) return '';
  var d = v instanceof Date ? v : new Date(v);
  return isNaN(d.getTime()) ? '' : d.toISOString();
}

// TWT 代購主控表裡的團（含已結束的團）：[{ ssId, name, status, group, progress, sellLink }]
function readTwtCampaigns(ss) {
  var tourSheet = ss.getSheetByName(TWT_TOUR_SHEET), index = ss.getSheetByName(TWT_INDEX_SHEET);
  if (!tourSheet) throw new Error('TWT 代購主控表裡找不到「' + TWT_TOUR_SHEET + '」分頁');
  var head = index && index.getLastColumn() ? getHeaderMap(index.getRange(1, 1, 1, index.getLastColumn()).getValues()[0]) : {};
  if (head[TWT_INDEX_ID] === undefined) {
    throw new Error('TWT 代購主控表的「' + TWT_INDEX_SHEET + '」還沒有各團的試算表ID：請先更新 TWT 代購主控表的程式，再按「TWT 代購 → 整理系統設定」');
  }
  var idByName = {};
  readTable(index).forEach(function(get) {
    var name = cellText(get('團務名稱')).trim(), id = cellText(get(TWT_INDEX_ID)).trim();
    if (name && id) idByName[name] = id;
  });
  var camps = [], seen = {};
  readTable(tourSheet).forEach(function(get) {
    var name = cellText(get('團務名稱') || get('開團名稱')).trim(), id = idByName[name];
    if (!name || !id || seen[id]) return;
    seen[id] = true;
    var rawStatus = String(get('狀態') || 'open').trim();
    camps.push({ ssId: id, name: name, status: labelToKey(STATUS_LABELS, rawStatus) || rawStatus.toLowerCase(),
      group: cellText(get('團體')).trim(), progress: cellText(get('團務進度')).trim(), sellLink: cellText(get('賣貨便連結')).trim() });
  });
  return camps;
}
// 一個團的訂單（含二補）
function readCampaignOrders(ssId) {
  var ss = SpreadsheetApp.openById(ssId);
  var sheet = ss.getSheetByName(TWT_ORDER_SHEET);
  if (!sheet) return [];
  var second = {}, secondByPhone = {};
  var sec = ss.getSheetByName(TWT_SECOND_SHEET);
  if (sec) {
    readTable(sec).forEach(function(get) {
      var info = { weight: get('商品重量(kg)'), intlShipping: get('國際運費分攤'), packagingFee: get('包材費'),
        secondPayment: get(TWT_SECOND_TOTAL), secondPayStatus: get('二補收款狀態') };
      var id = cellText(get('訂單編號')), phone = cellText(get('手機號碼')).replace(/\D/g, '');
      if (id) second[id] = info;
      if (phone) secondByPhone[phone] = info;
    });
  }
  return readTable(sheet).map(function(get) {
    var orderId = cellText(get('訂單編號')).trim(), phone = cellText(get('手機號碼')).replace(/\D/g, '');
    var s = (orderId && second[orderId]) || secondByPhone[phone] || {};
    return {
      spreadsheetId: ssId, orderId: orderId, phone: phone,
      timestamp: safeIsoTime(get('時間戳記')),
      socialName: cellText(get('社群帳號')),
      orderDetails: cellText(get('訂單明細')),
      totalAmount: Number(get('系統總計金額')) || 0,
      remitAmount: Number(get('買家匯款金額')) || 0,
      bank5: cellText(get('匯款後五碼')).replace(/\D/g, '').slice(-5),
      payStatus: cellText(get('付款狀態')) || 'pending',
      weight: s.weight, intlShipping: s.intlShipping, packagingFee: s.packagingFee,
      secondPayment: s.secondPayment, secondPayStatus: normalizeSecondStatus(s.secondPayStatus)
    };
  });
}
// 寫回該團的 Google Sheet：用訂單編號找到那一列；舊的二補列沒有訂單編號時用手機號碼找
function writeOrderCell(ssId, sheetName, orderId, column, value, phone) {
  var sheet = SpreadsheetApp.openById(ssId).getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return false;
  var rows = sheet.getDataRange().getValues();
  var h = getHeaderMap(rows[0]);
  var idCol = h['訂單編號'], phoneCol = h['手機號碼'];
  if (h[column] === undefined) return false;
  var digits = String(phone || '').replace(/\D/g, '');
  var target = -1, i;
  if (idCol !== undefined && orderId) {
    for (i = 1; i < rows.length; i++) if (String(rows[i][idCol]) === String(orderId)) { target = i; break; }
  }
  if (target < 0 && digits && phoneCol !== undefined) {
    for (i = 1; i < rows.length; i++) {
      var noId = idCol === undefined || !String(rows[i][idCol] || '');
      if (noId && String(rows[i][phoneCol]).replace(/\D/g, '') === digits) { target = i; break; }
    }
  }
  if (target < 0) return false;
  sheet.getRange(target + 1, h[column] + 1).setValue(value);
  return true;
}
function notionOrderWanted(o) {
  return {
    title: notionText(o.socialName || '（未填）', 200),
    pay: payLabel(o.payStatus),
    bank5: notionText(o.bank5, 20),
    remit: numOrNull(o.remitAmount),
    total: numOrNull(o.totalAmount),
    secondTotal: numOrNull(o.secondPayment),
    time: o.timestamp || '',
    details: notionText(o.orderDetails),
    weight: numOrNull(o.weight),
    intl: numOrNull(o.intlShipping),
    pack: numOrNull(o.packagingFee),
    second: normalizeSecondStatus(o.secondPayStatus),
    orderId: o.orderId
  };
}
// 金額不符、退款各自分開，不算進已付款或未付款
function campaignStats(orders) {
  var s = { count: 0, total: 0, paid: 0, unpaid: 0, mismatch: 0, refund: 0, second: 0, secondPaid: 0 };
  orders.forEach(function(o) {
    var pay = payLabel(o.payStatus);
    s.count++;
    s.total += Number(o.totalAmount) || 0;
    if (pay === '已付款') s.paid++;
    else if (pay === '金額不符') s.mismatch++;
    else if (pay === '退款') s.refund++;
    else s.unpaid++;
    if ((Number(o.secondPayment) || 0) > 0) {
      if (normalizeSecondStatus(o.secondPayStatus) === '已收款') s.secondPaid++; else s.second++;
    }
  });
  return s;
}
// 團務頁最上面的摘要
function notionSummaryBlock(c, s) {
  var second = (s.second || s.secondPaid) ? '待收 ' + s.second + ' 筆・已收 ' + s.secondPaid + ' 筆' : '還沒有（在後台算好二補後會自動出現在「二補」分頁）';
  return notionCallout([
    ['團體　', true], [c.group || '—'], ['　｜　狀態　', true], [STATUS_LABELS[c.status] || c.status], ['　｜　團務進度　', true], [c.progress || '—'],
    ['\n訂單　', true], [s.count + ' 筆・總額 ' + fmtMoney(s.total)],
    ['\n付款　', true], ['已付款 ' + s.paid + '・未付款 ' + s.unpaid + '・金額不符 ' + s.mismatch + (s.refund ? '・退款 ' + s.refund : '')],
    ['\n二補　', true], [second],
    ['\n賣貨便　', true], c.sellLink ? [c.sellLink, false, isWebLink(c.sellLink) ? c.sellLink : null] : ['—']
  ], '📊');
}

// 團務頁裡的「訂單與二補」表格：讀出所有訂單；還沒建或在 Notion 被刪掉時（重新）建立
function notionLoadOrders(entry, orders, state, report) {
  var spec = notionOrderSpec();
  if (entry.orders) {
    try { return notionQueryAll(entry.orders.ds, spec.fields, notionKeyOf(spec.keyField)); }
    catch (e) { if (e.status !== 404) throw e; }
    orders.forEach(function(o) { delete state[o.orderId]; }); // 表格被刪掉 → 重建，訂單全部重新放進去
  }
  var t = notionCreateTable(entry.page, spec.title, notionSchema(spec.fields), true);
  entry.orders = { db: t.db, ds: t.ds };
  if (!notionArrangeViews(t.db, t.ds, spec.views, true)) report.viewsFailed = true;
  return {};
}
// 同步「訂單與二補」裡的訂單（付款狀態、二補收款狀態雙向）；時間用完時回傳 false
function syncOrderRows(rows, ds, fields, orders, state, report, started) {
  for (var i = 0; i < orders.length; i++) {
    var o = orders[i];
    if (!o.orderId) continue;
    if (Date.now() - started > NOTION_TIME_BUDGET_MS) return false;
    var st = state[o.orderId] || {};
    var want = notionOrderWanted(o);
    var page = rows[o.orderId];
    try {
      if (!page) {
        if (st.p !== undefined) continue; // 同步過、但在 Notion 被刪掉 → 尊重刪除，不再建立
        notionFetch('post', 'pages', { parent: { type: 'data_source_id', data_source_id: ds }, properties: notionProps(fields, want) });
        report.created++;
        state[o.orderId] = { p: want.pay, s: want.second };
        Utilities.sleep(340);
        continue;
      }
      var pay = resolveTwoWay(want.pay, page.values.pay, st.p);
      var second = resolveTwoWay(want.second, page.values.second, st.s);
      // 寫回失敗時會丟出錯誤：這筆不更新 Notion、不更新同步紀錄，下次同步重試（不會把 Notion 的修改蓋掉）
      if (pay !== want.pay && !writeOrderCell(o.spreadsheetId, TWT_ORDER_SHEET, o.orderId, '付款狀態', payValueForSheet(pay))) throw new Error('找不到訂單列');
      if (second !== want.second && !writeOrderCell(o.spreadsheetId, TWT_SECOND_SHEET, o.orderId, '二補收款狀態', second, o.phone)) throw new Error('找不到二補列');
      if (pay !== want.pay || second !== want.second) {
        report.pulled += (pay !== want.pay ? 1 : 0) + (second !== want.second ? 1 : 0);
        o.payStatus = payValueForSheet(pay);
        o.secondPayStatus = second;
        want.pay = pay; want.second = second;
      }
      var patch = notionChanged(fields, want, page.values);
      if (patch) {
        notionFetch('patch', 'pages/' + page.id, { properties: patch });
        report.updated++;
        Utilities.sleep(340);
      }
      state[o.orderId] = { p: pay, s: second };
    } catch (e) {
      report.errors.push((o.socialName || o.orderId) + '：' + e.message);
      if (e.status === 401) throw e; // 權杖有問題，後面的也不會成功
    }
  }
  return true;
}
// 同步一個團的頁面；時間用完時回傳 false
function notionSyncCampaign(c, entry, orders, state, report, started) {
  if (entry.sum === undefined) entry.sum = notionInsertTop(entry.page, notionCallout([['同步中…']], '📊'));
  var rows = notionLoadOrders(entry, orders, state, report);
  if (!syncOrderRows(rows, entry.orders.ds, notionOrderSpec().fields, orders, state, report, started)) return false;
  notionUpdateCallout(entry, 'sum', notionSummaryBlock(c, campaignStats(orders)));
  return true;
}
// 之前（TWT 代購主控表的程式）建立的團務頁：沿用裡面的摘要和表格
function adoptCampaignPage(entry) {
  var kids = notionChildren(entry.page);
  var sum = kids.filter(function(k) { return k.type === 'callout' && /團體/.test(k.text); })[0];
  if (sum) entry.sum = sum.id;
  var table = notionFindTable(kids, NOTION_TABLE_TITLE);
  if (table) entry.orders = table;
}
// 團務頁的標題與圖示（圖示顏色代表狀態）
function notionUpdateCampaignPage(c, entry) {
  var icon = NOTION_STATUS_ICONS[c.status] || '📄';
  if (entry.title === c.name && entry.icon === icon) return;
  notionFetch('patch', 'pages/' + entry.page, { properties: { title: { title: richText(c.name) } }, icon: { type: 'emoji', emoji: icon } });
  entry.title = c.name; entry.icon = icon;
}

// TWT 代購的各團同步到 Notion；回傳要給你看的文字
function syncTwt(ss, pages, report, started) {
  var camps = readTwtCampaigns(ss);
  var map = loadChunked(NOTION_CAMPS_KEY), state = loadChunked(NOTION_STATE_KEY);
  var n = { campaigns: 0, orders: 0, ended: 0, noId: 0 }, live = [];
  try {
    var activeKids = notionChildPages(pages.active), endedKids = notionChildPages(pages.ended);
    var used = {};
    Object.keys(map).forEach(function(k) { if (map[k] && map[k].page) used[notionBareId(map[k].page)] = true; });
    for (var i = 0; i < camps.length; i++) {
      if (Date.now() - started > NOTION_TIME_BUDGET_MS) { report.pending = true; break; }
      var c = camps[i], active = c.status !== 'deleted';
      var entry = map[c.ssId], campOrders = [];
      try {
        if (!entry || !entry.page) {
          // 之前建立的同名頁面就沿用，沒有才建立
          var hit = null;
          [activeKids, endedKids].forEach(function(kids) {
            Object.keys(kids).forEach(function(k) { if (!hit && !used[k] && kids[k] === c.name) hit = k; });
          });
          if (hit) {
            entry = map[c.ssId] = { page: hit, title: c.name };
            adoptCampaignPage(entry);
          } else {
            var icon = NOTION_STATUS_ICONS[c.status] || '📄';
            var pageId = notionCreatePage(active ? pages.active : pages.ended, c.name, icon);
            entry = map[c.ssId] = { page: pageId, title: c.name, icon: icon };
            (active ? activeKids : endedKids)[notionBareId(pageId)] = c.name;
          }
          used[notionBareId(entry.page)] = true;
          saveChunked(NOTION_CAMPS_KEY, map); // 馬上記住，避免中途出錯時重複建立
        }
        var key = notionBareId(entry.page);
        if (!(key in activeKids) && !(key in endedKids)) continue; // 這個團的頁面在 Notion 被刪掉或移走了 → 不再同步
        entry.ended = key in endedKids;

        if (!(!active && entry.frozen)) {
          // 進行中的團每次同步；剛結束的團最後再同步一次，之後就不動了
          campOrders = readCampaignOrders(c.ssId);
          n.noId += campOrders.filter(function(o) { return !o.orderId; }).length;
          var done = notionSyncCampaign(c, entry, campOrders, state, report, started);
          saveChunked(NOTION_CAMPS_KEY, map);
          if (!done) { report.pending = true; break; }
          if (active) {
            n.campaigns++; n.orders += campOrders.length;
            var s = campaignStats(campOrders);
            s.name = c.name;
            live.push(s);
          }
        }
        notionUpdateCampaignPage(c, entry);
        if (entry.ended === active) {
          // 放到對的地方：進行中 →「進行中團務」；已結束 →「已結束團務」（整個頁面連同訂單一起搬）
          notionFetch('post', 'pages/' + entry.page + '/move', { parent: { type: 'page_id', page_id: active ? pages.active : pages.ended } });
          entry.ended = !active;
          if (!active && !entry.frozen) n.ended++;
        } else if (!active && !entry.frozen) {
          n.ended++;
        }
        if (active) delete entry.frozen;
        else if (!entry.frozen) {
          entry.frozen = true;
          // 之後不再同步：清掉這個團的同步紀錄（Script Properties 有容量上限）
          delete entry.sumHash;
          campOrders.forEach(function(o) { delete state[o.orderId]; });
        }
        saveChunked(NOTION_CAMPS_KEY, map);
      } catch (e) {
        report.errors.push(c.name + '：' + e.message);
        if (e.status === 401) throw e;
      }
    }
  } finally {
    saveChunked(NOTION_CAMPS_KEY, map);
    saveChunked(NOTION_STATE_KEY, state);
  }
  if (!report.pending) {
    var total = { camps: live, count: 0, total: 0, paid: 0, unpaid: 0, mismatch: 0, second: 0 };
    live.forEach(function(s) { ['count', 'total', 'paid', 'unpaid', 'mismatch', 'second'].forEach(function(k) { total[k] += s[k]; }); });
    saveStats('twt', total);
  }
  return '同步 ' + n.campaigns + ' 個團、' + n.orders + ' 筆訂單（新增 ' + report.created + '、更新 ' + report.updated + ' 筆' +
    (report.pulled ? '；把 Notion 改的 ' + report.pulled + ' 筆付款／二補狀態寫回 Google Sheet' : '') + '）' +
    (n.ended ? '；' + n.ended + ' 個團移到「' + NOTION_ENDED_TITLE + '」' : '') +
    (n.noId ? '；' + n.noId + ' 筆訂單沒有訂單編號，沒有同步（在 TWT 代購主控表按「TWT 代購 → 整理系統設定」會補上）' : '');
}

// ══════════════════════════════════════════
// 賣貨便、KOCA：讀它們自己的 Google Sheet（「訂單」，KOCA 另外有「提領」）
// 狀態雙向：在 Notion 改（例如寄出後改成「已出貨」）會寫回 Google Sheet；之後收到這筆訂單更新的通知信時以信為準
// ══════════════════════════════════════════
function channelById(id) { return channels().filter(function(c) { return c.id === id; })[0]; }
function notionMyshipSpec() {
  return {
    title: '訂單',
    fields: [
      ['buyer', '買家', 'title'],
      ['status', '狀態', 'select', MYSHIP_STATUS_OPTIONS],
      ['orderNo', '訂單編號', 'text'],
      ['shop', '賣場', 'text'],
      ['items', '商品', 'text'],
      ['subtotal', '商品金額', 'number'],
      ['shipping', '運費', 'number'],
      ['total', '訂單總額', 'number'],
