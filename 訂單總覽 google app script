  });
  if (s.camps.length > 40) parts.push(['\n…還有 ' + (s.camps.length - 40) + ' 個團']);
  return notionCallout(parts, '🛍️');
}
function updateOverview(pages) {
  var stats = loadStats();
  notionUpdateCallout(pages, 'overview', overviewBlock(stats));
  if (stats.twt) notionUpdateCallout(pages, 'twtSum', twtSummaryBlock(stats.twt));
