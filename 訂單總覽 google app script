// ── 頁面最上面的摘要 ──
function countStatus(rows) {
  var count = {};
  rows.forEach(function(r) { var s = String(r['狀態'] || '').trim() || '未知'; count[s] = (count[s] || 0) + 1; });
  return count;
}
function emailSum(rows, col) { return rows.reduce(function(t, r) { return t + (Number(r[col]) || 0); }, 0); }
function notionSheetLine(c, url) {
  return url ? [['\nGoogle Sheet　', true], ['「' + c.file + '」', false, url]] : [];
}
// 最新一封通知信的時間，和要怎麼更新
function mailLine(c, rows) {
  var last = rows.map(function(r) { return String(r['最後通知時間'] || ''); }).sort().pop();
  return (last ? '最新一封是 ' + last : '還沒有讀到通知信') + '；要更新時先在「' + c.file + '」按「' + c.name + ' → 讀取通知信」，再到「訂單總覽」同步';
}
var STATUS_HINT = '\n狀態可以直接在表格裡改（例如寄出後改成「已出貨」）；之後讀到這筆訂單新的通知信時會再更新';
function notionMyshipSummary(c, rows, payouts, url) {
  var live = rows.filter(function(r) { return !/取消|退/.test(String(r['狀態'] || '')); });
  return notionCallout([
    ['訂單　', true], [rows.length ? rows.length + ' 筆：' + statusLine(countStatus(rows), MYSHIP_STATUS_OPTIONS) : '還沒有訂單'],
    ['\n金額　', true], [live.length ? '訂單總額 ' + fmtMoney(emailSum(live, '訂單總額')) + '（含運費 ' + fmtMoney(emailSum(live, '運費')) + '；不含已取消、退貨）' : '—'],
    ['\n通知信　', true], [mailLine(c, rows)]
  ].concat(notionSheetLine(c, url), [[STATUS_HINT]]), '🏪');
}
function notionKocaSummary(c, rows, payouts, url) {
  var done = rows.filter(function(r) { return extNum(r['進帳金額']) != null; });
  var open = rows.filter(function(r) { return extNum(r['進帳金額']) == null && !/取消|退/.test(String(r['狀態'] || '')); });
  var other = emailSum(done, '其他扣款');
  // 各項金額並列（KOCA 以前的信「總金額」不含運費，所以不寫成相減的算式）
  var settled = done.length ? done.length + ' 筆・總金額 ' + fmtMoney(emailSum(done, '總金額')) + '・運費 ' + fmtMoney(emailSum(done, '運費')) +
    '・平台服務費 ' + fmtMoney(emailSum(done, '平台服務費')) + '・金流服務費 ' + fmtMoney(emailSum(done, '金流服務費')) +
    (other ? '・其他扣款 ' + fmtMoney(other) : '') + '・進帳 ' + fmtMoney(emailSum(done, '進帳金額')) : '還沒有';
  var fee = emailSum(payouts, '提領手續費');
  return notionCallout([
    ['訂單　', true], [rows.length ? rows.length + ' 筆：' + statusLine(countStatus(rows), KOCA_STATUS_OPTIONS) : '還沒有訂單'],
    ['\n已完成的訂單　', true], [settled],
    ['\n還沒完成　', true], [open.length ? open.length + ' 筆・總金額 ' + fmtMoney(emailSum(open, '總金額')) + '（完成後才知道實際扣多少費用）' : '—'],
    ['\n提領　', true], [payouts.length ? '已入帳 ' + fmtMoney(emailSum(payouts, '入帳金額')) + '（' + payouts.length + ' 次' + (fee ? '，提領手續費 ' + fmtMoney(fee) : '') + '）' : '還沒有'],
    ['\n通知信　', true], [mailLine(c, rows)]
  ].concat(notionSheetLine(c, url), [[STATUS_HINT]]), '🛒');
}
function channelStats(c, rows, payouts) {
  var live = rows.filter(function(r) { return !/取消|退/.test(String(r['狀態'] || '')); });
  return { count: rows.length, status: countStatus(rows), total: emailSum(live, c.payouts ? '總金額' : '訂單總額'),
    income: emailSum(rows, '進帳金額'), payout: emailSum(payouts, '入帳金額') };
}

// 平台頁面裡的表格（which：orders 或 payouts）：讀出所有列；還沒建或在 Notion 被刪掉時（重新）建立
function notionChannelTable(ext, which, spec, keyField, report) {
  if (ext[which]) {
    try {
      var rows = notionQueryAll(ext[which].ds, spec.fields, notionKeyOf(keyField));
      // 之前的版本有「信件」連結欄：拿掉
      if (!ext[which].noMail) {
        try { notionFetch('patch', 'data_sources/' + ext[which].ds, { properties: { '信件': null } }); } catch (ignore) {}
        ext[which].noMail = true;
      }
      return rows;
    }
    catch (e) { if (e.status !== 404) throw e; }
    ext[which === 'orders' ? 'state' : 'pstate'] = {}; // 表格被刪掉 → 重建，全部重新放進去
  }
  var t = notionCreateTable(ext.page, spec.title, notionSchema(spec.fields), false);
  ext[which] = { db: t.db, ds: t.ds, noMail: true };
  if (!notionArrangeViews(t.db, t.ds, spec.views, true)) report.viewsFailed = true;
  return {};
}
// Notion 那一列最後編輯的時間比這筆訂單最後一封通知信新
function notionNewer(edited, sec) {
  var t = Date.parse(edited || '');
  return isFinite(t) && t > (Number(sec) || 0) * 1000;
}
// 訂單：狀態雙向，其他欄位由 Google Sheet 寫到 Notion；時間用完時回傳 false
function notionSyncChannelRows(c, ss, ext, rows, report, started) {
  var spec = c.spec();
  var have = notionChannelTable(ext, 'orders', spec, 'orderNo', report);
  var state = ext.state || (ext.state = {});
  var pulls = {}, pending = [], finished = true;
  for (var i = 0; i < rows.length; i++) {
    var o = rows[i], key = String(o['訂單編號'] || '');
    if (!key) continue;
    if (Date.now() - started > NOTION_TIME_BUDGET_MS) { finished = false; break; }
    var want = c.wanted(o), page = have[key], base = state[key];
    try {
      if (!page) {
        if (base !== undefined) continue; // 同步過、但在 Notion 被刪掉 → 尊重刪除，不再建立
        notionFetch('post', 'pages', { parent: { type: 'data_source_id', data_source_id: ext.orders.ds }, properties: notionProps(spec.fields, want) });
        report.created++;
        state[key] = want.status;
        Utilities.sleep(340);
        continue;
      }
      // 狀態：Google Sheet 沒變（沒有新的通知信）、Notion 改了 → 用 Notion 的；收到新的通知信 → 用信的
      // 沒有同步紀錄（第一次接手之前建立的表格）時，看哪一邊比較新：Notion 最後編輯的時間、或這筆訂單最後一封通知信
      var now = page.values.status;
      if (now && now !== want.status && (base === undefined ? notionNewer(page.edited, o['更新時間（系統用）']) : want.status === base)) {
        pulls[key] = now;
        want.status = now; // 寫回 Google Sheet 之後才更新 Notion 的其他欄位
      }
      pending.push({ key: key, page: page, want: want });
    } catch (e) {
      report.errors.push(c.name + ' ' + key + '：' + e.message);
      if (e.status === 401) throw e;
    }
  }
  // 從 Notion 改的狀態寫回 Google Sheet（只改「狀態」那一格）；寫不回去的這次不動，下次同步再試
  var written = Object.keys(pulls).length ? writeCellsByKey(ss, ORDER_TAB, '訂單編號', '狀態', pulls) : {};
  Object.keys(pulls).forEach(function(k) {
    if (written[k]) report.pulled++;
    else report.errors.push(c.name + ' ' + k + '：狀態沒寫回 Google Sheet（找不到這筆訂單），下次同步再試');
  });
  rows.forEach(function(o) { var k = String(o['訂單編號'] || ''); if (written[k]) o['狀態'] = pulls[k]; });
  for (var j = 0; j < pending.length; j++) {
    var p = pending[j];
    if (pulls[p.key] && !written[p.key]) continue;
    try {
      var patch = notionChanged(spec.fields, p.want, p.page.values);
      if (patch) {
        notionFetch('patch', 'pages/' + p.page.id, { properties: patch });
        report.updated++;
        Utilities.sleep(340);
      }
      state[p.key] = p.want.status;
    } catch (e) {
      report.errors.push(c.name + ' ' + p.key + '：' + e.message);
      if (e.status === 401) throw e;
    }
  }
  return finished;
}
// 提領紀錄：只由 Google Sheet 寫到 Notion
function notionSyncPayoutRows(ext, rows, report, started) {
  var spec = notionPayoutSpec();
  var have = notionChannelTable(ext, 'payouts', spec, 'when', report);
  var state = ext.pstate || (ext.pstate = {});
  for (var i = 0; i < rows.length; i++) {
    var want = notionPayoutWanted(rows[i]), key = want.when;
    if (!key) continue;
    if (Date.now() - started > NOTION_TIME_BUDGET_MS) return false;
    var page = have[key];
    try {
      if (!page) {
        if (state[key]) continue;
        notionFetch('post', 'pages', { parent: { type: 'data_source_id', data_source_id: ext.payouts.ds }, properties: notionProps(spec.fields, want) });
        report.created++;
        state[key] = 1;
        Utilities.sleep(340);
        continue;
      }
      var patch = notionChanged(spec.fields, want, page.values);
      if (patch) {
        notionFetch('patch', 'pages/' + page.id, { properties: patch });
        report.updated++;
        Utilities.sleep(340);
      }
      state[key] = 1;
    } catch (e) {
      report.errors.push('KOCA 提領 ' + key + '：' + e.message);
      if (e.status === 401) throw e;
    }
  }
  return true;
}
// 平台的 Notion 頁面（放在你的頁面裡，跟「TWT 代購」並列）：之前建立的同名頁面就沿用
function channelPage(c, pages) {
  var ext = loadChunked(c.notionKey);
  if (ext.page && ext.root === pages.root && !notionPageGone(ext.page)) return ext;
  var hit = findChild(notionChildren(pages.root), 'child_page', c.title);
  if (hit) {
    ext = { root: pages.root, page: hit.id };
    var kids = notionChildren(hit.id);
    var sum = kids.filter(function(k) { return k.type === 'callout' && /通知信/.test(k.text); })[0];
    ext.sum = sum ? sum.id : notionInsertTop(hit.id, notionCallout([['同步中…']], c.emoji));
    var orders = notionFindTable(kids, c.spec().title);
    if (orders) ext.orders = orders;
    var payouts = c.payouts && notionFindTable(kids, notionPayoutSpec().title);
    if (payouts) ext.payouts = payouts;
  } else {
    // 還沒建、或頁面在 Notion 被刪掉了 → 建一個新的（按了同步就是要看到這個頁面）
    ext = { root: pages.root, page: notionCreatePage(pages.root, c.title, c.emoji) };
    ext.sum = notionAppendBlocks(ext.page, [notionCallout([['同步中…']], c.emoji)])[0];
  }
  saveChunked(c.notionKey, ext); // 馬上記住，避免中途出錯時重複建立
  return ext;
}
// 賣貨便或 KOCA 同步到 Notion；回傳要給你看的文字
function syncChannel(c, ss, pages, report, started) {
  if (!ss.getSheetByName(ORDER_TAB)) throw new Error('「' + c.file + '」裡沒有「' + ORDER_TAB + '」分頁：請先在那個檔案按「' + c.name + ' → 讀取通知信」');
  var ext = channelPage(c, pages);
  try {
    var rows = readRows(ss, ORDER_TAB, c.headers);
    if (!notionSyncChannelRows(c, ss, ext, rows, report, started)) { report.pending = true; }
    else {
      var payouts = c.payouts ? readRows(ss, PAYOUT_TAB, KOCA_PAYOUT_HEADERS) : [];
      if ((payouts.length || ext.payouts) && !notionSyncPayoutRows(ext, payouts, report, started)) report.pending = true;
      else {
        notionUpdateCallout(ext, 'sum', c.summary(c, rows, payouts, ss.getUrl()));
        saveStats(c.id, channelStats(c, rows, payouts));
      }
    }
  } finally {
    saveChunked(c.notionKey, ext);
  }
  return '新增 ' + report.created + ' 筆、更新 ' + report.updated + ' 筆' +
    (report.pulled ? '；把 Notion 改的 ' + report.pulled + ' 筆狀態寫回 Google Sheet' : '');
}
