function updateOverview() {
  var pages = loadJson(NOTION_PAGES_KEY) || {};
  if (!pages.root) return;
  if (pages.overview === undefined) {
    // 已經有的總覽就沿用，沒有才放在頁面最上面
    var hit = notionChildren(pages.root).filter(function(k) { return k.type === 'callout' && /三個平台各自計算/.test(k.text); })[0];
    pages.overview = hit ? hit.id : notionInsertTop(pages.root, notionCallout([['同步中…']], '📊'));
  }
  notionUpdateCallout(pages, 'overview', overviewBlock(loadStats()));
  saveJson(NOTION_PAGES_KEY, pages);
